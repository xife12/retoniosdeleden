---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/outfit';
import '../styles/tokens.css';
import '../styles/global.css';
import WatercolorDefs from '../components/WatercolorDefs.astro';

interface Props {
  lang: 'es' | 'en';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const altLang = lang === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* favicon.svg ist die reduzierte Bildmarke (Ring, Stock, Biene) mit fest
        eingetragenen Farben — Favicons erben keine Seiten-Styles. Die
        PNG-Zeile darunter ist die Rückfallebene für Browser ohne
        SVG-Favicon; eine favicon.ico gibt es bewusst nicht. Alle Icons
        entstehen aus src/components/Logo.astro. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbf6ec" />
    <link rel="alternate" hreflang={altLang} href={`/${altLang}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Beides muss stehen, bevor das erste Bild gezeichnet wird.

        `js` schaltet die Grundzustände scharf, die ohne Skript nichts
        verdecken dürfen (Reveals, Apertura). `reduced-motion` war früher in
        scroll-story.ts gesetzt — seit das Modul erst nach der Apertura
        geladen wird, käme die Klasse zu spät, und wer wenig Bewegung will,
        sähe die Seite bis dahin leer. */}
    <script is:inline>
      var raiz = document.documentElement;
      raiz.classList.replace('no-js', 'js');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        raiz.classList.add('reduced-motion');
      }
    </script>
  </head>
  <body>
    <WatercolorDefs />
    <slot />

    {/* Auf jeder Seite: was sich endlos wiederholt, ruht außerhalb des
        Bildes. Steht hier und nicht in `arranque.ts`, weil das Buch kein
        `arranque` hat — aber die meisten Bienen. */}
    <script>
      import { iniciarReposo } from '../scripts/reposo';
      iniciarReposo();
    </script>
  </body>
</html>

---
/**
 * "On Tour" — die Chacra fährt hin.
 *
 * Der Bereich verkauft drei Seminare, die anderswo stattfinden. Daraus
 * folgt alles Weitere:
 *
 *  1. Der PREIS ist die heikelste Angabe der ganzen Seite. Zwei Seminare
 *     kosten je Person, eines pauschal für die Gruppe. Derselbe Betrag
 *     bedeutet je nachdem das Zwanzigfache. Deshalb steht die Lesart
 *     unmittelbar am Betrag — in derselben Zeile, in derselben Karte, in
 *     lesbarer Größe — und nicht als Fußnote irgendwo darunter. Siehe
 *     `precioTipo` im Kopf von src/data/on-tour.ts.
 *
 *  2. Die ANFAHRT ist ein eigener, einmaliger Posten, kein Zuschlag je
 *     Person. Die drei Zonen stehen deshalb in einem eigenen Block mit
 *     den zugehörigen Orten — die häufigste Frage ist nicht "was kostet
 *     es", sondern "bin ich da überhaupt drin".
 *
 *  3. Die SCHÄTZUNG im Dialog ist bewusst eine Schätzung und heißt auch
 *     so. Sie rechnet mit dem, was die Besucherin eingetippt hat, und
 *     verspricht nichts. Wo die Zone `aPedido` ist, steht KEINE Zahl,
 *     sondern der Satz, dass wir sie nennen — eine erfundene Null wäre
 *     ein Versprechen, das niemand halten kann.
 *
 * ---------------------------------------------------------------------
 * Vorbild und bewusste Gleichheit
 * ---------------------------------------------------------------------
 * Auswahl, klebende Leiste, dreistufiger Dialog und Absenden sind
 * absichtlich genauso gebaut wie in AbejasEducan.astro. Zwei Formulare
 * auf einer Seite, die sich unterschiedlich verhalten, wirken wie ein
 * Fehler. Zwei Dinge davon sind nicht Geschmack, sondern Bedingung:
 *
 *  a) Die Regeln für `.modal` und `.modal-backdrop` stehen unten NOCH
 *     EINMAL. Astro kapselt Komponenten-CSS; die Regeln aus
 *     AbejasEducan.astro gelten dort und nirgends sonst. Ohne sie stünde
 *     der Dialog ohne Positionierung mitten im Seitenfluss.
 *  b) Der Import von src/lib/solicitudes.ts geschieht dynamisch erst beim
 *     Absendeklick, und der Wortlaut der Einwilligung wird beim Absenden
 *     aus dem DOM gelesen. Begründungen stehen im Kopf jener Datei und
 *     unten am Absendeblock — beides bitte nicht "aufräumen".
 */
import SelloAbejas from './SelloAbejas.astro';
import { onTourUI } from '../data/on-tour';
/*
 * Seminare und Zonen kommen zur Bauzeit aus der Datenbank, damit beides in
 * /admin gepflegt werden kann. Ist kein Backend erreichbar oder noch
 * nichts veröffentlicht, greifen die Entwurfsdaten aus
 * `src/data/on-tour.ts` — der Build bleibt dadurch nie stehen und meldet
 * es im Protokoll. Seminare und Zonen fallen unabhängig voneinander
 * zurück; siehe den Kopf von fetch-on-tour.ts.
 */
import { fetchSeminarios, fetchZonas } from '../lib/fetch-on-tour';
import { formatPrice, currencyPrefix } from '../data/workshops';
import { privacidadRuta } from '../data/privacidad';
import type { Dict, Lang } from '../i18n';

interface Props {
  t: Dict;
  lang: Lang;
}

const { lang } = Astro.props;
const ui = onTourUI[lang];

/* Nur aktive Seminare, in der vorgesehenen Reihenfolge. `activo` ist der
   Schalter, mit dem im Admin später ein Seminar pausiert werden kann,
   ohne es zu löschen. */
const listaSeminarios = (await fetchSeminarios())
  .filter((s) => s.activo)
  .sort((a, b) => a.numero - b.numero);

/* Nach `orden`, nicht nach Preis: die Liste liest sich als Ringe von der
   Chacra nach außen — so sucht auch jemand, der wissen will, ob sein Ort
   dabei ist. */
const listaZonas = (await fetchZonas()).sort((a, b) => a.orden - b.orden);

/** "120 minutos" bzw. "2 horas" — volle Stunden lesen sich besser. */
function duracionTexto(min: number): string {
  return min % 60 === 0 && min >= 120
    ? `${min / 60} ${ui.horas}`
    : `${min} ${ui.minutos}`;
}

/** Was in der Zonenliste rechts steht. Drei Fälle, drei Sätze. */
function recargoTexto(z: (typeof listaZonas)[number]): string {
  if (z.aPedido) return ui.zonaAPedido;
  if (z.recargo === 0) return ui.zonaSinRecargo;
  return formatPrice(z.recargo, z.currency);
}
---

<section id="on-tour" class="ontour" data-chapter>
  <div class="wrap">
    <header class="section-head ontour-head" data-reveal>
      <SelloAbejas variante="arbol" size="clamp(68px, 12vw, 96px)" decorative class="ontour-sello" />
      <p class="kicker">{ui.kicker}</p>
      <h2><span class="swash">{ui.title}</span></h2>
      <p class="lead">{ui.intro}</p>
    </header>

    {/* ---------- Die drei Seminare ---------- */}
    <ul class="sems">
      {listaSeminarios.map((s) => {
        const st = s.text[lang];
        return (
          <li class={`sem sem--${s.pigmento}`} data-reveal>
            <article>
              <div class="sem-cabeza">
                <span class="sem-celda" aria-hidden="true">{s.numero}</span>
                <h3 id={`sem-${s.id}`}>{st.title}</h3>
              </div>

              <p class="sem-resumen">{st.summary}</p>

              {/* ---------- Preis ----------
                  Betrag und Lesart bilden EIN Element und werden nie
                  getrennt umbrochen: "US$ 45 por persona" und
                  "$U 1600 por el grupo entero" sind zwei verschiedene
                  Angebote, und der Unterschied steckt allein im zweiten
                  Teil. Er ist deshalb nicht kleingedruckt, sondern
                  gleichrangig gesetzt. */}
              <p class="sem-precio">
                <strong>{formatPrice(s.precio, s.currency)}</strong>
                <span class="sem-precio-tipo">
                  {s.precioTipo === 'porPersona' ? ui.porPersona : ui.precioTotal}
                </span>
              </p>

              <ul class="sem-chips">
                <li class="chip">{duracionTexto(s.duracion)}</li>
                <li class="chip chip--gente">
                  {ui.desde} {s.minPersonas} {ui.hasta} {s.maxPersonas} {ui.personas}
                </li>
              </ul>

              {/* Der lange Text steht im Markup, nicht im Skript: so ist
                  er auch ohne JavaScript und für Suchmaschinen da. */}
              <details class="sem-mas">
                <summary>{ui.leerMas}</summary>
                <div class="sem-mas-cuerpo">
                  <p>{st.longDesc}</p>
                  <p class="sem-rotulo">{ui.incluye}</p>
                  <ul class="sem-incluye">
                    {st.incluye.map((i) => <li>{i}</li>)}
                  </ul>
                  <p class="sem-rotulo">{ui.necesitamos}</p>
                  <p class="sem-necesitamos">{st.necesitamos}</p>
                </div>
              </details>

              <button
                type="button"
                class="btn btn--elegir"
                data-sem-toggle={s.id}
                aria-pressed="false"
                aria-describedby={`sem-${s.id}`}
                data-txt-elegir={ui.elegir}
                data-txt-elegido={ui.elegido}
              >
                <span class="elegir-mas" aria-hidden="true">+</span>
                <span data-elegir-texto>{ui.elegir}</span>
              </button>
            </article>
          </li>
        );
      })}
    </ul>

    {/* ---------- Anfahrtszonen ----------
        Eigener Block, weil die Anfahrt ein eigener Posten ist: einmal je
        Besuch, nicht je Person. Die Orte stehen dabei, weil die erste
        Frage nie der Betrag ist, sondern "bin ich da drin". */}
    <div class="zonas" data-reveal>
      <h3 class="zonas-tit">{ui.zonasTitulo}</h3>
      <p class="zonas-intro">{ui.zonasIntro}</p>

      <ul class="zonas-lista">
        {listaZonas.map((z) => (
          <li class={`zona${z.aPedido ? ' zona--pedido' : ''}`}>
            <div class="zona-txt">
              <strong>{z.nombre[lang]}</strong>
              <span>{z.detalle[lang]}</span>
            </div>
            {/* Bei `aPedido` steht hier ausdrücklich KEIN Betrag — siehe
                den Kommentar zu `Zona` in src/data/on-tour.ts. */}
            <span class="zona-precio">{recargoTexto(z)}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* ---------- Auswahlleiste ----------
      Bleibt am unteren Rand stehen, sobald etwas gewählt ist. Ohne
      Auswahl ist sie nicht da: eine leere Leiste, die den halben
      Bildschirmrand belegt, hilft niemandem. */}
  <div class="ontour-barra" data-ontour-barra hidden>
    <p class="ontour-barra-txt">
      <strong data-ontour-cuenta>0</strong> <span>{ui.seleccionados}</span>
    </p>
    <button type="button" class="btn" data-ontour-abrir>{ui.pedir}</button>
  </div>

  {/* ---------- Anfragedialog ---------- */}
  <div class="modal-backdrop" data-ontour-backdrop hidden></div>
  <div
    class="modal modal--ontour"
    data-ontour-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="ontour-form-tit"
    hidden
  >
    <button class="modal-close" data-ontour-cerrar aria-label={ui.cerrar}>×</button>

    <h3 id="ontour-form-tit">{ui.formTitle}</h3>
    <p class="ontour-form-intro">{ui.formIntro}</p>

    <ol class="pasos" data-ontour-pasos>
      <li class="is-on"><span>1</span>{ui.pasoSeminarios}</li>
      <li><span>2</span>{ui.pasoLugar}</li>
      <li><span>3</span>{ui.pasoContacto}</li>
    </ol>

    {/* Die Texte für Wartezustand und Fehlerfall reisen als
        data-Attribute ins Skript. Astros `define:vars` wäre bequemer,
        macht das Skript aber `is:inline` — dann liefe der TypeScript-Teil
        unten ungeprüft und ungebaut in den Browser. */}
    <form
      class="ontour-form"
      data-ontour-form
      data-origen="on_tour"
      data-txt-enviar={ui.enviar}
      data-txt-enviando={ui.enviando}
      data-txt-error-conexion={ui.errorConexion}
      data-txt-error-envio={ui.errorEnvio}
      data-txt-minimo={ui.minimo}
      data-txt-aviso-minimo={ui.avisoMinimo}
      data-txt-personas={ui.personas}
      data-txt-seminarios={ui.estimacionSeminarios}
      data-txt-traslado={ui.estimacionTraslado}
      data-txt-apedido={ui.estimacionAPedido}
      data-txt-sin-recargo={ui.zonaSinRecargo}
      data-txt-total={ui.estimacionTotal}
      novalidate
    >
      {/* Schritt 1 — Seminare. Dieselbe Auswahl wie auf den Karten, hier
          noch einmal änderbar. Wer erst hier merkt, dass eines fehlt,
          muss nicht zurückscrollen.

          Die Preisangaben reisen als data-Attribute mit: das Skript
          rechnet damit die Schätzung, ohne die Daten ein zweites Mal
          laden zu müssen. */}
      <fieldset class="paso-panel" data-paso="1">
        <legend class="visually-hidden">{ui.pasoSeminarios}</legend>
        <ul class="sem-picker">
          {listaSeminarios.map((s) => (
            <li>
              <label class="picker-item">
                <input
                  type="checkbox"
                  data-sem-check
                  value={s.id}
                  data-precio={s.precio}
                  data-tipo={s.precioTipo}
                  data-moneda={s.currency}
                  data-prefijo={currencyPrefix[s.currency]}
                  data-min={s.minPersonas}
                  data-titulo={s.text[lang].title}
                />
                <span class="picker-celda" aria-hidden="true">{s.numero}</span>
                <span class="picker-txt">
                  <strong>{s.text[lang].title}</strong>
                  <em>
                    {formatPrice(s.precio, s.currency)} ·{' '}
                    {s.precioTipo === 'porPersona' ? ui.porPersona : ui.precioTotal}
                  </em>
                </span>
              </label>
            </li>
          ))}
        </ul>
        <p class="ontour-aviso" data-ontour-aviso hidden>{ui.ninguno}</p>
      </fieldset>

      {/* Schritt 2 — Ort, Zone, Gruppe, Termin. Alles, was den Preis
          bestimmt, steht auf einem Schirm — deshalb hängt die Schätzung
          direkt darunter und nicht auf einem eigenen Schritt. */}
      <fieldset class="paso-panel" data-paso="2" hidden>
        <legend class="visually-hidden">{ui.pasoLugar}</legend>

        <label class="campo">
          <span>{ui.campoZona}</span>
          <select name="zona" data-ontour-zona required>
            <option value="" selected disabled></option>
            {listaZonas.map((z) => (
              <option
                value={z.id}
                data-recargo={z.recargo}
                data-prefijo={currencyPrefix[z.currency]}
                data-moneda={z.currency}
                data-apedido={String(z.aPedido)}
                data-nombre={z.nombre[lang]}
              >
                {z.nombre[lang]} — {recargoTexto(z)}
              </option>
            ))}
          </select>
        </label>

        <label class="campo">
          <span>{ui.campoLugar}</span>
          <input type="text" name="lugar" autocomplete="address-level2" required />
        </label>

        <div class="campo-fila">
          <label class="campo">
            <span>{ui.campoPersonas}</span>
            <input
              type="number"
              name="personas"
              data-ontour-personas
              min="1"
              max="60"
              inputmode="numeric"
              required
            />
          </label>
          <label class="campo">
            <span>{ui.campoFecha1}</span>
            <input type="date" name="fecha1" required />
          </label>
        </div>

        <label class="campo">
          <span>{ui.campoFecha2}</span>
          <input type="date" name="fecha2" />
        </label>

        {/* Freundlicher Hinweis, keine Sperre: eine Gruppe knapp unter
            dem Minimum ist ein Gespräch wert, kein Fehler. Deshalb
            blockiert er das Weiterblättern nicht — er steht nur da, und
            zwar hier, wo die Zahl eingetippt wird, und nicht erst nach
            dem Absenden. */}
        <p class="ontour-minimo" data-ontour-minimo role="status" hidden></p>

        {/* ---------- Schätzung ----------
            Heißt "Estimación" und nicht "Precio", weil sie eine ist. */}
        <div class="estim" data-ontour-estim hidden>
          <p class="estim-tit">{ui.estimacion}</p>
          <dl class="estim-lineas" data-ontour-estim-lineas></dl>
          <p class="estim-nota">{ui.estimacionNota}</p>
        </div>
      </fieldset>

      {/* Schritt 3 — Kontakt. */}
      <fieldset class="paso-panel" data-paso="3" hidden>
        <legend class="visually-hidden">{ui.pasoContacto}</legend>
        <label class="campo">
          <span>{ui.campoOrganizacion}</span>
          <input type="text" name="organizacion" autocomplete="organization" required />
        </label>
        <label class="campo">
          <span>{ui.campoNombre}</span>
          <input type="text" name="nombre" autocomplete="name" required />
        </label>
        <div class="campo-fila">
          <label class="campo">
            <span>{ui.campoMail}</span>
            <input type="email" name="mail" autocomplete="email" required />
          </label>
          <label class="campo">
            <span>{ui.campoTel}</span>
            <input type="tel" name="tel" autocomplete="tel" />
          </label>
        </div>
        <label class="campo">
          <span>{ui.campoNota}</span>
          <textarea name="nota" rows="3"></textarea>
        </label>

        {/* Nicht vorausgewählt, und das bleibt so: Art. 9 der Ley 18.331
            verlangt eine ausdrückliche Einwilligung, ein vorgesetztes
            Häkchen ist keine.

            Der Satz steht ALLEIN in diesem span — der Link zur
            Datenschutzseite bewusst darunter und nicht darin. Das Skript
            liest beim Absenden genau diesen textContent als Nachweis; ein
            eingebetteter Link würde seine Beschriftung mit in den
            gespeicherten Wortlaut ziehen. */}
        <label class="consent">
          <input type="checkbox" name="consentimiento" required />
          <span data-ontour-consent-texto>{ui.consentimiento}</span>
        </label>

        <p class="consent-priv">
          <a href={privacidadRuta[lang]} target="_blank" rel="noopener noreferrer">
            {ui.privacidad}
          </a>
        </p>

        <p class="ontour-nota">{ui.noVinculante}</p>

        {/* Leer, bis etwas schiefgeht. role="alert" sorgt dafür, dass ein
            Screenreader die Meldung vorliest, ohne dass wir den Fokus
            verschieben müssen — der bleibt auf dem Absendeknopf, wo der
            zweite Versuch stattfindet. */}
        <p class="ontour-error" data-ontour-error role="alert" hidden></p>
      </fieldset>

      <div class="paso-acciones">
        <button type="button" class="btn btn--fantasma" data-ontour-volver hidden>{ui.volver}</button>
        <button type="button" class="btn" data-ontour-siguiente>{ui.siguiente}</button>
        <button type="submit" class="btn" data-ontour-enviar hidden>{ui.enviar}</button>
      </div>
    </form>

    <div class="ontour-gracias" data-ontour-gracias hidden>
      <SelloAbejas variante="lacre" size="72px" decorative />
      <h4>{ui.gracias}</h4>
      <p>{ui.graciasTexto}</p>
    </div>
  </div>
</section>

<script>
  /**
   * Auswahl, Schätzung und der dreistufige Ablauf des Anfrageformulars.
   *
   * Eine einzige Wahrheit über die Auswahl (`elegidos`), an die sich beide
   * Bedienstellen halten: die Knöpfe auf den Karten und die Häkchen im
   * Formular. Keine der beiden schreibt in die andere — beide ändern nur
   * die Menge und lassen danach `pintar()` alles nachziehen.
   */
  const sec = document.querySelector('.ontour');
  if (sec) {
    const elegidos = new Set<string>();

    const botones = Array.from(sec.querySelectorAll<HTMLButtonElement>('[data-sem-toggle]'));
    const checks = Array.from(sec.querySelectorAll<HTMLInputElement>('[data-sem-check]'));
    const barra = sec.querySelector<HTMLElement>('[data-ontour-barra]');
    const cuenta = sec.querySelector<HTMLElement>('[data-ontour-cuenta]');
    const aviso = sec.querySelector<HTMLElement>('[data-ontour-aviso]');

    const form = sec.querySelector<HTMLFormElement>('[data-ontour-form]');
    const selZona = sec.querySelector<HTMLSelectElement>('[data-ontour-zona]');
    const inpPersonas = sec.querySelector<HTMLInputElement>('[data-ontour-personas]');
    const cajaEstim = sec.querySelector<HTMLElement>('[data-ontour-estim]');
    const lineasEstim = sec.querySelector<HTMLElement>('[data-ontour-estim-lineas]');
    const avisoMinimo = sec.querySelector<HTMLElement>('[data-ontour-minimo]');

    /* ---------- Geld ----------
       Bewusst dieselbe Regel wie `formatPrice` in src/data/workshops.ts:
       ganze Beträge ohne Nachkommastellen, krumme mit zweien. Der
       Währungsvorsatz kommt aus den data-Attributen, damit hier keine
       zweite Liste von Währungszeichen entsteht, die auseinanderlaufen
       kann. */
    function fmt(monto: number, prefijo: string): string {
      const n = Number.isInteger(monto) ? String(monto) : monto.toFixed(2);
      return `${prefijo} ${n}`;
    }

    /* Summen werden JE WÄHRUNG geführt und nicht addiert: die Seminare
       stehen teils in US$, der Zuschlag in $U. Eine Summe über beide wäre
       eine erfundene Zahl. Mehrere Währungen erscheinen deshalb
       nebeneinander ("US$ 360 + $U 1200"). */
    type Bolsa = Record<string, { monto: number; prefijo: string }>;

    function sumar(bolsa: Bolsa, moneda: string, prefijo: string, monto: number) {
      if (!bolsa[moneda]) bolsa[moneda] = { monto: 0, prefijo };
      bolsa[moneda].monto += monto;
    }

    function textoBolsa(bolsa: Bolsa): string {
      return Object.keys(bolsa)
        .map((m) => fmt(bolsa[m].monto, bolsa[m].prefijo))
        .join(' + ');
    }

    function linea(rotulo: string, valor: string, fuerte: boolean) {
      const dt = document.createElement('dt');
      dt.textContent = rotulo;
      const dd = document.createElement('dd');
      dd.textContent = valor;
      if (fuerte) {
        dt.className = 'es-total';
        dd.className = 'es-total';
      }
      lineasEstim?.append(dt, dd);
    }

    /**
     * Überschlägige Schätzung.
     *
     * Rechenweg, bewusst simpel und nachvollziehbar:
     *   je Seminar   precioTipo === 'porPersona' ? precio × personas : precio
     *   dazu         der Zuschlag der Zone, EINMAL (nicht je Person)
     *
     * Sie erscheint erst, wenn Seminar, Personenzahl und Zone dastehen —
     * eine halbe Rechnung ist irreführender als keine. Ist die Zone
     * `aPedido`, steht in der Anfahrtszeile ein Satz statt einer Zahl,
     * und die Summe bleibt trotzdem stehen: sie ist dann eben die Summe
     * ohne Anfahrt, und genau das sagt die Zeile darüber.
     */
    function estimar() {
      if (!form || !cajaEstim || !lineasEstim) return;

      const personas = Number(inpPersonas?.value ?? 0);
      const opcion = selZona?.selectedOptions[0];
      const zonaElegida = opcion && opcion.value !== '';

      lineasEstim.textContent = '';

      if (elegidos.size === 0 || !personas || personas < 1 || !zonaElegida) {
        cajaEstim.hidden = true;
        return;
      }

      const bolsaSem: Bolsa = {};
      checks
        .filter((c) => elegidos.has(c.value))
        .forEach((c) => {
          const precio = Number(c.dataset.precio);
          const moneda = c.dataset.moneda ?? '';
          const prefijo = c.dataset.prefijo ?? '';
          sumar(bolsaSem, moneda, prefijo, c.dataset.tipo === 'porPersona' ? precio * personas : precio);
        });

      const total: Bolsa = {};
      Object.keys(bolsaSem).forEach((m) =>
        sumar(total, m, bolsaSem[m].prefijo, bolsaSem[m].monto),
      );

      const aPedido = opcion!.dataset.apedido === 'true';
      const recargo = Number(opcion!.dataset.recargo ?? 0);
      const monedaZona = opcion!.dataset.moneda ?? '';
      const prefijoZona = opcion!.dataset.prefijo ?? '';
      if (!aPedido && recargo > 0) sumar(total, monedaZona, prefijoZona, recargo);

      const d = form.dataset;
      linea(d.txtSeminarios ?? '', textoBolsa(bolsaSem), false);

      /*
       * Drei Faelle, drei verschiedene Saetze -- und keiner davon ist eine
       * Null. „Traslado $U 0" liest sich wie ein Platzhalter oder ein
       * Rechenfehler; gemeint ist „ist schon drin". In der Zonenliste
       * daneben steht an derselben Stelle ebenfalls „Incluido", also sagen
       * beide dasselbe.
       */
      const trasladoTexto = aPedido
        ? (d.txtApedido ?? '')
        : recargo === 0
          ? (d.txtSinRecargo ?? '')
          : fmt(recargo, prefijoZona);
      linea(d.txtTraslado ?? '', trasladoTexto, false);
      linea(d.txtTotal ?? '', textoBolsa(total), true);

      cajaEstim.hidden = false;
    }

    /**
     * Mindestgruppe. Freundlich und nicht sperrend: wer zu sechst nach
     * einem Seminar für acht fragt, soll das SEHEN, bevor er absendet —
     * aber trotzdem fragen dürfen. Manchmal geht es doch.
     */
    function revisarMinimo() {
      if (!avisoMinimo || !form) return;
      const personas = Number(inpPersonas?.value ?? 0);
      if (!personas || personas < 1) {
        avisoMinimo.hidden = true;
        return;
      }

      const cortos = checks
        .filter((c) => elegidos.has(c.value) && personas < Number(c.dataset.min))
        .map((c) => `${c.dataset.titulo} — ${form.dataset.txtMinimo} ${c.dataset.min} ${form.dataset.txtPersonas}`);

      if (cortos.length === 0) {
        avisoMinimo.hidden = true;
        return;
      }
      avisoMinimo.textContent = `${form.dataset.txtAvisoMinimo ?? ''} ${cortos.join(' · ')}`;
      avisoMinimo.hidden = false;
    }

    function pintar() {
      botones.forEach((b) => {
        const on = elegidos.has(b.dataset.semToggle!);
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('is-on', on);
        const rotulo = b.querySelector<HTMLElement>('[data-elegir-texto]');
        if (rotulo) rotulo.textContent = on ? (b.dataset.txtElegido ?? '') : (b.dataset.txtElegir ?? '');
      });
      checks.forEach((c) => {
        c.checked = elegidos.has(c.value);
      });
      if (cuenta) cuenta.textContent = String(elegidos.size);
      if (barra) barra.hidden = elegidos.size === 0;
      if (aviso) aviso.hidden = elegidos.size > 0;
      estimar();
      revisarMinimo();
    }

    botones.forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.dataset.semToggle!;
        if (elegidos.has(id)) elegidos.delete(id);
        else elegidos.add(id);
        pintar();
      });
    });

    checks.forEach((c) => {
      c.addEventListener('change', () => {
        if (c.checked) elegidos.add(c.value);
        else elegidos.delete(c.value);
        pintar();
      });
    });

    selZona?.addEventListener('change', estimar);
    inpPersonas?.addEventListener('input', () => {
      estimar();
      revisarMinimo();
    });

    /* ---------- Dialog ---------- */
    const modal = sec.querySelector<HTMLElement>('[data-ontour-modal]');
    const fondo = sec.querySelector<HTMLElement>('[data-ontour-backdrop]');
    const gracias = sec.querySelector<HTMLElement>('[data-ontour-gracias]');
    const paneles = Array.from(sec.querySelectorAll<HTMLElement>('[data-paso]'));
    const marcas = Array.from(sec.querySelectorAll<HTMLElement>('[data-ontour-pasos] li'));
    const bVolver = sec.querySelector<HTMLButtonElement>('[data-ontour-volver]');
    const bSiguiente = sec.querySelector<HTMLButtonElement>('[data-ontour-siguiente]');
    const bEnviar = sec.querySelector<HTMLButtonElement>('[data-ontour-enviar]');

    let paso = 1;
    let devolverFoco: HTMLElement | null = null;

    function mostrarPaso(n: number) {
      paso = n;
      paneles.forEach((p) => {
        p.hidden = Number(p.dataset.paso) !== n;
      });
      marcas.forEach((m, i) => m.classList.toggle('is-on', i === n - 1));
      if (bVolver) bVolver.hidden = n === 1;
      if (bSiguiente) bSiguiente.hidden = n === 3;
      if (bEnviar) bEnviar.hidden = n !== 3;
    }

    /*
     * Tastaturfalle. `aria-modal="true"` verspricht einem Screenreader,
     * dass ausserhalb des Dialogs nichts erreichbar ist -- ohne diese
     * Schleife waere das gelogen: mit der Tabulatortaste liefe man aus
     * dem Dialog heraus in die Seite dahinter, die man nicht sieht.
     * Gleiches Verhalten wie bei den Talleres und bei "Las abejas educan".
     */
    function atraparFoco(ev: KeyboardEvent) {
      if (ev.key !== 'Tab' || !modal || modal.hidden) return;

      const alcanzables = Array.from(
        modal.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
        /* Felder eines ausgeblendeten Schrittes zaehlen nicht mit. */
      ).filter((el) => el.offsetParent !== null);

      if (!alcanzables.length) return;

      const primero = alcanzables[0];
      const ultimo = alcanzables[alcanzables.length - 1];

      if (ev.shiftKey && document.activeElement === primero) {
        ev.preventDefault();
        ultimo.focus();
      } else if (!ev.shiftKey && document.activeElement === ultimo) {
        ev.preventDefault();
        primero.focus();
      }
    }

    function abrir() {
      if (!modal || !fondo) return;
      devolverFoco = document.activeElement as HTMLElement;
      modal.hidden = false;
      fondo.hidden = false;
      document.body.style.overflow = 'hidden';
      mostrarPaso(1);
      /* Nach oben, falls der Dialog beim letzten Mal gescrollt war. */
      modal.scrollTop = 0;
      modal.querySelector<HTMLElement>('input, button')?.focus();
      document.addEventListener('keydown', atraparFoco);
    }

    function cerrar() {
      if (!modal || !fondo) return;
      modal.hidden = true;
      fondo.hidden = true;
      document.body.style.overflow = '';
      document.removeEventListener('keydown', atraparFoco);
      devolverFoco?.focus();
    }

    sec.querySelector('[data-ontour-abrir]')?.addEventListener('click', abrir);
    sec.querySelector('[data-ontour-cerrar]')?.addEventListener('click', cerrar);
    fondo?.addEventListener('click', cerrar);
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && modal && !modal.hidden) cerrar();
    });

    bSiguiente?.addEventListener('click', () => {
      /* Ohne Seminar ist der zweite Schritt sinnlos — dort stünde dann
         ein Ort ohne Anlass. */
      if (paso === 1 && elegidos.size === 0) {
        if (aviso) aviso.hidden = false;
        return;
      }
      /* Pflichtfelder des aktuellen Schritts prüfen, bevor es weitergeht —
         sonst merkt man Lücken erst am Ende und muss zurückblättern. */
      const actual = paneles.find((p) => Number(p.dataset.paso) === paso);
      const malo = actual?.querySelector<HTMLInputElement>(':invalid');
      if (malo) {
        malo.reportValidity();
        return;
      }
      mostrarPaso(Math.min(3, paso + 1));
    });

    bVolver?.addEventListener('click', () => mostrarPaso(Math.max(1, paso - 1)));

    /* ---------- Absenden ----------
       Geht denselben Weg wie das Schulformular: über
       src/lib/solicitudes.ts in die Tabelle `solicitudes`, hier mit
       `origen: 'on_tour'`. Vier Dinge sind daran wichtig.

       1. Der Import von solicitudes.ts steht INNERHALB des Handlers.
          src/lib/supabase.ts wirft beim Laden, wenn die Zugangsdaten
          fehlen; läge der Import oben, wäre bei fehlender Konfiguration
          der ganze Bereich tot — Auswahl, Schätzung, Schrittwechsel. So
          ist nur das Absenden betroffen, und das sagt es dann auch.

       2. Der WORTLAUT der Einwilligung wird aus dem DOM gelesen, nicht
          aus on-tour.ts importiert. Gespeichert werden soll, was diese
          Person gesehen hat. Ein Import würde beim nächsten Umformulieren
          rückwirkend auch die alten Anfragen "umschreiben" und wäre als
          Nachweis nach Art. 9 der Ley 18.331 wertlos.

       3. On Tour hat in `solicitudes` seit Migration 008 EIGENE Spalten
          (`personas`, `zona`, `organizacion`, `lugar`), und eine
          Prüfregel dort verlangt `personas` und `zona`. Vorher waren die
          Angaben auf die Schulspalten abgebildet — die Anfahrtszone lag
          also in einer Spalte namens `clase`. Wer die Anfragen im
          Backend ansieht, hätte dort einen Zonennamen unter der
          Überschrift "Klasse" gelesen. Nicht wieder zusammenlegen.
          Gemeinsam bleibt nur der Kontaktblock; `docente` heisst so, weil
          es bei den Schulen zuerst gebraucht wurde, und meint hier die
          anfragende Person. Siehe src/lib/solicitudes.ts.

       4. Der Dank erscheint erst NACH einer bestätigten Speicherung, und
          schlägt das Senden fehl, bleibt das Formular ausgefüllt stehen.
          Niemand tippt drei Schritte noch einmal. */
    const error = sec.querySelector<HTMLElement>('[data-ontour-error]');

    function mostrarError(texto: string) {
      if (!error) return;
      error.textContent = texto;
      error.hidden = false;
    }

    let enviando = false;

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (enviando) return;

      const malo = form.querySelector<HTMLInputElement>(':invalid');
      if (malo) {
        malo.reportValidity();
        return;
      }
      /* Kann nur passieren, wenn jemand die Auswahl nach Schritt 1 wieder
         leert. Ohne Seminar hat die Anfrage keinen Gegenstand. */
      if (elegidos.size === 0) {
        mostrarPaso(1);
        if (aviso) aviso.hidden = false;
        return;
      }

      const datos = new FormData(form);
      const leer = (n: string) => String(datos.get(n) ?? '').trim();

      const consentEl = sec.querySelector<HTMLElement>('[data-ontour-consent-texto]');
      const consentTexto = (consentEl?.textContent ?? '').trim();

      const lugar = leer('lugar');

      if (error) error.hidden = true;
      enviando = true;
      if (bEnviar) {
        bEnviar.disabled = true;
        bEnviar.textContent = form.dataset.txtEnviando ?? '…';
      }

      const { enviarSolicitud } = await import('../lib/solicitudes');

      const res = await enviarSolicitud({
        origen: 'on_tour',
        modulos: Array.from(elegidos),
        fecha1: leer('fecha1'),
        fecha2: leer('fecha2'),
        personas: Number(leer('personas')),
        zona: leer('zona'),
        organizacion: leer('organizacion'),
        lugar,
        docente: leer('nombre'),
        mail: leer('mail'),
        telefono: leer('tel'),
        nota: leer('nota'),
        consentimiento: datos.get('consentimiento') !== null,
        consentimientoTexto: consentTexto,
      });

      enviando = false;
      if (bEnviar) {
        bEnviar.disabled = false;
        bEnviar.textContent = form.dataset.txtEnviar ?? '';
      }

      if (!res.ok) {
        /* Zwei Meldungen statt einer, weil sie zwei verschiedene
           Handlungen nahelegen: bei fehlender Verbindung hilft Warten,
           bei einer Ablehnung durch die Datenbank hilft es nicht. */
        mostrarError(
          res.motivo === 'sin-conexion'
            ? (form.dataset.txtErrorConexion ?? '')
            : (form.dataset.txtErrorEnvio ?? ''),
        );
        if (import.meta.env.DEV) console.error('solicitud on_tour', res);
        return;
      }

      form.hidden = true;
      sec.querySelector<HTMLElement>('[data-ontour-pasos]')!.hidden = true;
      if (gracias) gracias.hidden = false;
    });

    pintar();
  }
</script>


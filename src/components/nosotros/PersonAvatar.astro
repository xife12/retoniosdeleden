---
/**
 * Abstrakter Aquarell-Platzhalter-Avatar für die Wabe auf "Nosotros".
 *
 * Es gibt noch keine echten Fotos der Familie. Statt eines Flat-Icons oder
 * eines fotorealistischen Platzhalters zeichnet diese Komponente eine
 * einfache Kopf-Schultern-Silhouette im selben Aquarell/Tusche-Stil wie der
 * Rest der Seite (Stay.astro, Timeline.astro): Wasserfarben-Verlauf
 * (pg-*-Gradient aus WatercolorDefs.astro) + `wc-soft`/`wc-rough` für die
 * Waschung und `ink` für die zittrige Umrisslinie.
 *
 * WICHTIG — was diese Komponente NICHT mehr tut: Sie staffelt keine Größen
 * mehr nach Generation. Vorher war die Großmutter am größten und die Kinder
 * am kleinsten; im Baum war das eine Generationenfolge, in einer Wabe wäre
 * es eine Rangordnung. Alle Figuren sind jetzt gleich groß.
 *
 * Unterschieden wird nur noch über das Pigment, und das steht für die
 * TÄTIGKEIT: miel = Bienen, barro = Bau, pistacho = Pflanzen und Boden,
 * lavanda = alles, was aus der Ferne oder am Bildschirm passiert.
 */
import type { Pigmento } from '../../data/nosotros';

interface Props {
  pigmento: Pigmento;
  /** Index der Person in der Liste — variiert die Neigung leicht, damit
      die Avatare nicht wie Kopien voneinander wirken. Deterministisch,
      damit Server und Client dasselbe Markup erzeugen. */
  seed?: number;
  /** Gruppen ("los nietos", "los voluntarios"): mehrere kleine Figuren. */
  grupo?: boolean;
  /** `vuelo`-Waben sind blasser — die Wabe selbst trägt dort die Aussage. */
  tenue?: boolean;
}

const { pigmento, seed = 0, grupo = false, tenue = false } = Astro.props;

const tone: Record<Pigmento, string> = {
  miel: 'pg-miel',
  barro: 'pg-barro',
  pistacho: 'pg-pistacho-light',
  lavanda: 'pg-lavanda',
};

const fill = `url(#${tone[pigmento]})`;

/** Leichte, deterministische Neigung je Person statt echtem Zufall,
    damit ein Rebuild immer dasselbe Markup erzeugt. */
function tilt(n: number): number {
  return ((n * 37) % 11) - 5;
}

interface Figure {
  cx: number;
  cy: number;
  scale: number;
  rotate: number;
}

const figures: Figure[] = grupo
  ? [
      { cx: 32, cy: 80, scale: 0.56, rotate: tilt(seed + 1) },
      { cx: 61, cy: 64, scale: 0.72, rotate: tilt(seed + 2) },
      { cx: 89, cy: 82, scale: 0.52, rotate: tilt(seed + 3) },
    ]
  : [{ cx: 60, cy: 62, scale: 1, rotate: tilt(seed) }];
---

<svg
  class:list={['persona-avatar', { tenue }]}
  viewBox="0 0 120 130"
  aria-hidden="true"
  focusable="false"
>
  {grupo && (
    <ellipse cx="61" cy="78" rx="52" ry="34" fill={fill} opacity="0.14" filter="url(#wc-wash)" />
  )}
  {figures.map((f) => (
    <g transform={`translate(${f.cx} ${f.cy}) rotate(${f.rotate}) scale(${f.scale})`}>
      <path
        d="M-30 42 C -30 14, -16 -2, 0 -2 C 16 -2, 30 14, 30 42 Z"
        fill={fill}
        filter="url(#wc-soft)"
      />
      <circle cx="0" cy="-24" r="22" fill={fill} filter="url(#wc-rough)" />
      <circle
        cx="0"
        cy="-24"
        r="22"
        fill="none"
        stroke="var(--tinta)"
        stroke-opacity="0.22"
        stroke-width="1.6"
        filter="url(#ink)"
      />
      <path
        d="M-30 42 C -30 14, -16 -2, 0 -2 C 16 -2, 30 14, 30 42"
        fill="none"
        stroke="var(--tinta)"
        stroke-opacity="0.16"
        stroke-width="1.4"
        filter="url(#ink)"
      />
    </g>
  ))}
</svg>

<style>
  .persona-avatar {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Begleiterinnen und Begleiter: dieselbe Figur, nur zurückgenommen.
     Die offene Wabenkontur trägt dort die eigentliche Unterscheidung. */
  .persona-avatar.tenue {
    opacity: 0.6;
  }
</style>

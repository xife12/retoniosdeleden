---
/**
 * Abstrakter Aquarell-Platzhalter-Avatar für die "Nosotros"-Seite.
 *
 * Es gibt noch keine echten Fotos der Familie. Statt eines Flat-Icons oder
 * eines fotorealistischen Platzhalters zeichnet diese Komponente eine
 * einfache Kopf-Schultern-Silhouette im selben Aquarell/Tusche-Stil wie der
 * Rest der Seite (Stay.astro, Timeline.astro): Wasserfarben-Verlauf
 * (pg-*-Gradient aus WatercolorDefs.astro) + `wc-soft`/`wc-rough` für die
 * Waschung und `ink` für die zittrige Umrisslinie.
 *
 * Die Generationszugehörigkeit macht die Familie auf den ersten Blick als
 * Mehrgenerationenprojekt erkennbar, über zwei dezente Mittel statt Text:
 *   - Farbton: abuela = Barro (erdig), padres = Miel (Hauptakzent der
 *     Seite), hijos = helles Pistacho-Grün (frisch, jung).
 *   - Größe: die Silhouette wird über die Generationen hinweg etwas
 *     kleiner (Großmutter am größten, Kinder am kleinsten).
 *   - "Los nietos" ist keine Einzelperson, sondern eine Gruppe: drei kleine
 *     Mini-Silhouetten in Lavanda-Ton statt einer einzelnen großen Figur.
 */
import type { Generation } from '../../data/nosotros';

interface Props {
  generation: Generation;
  /** Index der Person in der Liste — variiert die Neigung leicht, damit
      die sieben Avatare nicht wie Kopien voneinander wirken. Deterministisch,
      damit Server und Client dasselbe Markup erzeugen. */
  seed?: number;
  /** "Los nietos": mehrere kleine Figuren statt einer. */
  grupo?: boolean;
}

const { generation, seed = 0, grupo = false } = Astro.props;

const tone: Record<Generation, string> = {
  abuela: 'pg-barro',
  padres: 'pg-miel',
  hijos: 'pg-pistacho-light',
  nietos: 'pg-lavanda',
};

const genScale: Record<Generation, number> = {
  abuela: 1.06,
  padres: 1,
  hijos: 0.9,
  nietos: 1,
};

const fill = `url(#${tone[generation]})`;

/** Leichte, deterministische Neigung je Person statt echtem Zufall,
    damit ein Rebuild immer dasselbe Markup erzeugt. */
function tilt(n: number): number {
  return ((n * 37) % 11) - 5;
}

interface Figure {
  cx: number;
  cy: number;
  scale: number;
  rotate: number;
}

const baseScale = genScale[generation];

const figures: Figure[] = grupo
  ? [
      { cx: 32, cy: 80, scale: 0.56, rotate: tilt(seed + 1) },
      { cx: 61, cy: 64, scale: 0.72, rotate: tilt(seed + 2) },
      { cx: 89, cy: 82, scale: 0.52, rotate: tilt(seed + 3) },
    ]
  : [{ cx: 60, cy: 62, scale: baseScale, rotate: tilt(seed) }];
---

<svg class="persona-avatar" viewBox="0 0 120 130" aria-hidden="true" focusable="false">
  {grupo && (
    <ellipse cx="61" cy="78" rx="52" ry="34" fill="url(#pg-lavanda)" opacity="0.14" filter="url(#wc-wash)" />
  )}
  {figures.map((f) => (
    <g transform={`translate(${f.cx} ${f.cy}) rotate(${f.rotate}) scale(${f.scale})`}>
      <path
        d="M-30 42 C -30 14, -16 -2, 0 -2 C 16 -2, 30 14, 30 42 Z"
        fill={fill}
        filter="url(#wc-soft)"
      />
      <circle cx="0" cy="-24" r="22" fill={fill} filter="url(#wc-rough)" />
      <circle
        cx="0"
        cy="-24"
        r="22"
        fill="none"
        stroke="var(--tinta)"
        stroke-opacity="0.22"
        stroke-width="1.6"
        filter="url(#ink)"
      />
      <path
        d="M-30 42 C -30 14, -16 -2, 0 -2 C 16 -2, 30 14, 30 42"
        fill="none"
        stroke="var(--tinta)"
        stroke-opacity="0.16"
        stroke-width="1.4"
        filter="url(#ink)"
      />
    </g>
  ))}
</svg>

<style>
  .persona-avatar {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

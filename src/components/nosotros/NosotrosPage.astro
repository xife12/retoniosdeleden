  @media (prefers-reduced-motion: reduce) {
    .nosotros-volver {
      transition: color var(--dur-1) var(--ease-out);
    }

    .nosotros-marca:hover .nosotros-volver,
    .nosotros-marca:focus-visible .nosotros-volver {
      translate: none;
    }

    /* Der Wechsel bleibt, die Bewegung geht. Der Maßstab der Wabe wird im
       Skript in Stufen statt stufenlos gesetzt (siehe `quieto`); hier
       fallen die Übergänge weg, die davon unabhängig sind. */
    .panal.esta-viva .estacion {
      translate: none;
      transition: opacity 200ms linear, visibility 0s linear 200ms;
    }

    .panal.esta-viva .estacion.es-actual {
      translate: none;
    }

    .panal-grupo .celda.es-nueva {
      animation: none;
    }

    .panal-meli {
      transition: opacity 300ms linear;
    }

    .celda-figura {
      transition: none;
    }
  }


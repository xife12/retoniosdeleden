  }

  .nosotros-lead {
    max-width: 46rem;
    font-size: var(--fs-500);
  }

  /* ---------- Nuestro Panal: die wachsende Wabe ----------

     Am Telefon gilt eine Regel, aus der alles andere folgt: es steht nie
     etwas nebeneinander. Deshalb liegt die Wabe oben und der Text
     darunter, in jeder Breite — und deshalb wird die Wabe erst im
     Schlussbild groß, wenn kein Text mehr danebensteht.

     Ohne JavaScript greift keine der `.esta-viva`-Regeln: dann stehen die
     Stationen als Liste untereinander und die Wabe ist ein Bild. */

  .panal {
    padding-block: clamp(1rem, 4vw, 2rem) 0;
  }

  /* Ein Bildschirm für die Bühne, dazu eine Wegstrecke je Station.
     80vh ist der Stellknopf fürs Tempo: kürzer wirkt gehetzt, länger zäh. */
  .panal.esta-viva .panal-pista {
    position: relative;
    height: calc(100vh + var(--estaciones) * 80vh);
  }

  .panal.esta-viva .panal-fijo {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    grid-template-rows: 1fr auto auto;
    align-items: center;
    gap: clamp(0.75rem, 2vh, 1.5rem);
    padding: clamp(4.5rem, 11vh, 6rem) clamp(1rem, 5vw, 2rem) clamp(1.5rem, 4vh, 2.5rem);
    overflow: hidden;
  }

  /* ---------- Die Bühne der Wabe ---------- */

  .panal-escena {
    position: relative;
    min-height: 0;
    height: 100%;
  }

  .panal:not(.esta-viva) .panal-escena {
    height: clamp(16rem, 60vw, 26rem);
  }

  /*
   * Bewegt wird ausschließlich diese Gruppe, über eine einzige
   * `transform`. Die Zellen darin stehen fest — dadurch rechnet der
   * Browser beim Scrollen kein Layout neu, sondern schiebt eine fertige
   * Ebene. Das ist der Unterschied zwischen flüssig und ruckelig auf
   * einem alten Telefon.
   */
  .panal-grupo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-origin: 0 0;
    will-change: transform;
  }

  /* Grundmaß im Raster. Die sichtbare Größe entsteht erst durch den
     Maßstab der Gruppe — deshalb stehen hier feste Zahlen und keine
     Bildschirmmaße. */
  .panal-grupo .celda {
    --base: 100px;
    position: absolute;
    left: calc(var(--cx) * 1px - var(--base) / 2);
    top: calc(var(--cy) * 1px - var(--base) * 1.1547 / 2);
    width: var(--base);
    height: calc(var(--base) * 1.1547);
    display: grid;
    place-items: center;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: var(--ring, transparent);
    border: none;
    padding: 0;
  }

  .panal-grupo .celda[hidden] {
    display: none;
  }

  .celda-figura {
    display: block;
    width: 58%;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  /* Szene 0: die erste Zelle steht schon da, aber leer. Sie füllt sich
     mit der ersten Person — das ist der Auftakt der ganzen Erzählung. */
  .panal.esta-viva:not(.primera-llena) .celda[data-orden='0'] {
    --fill: none;
  }

  .panal.esta-viva:not(.primera-llena) .celda[data-orden='0'] .celda-figura {
    opacity: 0;
  }

  /* Die neue Zelle wächst dort hoch, wo Meli gelandet ist. */
  @keyframes celda-brota {
    from { scale: 0.2; opacity: 0; }
    60% { scale: 1.08; opacity: 1; }
    to { scale: 1; opacity: 1; }
  }

  /* Bewusst OHNE `both`: mit Fülleigenschaft bliebe eine Zelle auf dem
     Anfangsbild der Animation stehen — also winzig und unsichtbar —,
     falls die Animation nie anläuft. Ohne sie gilt in dem Fall der
     normale Zustand, und die Zelle ist einfach da. */
  .panal-grupo .celda.es-nueva {
    animation: celda-brota 620ms var(--ease-bounce);
  }

  .panal-grupo .celda.es-elegida {
    --ring: var(--miel-500);
    --ring-w: 5px;
  }

  /* ---------- Meli ---------- */

  .panal-meli {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    width: clamp(3rem, 11vw, 4.6rem);
    margin: calc(clamp(3rem, 11vw, 4.6rem) * -0.9) 0 0 calc(clamp(3rem, 11vw, 4.6rem) * -0.1);
    pointer-events: none;
    opacity: 0;
    transition:
      translate 780ms cubic-bezier(0.4, 0.02, 0.28, 1),
      rotate 420ms var(--ease-out),
      opacity 500ms var(--ease-out);
  }

  .panal-meli.se-ve {
    opacity: 1;
  }

  /* ---------- Der Text einer Station ---------- */

  .panal-relato {
    display: grid;
    text-align: center;
    justify-items: center;
  }

  .estacion {
    max-width: 34rem;
  }

  .panal.esta-viva .panal-relato {
    grid-template-areas: 'estacion';
    /* Platz für den längsten Stationstext freihalten, damit die Wabe
       nicht bei jedem Wechsel hüpft. */
    min-height: clamp(11rem, 26vh, 15rem);
    align-content: start;
    transition: min-height 500ms var(--ease-out);
  }

  .panal.esta-viva.es-final .panal-relato {
    min-height: 0;
  }

  /* Alle Stationen liegen übereinander; sichtbar ist eine.
     `visibility` statt `display`, damit die Höhe der Bühne bei jedem
     Wechsel gleich bleibt und nichts springt. */
  .panal.esta-viva .estacion {
    grid-area: estacion;
    opacity: 0;
    visibility: hidden;
    translate: 0 12px;
    transition:
      opacity 380ms var(--ease-out),
      translate 480ms var(--ease-out),
      visibility 0s linear 380ms;
  }

  .panal.esta-viva .estacion.es-actual {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition-delay: 120ms, 120ms, 0s;
  }

  .estacion-vinculo {
    font-size: var(--fs-200);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--miel-800);
    margin: 0 0 var(--sp-1);
  }

  .estacion h3 {
    font-family: var(--font-display);

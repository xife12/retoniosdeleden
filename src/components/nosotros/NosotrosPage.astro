---
/**
 * "Nosotros" / "Nuestro Panal" — eigenständige Unterseite über die Menschen
 * hinter der Chacra.
 *
 * Routing- und Aufbau-Vorbild: BookPage.astro. Wie dort hat diese Seite
 * eine eigene, schlanke Kopfleiste statt Nav.astro — Nav.astro ist auf
 * die Ankerliste der Startseite zugeschnitten (IntersectionObserver,
 * `#historia`-artige Sektionen), die es hier nicht gibt. Der Kopf ist
 * bewusst 1:1 im Look von `.site-nav`/`.libro-nav` gehalten (Höhe,
 * Polsterung, Papierton, Unschärfe), damit der Wechsel von der Startseite
 * hierher keinen Sprung macht.
 *
 * ---------------------------------------------------------------------
 * Warum hier eine Erzählung steht und kein Stammbaum mehr
 * ---------------------------------------------------------------------
 * Ein Baum ist zwangsläufig eine Rangordnung: er hat eine Wurzel, einen
 * Stamm und eine Spitze, und wer weiter oben hängt, sieht wichtiger aus.
 * Gewollt ist das Gegenteil — ein Bienenstock, in dem jede Zelle gleich
 * viel wiegt.
 *
 * Deshalb wird beim Scrollen von Person zu Person erzählt: vorne steht
 * immer nur EINE, groß und allein, und auf der kleinen Wabe daneben
 * fliegt Meli zu genau ihrer Zelle. Das löst drei Dinge auf einmal:
 *
 *  - Niemand steht über jemandem. Alle bekommen denselben Auftritt,
 *    dieselbe Größe, denselben Platz.
 *  - Der Stock bleibt trotzdem als Stock sichtbar — die Landkarte zeigt
 *    immer alle Zellen, auch die freien.
 *  - Es wird lesbar auf jedem Bildschirm: eine große Zelle plus Text
 *    braucht keine Fläche, die ein Telefon nicht hat.
 *
 * Unterschieden wird nur über die FÜLLUNG der Zelle: ausgemalt = fest
 * dabei, gestrichelte Kontur = begleitet zeitweise, blass = noch frei.
 * Die leeren Waben sind kein Platzhalter für fehlende Daten. Sie sind die
 * Aussage: der Stock ist nicht fertig.
 */
import Base from '../../layouts/Base.astro';
import Footer from '../Footer.astro';
import Logo from '../Logo.astro';
import PersonAvatar from './PersonAvatar.astro';
import BeeMeli from '../BeeMeli.astro';
import { getDict, type Lang } from '../../i18n';
import {
  celdasLibres,
  comprobarPanal,
  familyIntro,
  nosotrosUI,
  personas,
  values,
} from '../../data/nosotros';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const ui = nosotrosUI[lang];
const pageTitle = t.nav.nosotros;

/*
 * Das Sechseckraster in Bildpunkte umgerechnet — einmal hier, nicht im
 * Browser. `BASE` ist ein Grundmaß in willkürlichen Einheiten; die
 * sichtbare Größe entsteht erst durch den Maßstab, den das Skript beim
 * Scrollen auf die ganze Gruppe legt.
 *
 * Spitze Zellen oben: waagrecht stehen sie um eine volle Breite
 * auseinander, senkrecht nur um drei Viertel ihrer Höhe — dadurch
 * greifen die Reihen ineinander. Der halbe Versatz je Reihe steckt im
 * `r / 2`.
 */
const BASE = 100;
const ALTO = BASE * 1.1547;
const enPixeles = (q: number, r: number) => ({
  x: BASE * (q + r / 2),
  y: ALTO * 0.75 * r,
});

/* Fällt beim Bauen aus, wenn die Wabe eine Lücke hätte. Siehe nosotros.ts. */
comprobarPanal();

const celdas = [
  ...personas.map((p, i) => ({
    id: p.id,
    persona: p,
    i,
    /** Auftrittsreihenfolge. Die freien Zellen bekommen negative Werte. */
    orden: i,
    ...enPixeles(p.q, p.r),
  })),
  ...celdasLibres.map((c, k) => ({
    id: `libre-${k}`,
    persona: undefined,
    i: 0,
    orden: -1 - k,
    ...enPixeles(c.q, c.r),
  })),
];

/**
 * Die Stationen der Erzählung: ein Einstieg, dann je Person eine, dann
 * das Schlussbild. Die Reihenfolge der Personen ist die Reihenfolge in
 * `personas` — chronologisch, wer zuerst da war.
 */
const estaciones = [
  { tipo: 'intro' as const, persona: undefined },
  ...personas.map((p) => ({ tipo: 'persona' as const, persona: p })),
  { tipo: 'final' as const, persona: undefined },
];
---

<Base lang={lang} title={`${pageTitle} · Retoños del Edén`} description={familyIntro[lang]}>
  <a class="skip-link" href="#familia">{t.nav.skip}</a>

  <header class="nosotros-nav">
    <a class="nosotros-marca" href={`/${lang}/`} data-astro-prefetch>
      <svg class="nosotros-volver" viewBox="0 0 20 20" width="13" height="13" aria-hidden="true">
        <path
          d="M12.5 3.5 L 6 10 L 12.5 16.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          filter="url(#ink)"
        />
      </svg>
      <span class="nosotros-marca-logo"><Logo width="34px" decorative /></span>
      <span>Retoños del Edén</span>
    </a>

    <p class="nosotros-nav-titulo">{pageTitle}</p>

    <div class="lang-switch" role="group" aria-label="Idioma / Language">
      <a href="/es/nosotros" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
      <span aria-hidden="true">·</span>
      <a href="/en/about" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
    </div>
  </header>

  <main id="familia">
    <section class="nosotros-intro">
      <div class="wrap">
        <p class="kicker">{ui.eyebrow}</p>
        <h1><span class="swash">{pageTitle}</span></h1>
        <p class="lead nosotros-lead">{familyIntro[lang]}</p>
      </div>
    </section>

    {/* ---------------------------------------------------------------
        Die Erzählung. Eine hohe Bahn, in der eine klebende Bühne stehen
        bleibt; aus dem Scrollfortschritt folgt, welche Station gerade
        läuft und wie weit sie fortgeschritten ist.
        --------------------------------------------------------------- */}
    <section
      class="panal"
      aria-labelledby="panal-titulo"
      style={`--estaciones:${estaciones.length}`}
      data-panal
    >
      <h2 id="panal-titulo" class="visually-hidden">{ui.intro}</h2>

      <div class="panal-pista" data-panal-pista>
        <div class="panal-fijo">

          {/* --- Die Wabe ---
              Die Zellen stehen fest an ihrem Platz im Raster; bewegt wird
              nur die GRUPPE, über eine einzige Transformation. Dadurch
              gibt es beim Scrollen kein Umbrechen und kein Neuberechnen
              von Größen — das läuft auch auf einem alten Telefon rund. */}
          <div class="panal-escena" data-panal-escena>
            <div class="panal-grupo" data-panal-grupo>
              {celdas.map((c) => (
                <div
                  class:list={[
                    'celda',
                    c.persona ? `pig-${c.persona.pigmento}` : 'celda-libre',
                    c.persona ? `vin-${c.persona.vinculo}` : '',
                  ]}
                  style={`--cx:${c.x}; --cy:${c.y}`}
                  data-celda={c.id}
                  data-orden={c.orden}
                  hidden
                >
                  {c.persona && (
                    <span class="celda-figura">
                      <PersonAvatar
                        pigmento={c.persona.pigmento}
                        seed={c.i}
                        grupo={c.persona.grupo}
                        tenue={c.persona.vinculo === 'vuelo'}
                      />
                    </span>
                  )}
                  {(!c.persona || c.persona.vinculo === 'vuelo') && (
                    <svg class="celda-trazo" viewBox="0 0 100 115.47" aria-hidden="true">
                      <polygon points="50,2 98,26.9 98,88.6 50,113.5 2,88.6 2,26.9" />
                    </svg>
                  )}
                </div>
              ))}
            </div>

            {/* Meli trägt jede neue Zelle herein. Sie liegt über der
                Gruppe, wird aber getrennt bewegt — sonst würde sie beim
                Schrumpfen der Wabe mitschrumpfen. */}
            <div class="panal-meli" data-panal-meli aria-hidden="true">
              <BeeMeli width="100%" />
            </div>
          </div>

          {/* --- Der Text ---
              Alle Stationen stehen im Markup, sichtbar ist immer eine.
              Ohne JavaScript stehen sie untereinander und die Seite liest
              sich als Liste. */}
          <div class="panal-relato">
            {estaciones.map((e, i) => (
              <article
                class:list={['estacion', { 'es-actual': i === 0 }]}
                data-estacion={i}
                data-celda-de={e.persona?.id}
              >
                {e.persona ? (
                  <>
                    <p class="estacion-vinculo">
                      {e.persona.vinculo === 'vuelo' ? ui.leyendaVuelo : ui.leyendaNucleo}
                    </p>
                    <h3>{e.persona.name[lang]}</h3>
                    <p class="estacion-rol">{e.persona.role[lang]}</p>
                    {e.persona.detail && (
                      <p class="estacion-detalle">{e.persona.detail[lang]}</p>
                    )}
                  </>
                ) : (
                  <>
                    <h3 class="estacion-titulo-solo">
                      {e.tipo === 'intro' ? ui.introTitulo : ui.finalTitulo}
                    </h3>
                    <p class="estacion-rol">
                      {e.tipo === 'intro' ? ui.introTexto : ui.finalTexto}
                    </p>
                    {e.tipo === 'final' && <p class="estacion-hint">{ui.finalHint}</p>}
                  </>
                )}
              </article>
            ))}
          </div>

          <p class="panal-avance" aria-hidden="true">
            <span data-panal-num>1</span><span class="barra">/</span>{estaciones.length}
          </p>
        </div>
      </div>
    </section>

    <script>
      /**
       * Nuestro Panal — die Wabe wächst beim Scrollen.
       *
       * Drei Ebenen Bewegung, absichtlich getrennt:
       *
       *  a) DURCHGEHEND, direkt am Scrollen: Maßstab und Mitte der ganzen
       *     Gruppe. Zwischen zwei Stationen schrumpft die Wabe stufenlos
       *     und rückt in die Mitte — sie macht Platz für die Zelle, die
       *     gleich kommt. Deshalb bewegt sich etwas, solange gescrollt
       *     wird, und nicht nur an den Halten.
       *  b) JE STATION: Meli fliegt zur neuen Stelle, dort wächst die
       *     Zelle hoch. Das ist eine Klasse und ein Übergang, kein
       *     Rechnen je Bild.
       *  c) STÄNDIG: Flügelschlag und Schweben, aus dem globalen CSS.
       *
       * Warum die Gruppe transformiert wird und nicht jede Zelle einzeln:
       * eine einzige `transform` auf einem Element wird vom Browser
       * zusammengesetzt, ohne das Seitenlayout neu zu rechnen. Würden
       * stattdessen dreizehn Zellen ihre Breite ändern, müsste bei jedem
       * Bild neu umgebrochen werden — sichtbares Ruckeln auf schwachen
       * Geräten.
       */
      const panal = document.querySelector<HTMLElement>('[data-panal]');

      if (panal) {
        const pista = panal.querySelector<HTMLElement>('[data-panal-pista]');
        const escena = panal.querySelector<HTMLElement>('[data-panal-escena]');
        const grupo = panal.querySelector<HTMLElement>('[data-panal-grupo]');
        const meli = panal.querySelector<HTMLElement>('[data-panal-meli]');
        const numEl = panal.querySelector<HTMLElement>('[data-panal-num]');
        const estaciones = Array.from(panal.querySelectorAll<HTMLElement>('[data-estacion]'));
        const celdas = Array.from(panal.querySelectorAll<HTMLElement>('[data-celda]'));
        const quieto = matchMedia('(prefers-reduced-motion: reduce)');

        /* Grundmaß einer Zelle im Raster, in willkürlichen Einheiten. Die
           echte Größe entsteht erst durch den Maßstab der Gruppe. */
        const BASE = 100;
        const ALTO = BASE * 1.1547;

        panal.classList.add('esta-viva');

        /** Zellen nach Auftrittsreihenfolge; -1 sind die freien Zellen. */
        const porOrden = celdas
          .map((el) => ({
            el,
            orden: Number(el.dataset.orden),
            x: Number(el.style.getPropertyValue('--cx')),
            y: Number(el.style.getPropertyValue('--cy')),
          }))
          .sort((a, b) => a.orden - b.orden);

        /* Die letzte Personenzelle. Im Schlussbild gibt es keine neue mehr,
           dort bleibt Meli auf dieser sitzen statt ins Leere zu zeigen. */
        const ultimoOrden = Math.max(...porOrden.map((c) => c.orden));

        const celdaDeEstacion = (n: number) =>
          porOrden.find((c) => c.orden === Math.min(Math.max(n - 1, 0), ultimoOrden));

        /**
         * Welche Zellen sind in Station `n` zu sehen?
         *
         * Station 0 ist der Einstieg: dort steht die erste Zelle schon da,
         * aber leer. Ab Station 1 füllt sie sich, und mit jeder weiteren
         * kommt eine Zelle dazu. In der letzten Station kommen zusätzlich
         * die freien Zellen hinzu.
         */
        const visiblesEn = (n: number) => {
          const ultima = n >= estaciones.length - 1;
          return porOrden.filter(
            (c) => (c.orden >= 0 && c.orden <= Math.max(n - 1, 0)) || (ultima && c.orden < 0),
          );
        };

        interface Encuadre {
          escala: number;
          x: number;
          y: number;
        }

        /**
         * Maßstab und Mitte für eine Anzahl sichtbarer Zellen.
         *
         * Der Maßstab folgt der Ausdehnung: eine einzelne Zelle wird groß
         * gezeigt, dreizehn Zellen entsprechend kleiner. Nach oben
         * begrenzt, damit die erste Zelle nicht den halben Bildschirm
         * einnimmt.
         */
        const encuadrar = (n: number): Encuadre => {
          const vistas = visiblesEn(n);
          if (!escena || !vistas.length) return { escala: 1, x: 0, y: 0 };

          let minX = Infinity;
          let maxX = -Infinity;
          let minY = Infinity;
          let maxY = -Infinity;
          for (const c of vistas) {
            minX = Math.min(minX, c.x - BASE / 2);
            maxX = Math.max(maxX, c.x + BASE / 2);
            minY = Math.min(minY, c.y - ALTO / 2);
            maxY = Math.max(maxY, c.y + ALTO / 2);
          }

          const anchoCaja = maxX - minX;
          const altoCaja = maxY - minY;
          const dispW = escena.clientWidth;
          const dispH = escena.clientHeight;

          const escala = Math.min(dispW / anchoCaja, dispH / altoCaja, 2.6);

          return {
            escala,
            x: -((minX + maxX) / 2) * escala,
            y: -((minY + maxY) / 2) * escala,
          };
        };

        /* Einmal vorgerechnet: die Bilder ändern sich nur, wenn sich die
           Bühne ändert. Bei jedem Scrollbild neu zu rechnen wäre Arbeit
           für nichts. */
        let encuadres: Encuadre[] = [];
        const recalcular = () => {
          encuadres = estaciones.map((_, i) => encuadrar(i));
        };

        /* Sanfter Verlauf statt gleichmäßigem: der Übergang beginnt und
           endet ruhig, sonst wirkt das Schrumpfen mechanisch. */
        const suave = (t: number) => t * t * (3 - 2 * t);

        let estacion = -1;

        const situarMeli = (celda: (typeof porOrden)[number] | undefined, cuadro: Encuadre) => {
          if (!meli || !celda) return;
          const x = cuadro.x + celda.x * cuadro.escala;
          const y = cuadro.y + celda.y * cuadro.escala;
          const antes = Number(meli.dataset.x ?? x);
          meli.dataset.x = String(x);
          meli.style.translate = `${x}px ${y}px`;
          meli.style.rotate = x < antes - 1 ? '-8deg' : '8deg';
          meli.style.transform = x < antes - 1 ? 'scaleX(-1)' : '';
          meli.classList.add('se-ve');
        };

        const irA = (n: number, cuadro: Encuadre) => {
          if (n === estacion) return;
          const antes = estacion;
          estacion = n;

          estaciones.forEach((e, i) => e.classList.toggle('es-actual', i === n));
          if (numEl) numEl.textContent = String(n + 1);

          const ultima = n >= estaciones.length - 1;
          porOrden.forEach((c) => {
            const visible =
              (c.orden >= 0 && c.orden <= Math.max(n - 1, 0)) || (ultima && c.orden < 0);
            const llega = visible && c.el.hidden;
            c.el.hidden = !visible;
            /* Nur die gerade angekommene Zelle wächst hoch — beim Sprung
               über mehrere Stationen (Ankerlink, schnelles Wischen) sollen
               nicht alle gleichzeitig aufpoppen. */
            if (llega && n === antes + 1 && !quieto.matches) {
              c.el.classList.remove('es-nueva');
              void c.el.offsetWidth;
              c.el.classList.add('es-nueva');
            }
          });

          /* Ab Station 1 ist die erste Zelle keine leere Zelle mehr. */
          panal.classList.toggle('primera-llena', n >= 1);
          /* Im Schlussbild gibt der kurze Text seinen reservierten Platz
             frei — die vollständige Wabe soll dort so groß wie möglich
             stehen, sie ist der Schlusspunkt der ganzen Seite. */
          panal.classList.toggle('es-final', ultima);

          /* Meli sitzt auf der zuletzt dazugekommenen Zelle; im Einstieg
             und im Schlussbild auf der ersten. */
          situarMeli(celdaDeEstacion(n), cuadro);
        };

        let pendiente = false;

        const medir = () => {
          pendiente = false;
          if (!pista || !grupo) return;

          const caja = pista.getBoundingClientRect();
          const recorrido = caja.height - innerHeight;
          if (recorrido <= 0) return;

          const avance = Math.min(Math.max(-caja.top / recorrido, 0), 0.999999);
          const bruto = avance * estaciones.length;
          const n = Math.min(Math.floor(bruto), estaciones.length - 1);
          const resto = bruto - n;

          /* Das Bild wandert schon während der Station auf das nächste zu:
             die Wabe macht Platz, bevor die Zelle kommt. Genau das ist die
             durchgehende Bewegung zwischen zwei Stationen. */
          const a = encuadres[n] ?? encuadrar(n);
          const b = encuadres[Math.min(n + 1, estaciones.length - 1)] ?? a;
          const t = quieto.matches ? 0 : suave(resto);

          const cuadro = {
            escala: a.escala + (b.escala - a.escala) * t,
            x: a.x + (b.x - a.x) * t,
            y: a.y + (b.y - a.y) * t,
          };

          grupo.style.transform = `translate(${cuadro.x}px, ${cuadro.y}px) scale(${cuadro.escala})`;

          irA(n, cuadro);

          /* Meli wandert mit dem Bild mit, ohne dass sie dabei "fliegt" —
             sie sitzt ja auf einer Zelle, und die Zelle bewegt sich. */
          const destino = celdaDeEstacion(n);
          if (destino && meli) {
            const x = cuadro.x + destino.x * cuadro.escala;
            const y = cuadro.y + destino.y * cuadro.escala;
            meli.dataset.x = String(x);
            meli.style.translate = `${x}px ${y}px`;
          }
        };

        /**
         * Getaktet über den Bildaufbau: öfter als einmal je Bild zu rechnen
         * bringt nichts. Der Rückfall auf `setTimeout` greift, wenn der
         * Browser den Bildaufbau angehalten hat (verborgene Reiter,
         * eingebettete Ansichten) — sonst bliebe die Erzählung dort auf der
         * ersten Station stehen, obwohl gescrollt wird.
         */
        const alScroll = () => {
          if (pendiente) return;
          pendiente = true;
          if (document.hidden) setTimeout(medir, 0);
          else requestAnimationFrame(medir);
        };

        addEventListener('scroll', alScroll, { passive: true });
        addEventListener('resize', () => {
          recalcular();
          estacion = -1;
          alScroll();
        });

        /* Im Schlussbild sind die Zellen antippbar: die Reise ist vorbei,
           jetzt darf die Wabe ein Nachschlagewerk sein. Der Text wechselt,
           ohne dass sich am Scrollstand etwas ändert. */
        celdas.forEach((el) => {
          el.addEventListener('click', () => {
            if (estacion < estaciones.length - 1) return;
            const id = el.dataset.celda;
            const i = estaciones.findIndex((e) => e.dataset.celdaDe === id);
            if (i < 0) return;
            estaciones.forEach((e, n) => e.classList.toggle('es-actual', n === i));
            celdas.forEach((c) => c.classList.toggle('es-elegida', c === el));
            const cuadro = encuadres[estaciones.length - 1];
            const celda = porOrden.find((c) => c.el === el);
            if (cuadro && celda) situarMeli(celda, cuadro);
          });
        });

        recalcular();
        medir();
      }
    </script>

    <section class="nosotros-valores">
      <div class="wrap">
        <div class="valores-card">
          <p class="kicker">{ui.valuesKicker}</p>
          <p>{values[lang]}</p>
        </div>
      </div>
    </section>
  </main>

  <Footer t={t} lang={lang} />
</Base>

<style>
  /* ---------- Sprungmarke ----------
     Wie auf der Buchseite: keine Nav.astro hier, die sie sonst stylt. */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 300;
    background: var(--miel-500);
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
    padding: 0.6em 1.2em;
    border-radius: var(--r-full);
  }

  .skip-link:focus-visible {
    top: 0.75rem;
  }

  /* ---------- Kopfleiste ----------
     1:1 aus .site-nav/.libro-nav übernommen (siehe BookPage.astro). */
  .nosotros-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-4);
    padding: 0.65rem clamp(1rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--papel) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(51, 41, 31, 0.07);
  }

  @media (max-width: 859px) {
    .nosotros-nav {
      grid-auto-rows: minmax(44px, auto);
    }
  }

  .nosotros-marca {
    grid-column: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--tinta);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 80, 'WONK' 1;
    font-weight: 620;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .nosotros-marca-logo {
    display: block;
    flex: none;
  }

  .nosotros-volver {
    flex: none;
    color: var(--tinta-tenue);
    transition:
      translate var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .nosotros-marca:hover .nosotros-volver,
  .nosotros-marca:focus-visible .nosotros-volver {
    translate: -3px 0;
    color: var(--tinta-suave);
  }

  .nosotros-nav-titulo {
    grid-column: 2;
    display: none;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 90, 'WONK' 1;

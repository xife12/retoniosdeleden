    font-size: var(--fs-800);
    line-height: var(--lh-tight);
    margin: 0 0 var(--sp-2);
    text-wrap: balance;
  }

  .estacion-titulo-solo {
    color: var(--miel-800);
  }

  .estacion-rol {
    font-size: var(--fs-500);
    margin: 0 0 var(--sp-3);
  }

  .estacion-detalle {
    color: var(--tinta-suave);
    margin: 0;
  }

  .estacion-hint {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-300);
    font-style: italic;
    color: var(--tinta-tenue);
  }

  .panal-avance {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-300);
    color: var(--tinta-tenue);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .panal-avance .barra {
    margin: 0 0.35em;
    opacity: 0.6;
  }

  .panal:not(.esta-viva) .panal-avance {
    display: none;
  }

  /* Ohne JavaScript: Stationen als Liste, mit Luft dazwischen. */
  .panal:not(.esta-viva) .estacion + .estacion {
    margin-top: clamp(2rem, 6vw, 3.5rem);
  }

  .panal:not(.esta-viva) .panal-relato {
    margin-top: clamp(2rem, 6vw, 3.5rem);
    padding-inline: clamp(1rem, 5vw, 2rem);
  }

  /* ---------- Die Zelle: Bauweise und Pigmente ----------

     Eine Zelle hat ZWEI Ebenen. Ein Rahmen ist hier nicht möglich:
     `border` und `box-shadow: inset` folgen dem RECHTECK des Elements,
     und `clip-path` schneidet danach die Ecken weg — von einem Rahmen
     blieben nur die beiden senkrechten Stücke übrig, die schrägen Kanten
     wären nackt. Deshalb ist das Element selbst die Kontur (`--ring`) und
     das ::before darin die Fläche (`--fill`), um die Strichstärke
     eingerückt. Bei `--ring-w: 0` deckt die Fläche alles ab.

     Die gestrichelte Kontur der offenen Zellen kann das nicht leisten —
     eine Strichelung muss der schrägen Kante folgen, und das kann nur ein
     Pfad. Dafür liegt in jenen Zellen ein echtes SVG-Sechseck. */

  .celda::before {
    content: '';
    position: absolute;
    inset: var(--ring-w, 0px);
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: var(--fill, transparent);
  }

  .celda > * {
    position: relative;
  }

  .celda-trazo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--tinta-tenue);
    stroke-width: 2.4;
    stroke-dasharray: 3.4 7;
    stroke-linecap: round;
    pointer-events: none;
  }

  /* Die freien Zellen sollen als ZELLEN lesbar bleiben, nicht als Lücke —
     sonst geht die Aussage "der Stock ist nicht fertig" verloren. */
  .celda-libre .celda-trazo {
    stroke-width: 2;
    stroke-dasharray: 2.6 7;
    opacity: 0.62;
  }

  /* Das Pigment steht für die TÄTIGKEIT, nicht für die Generation —
     damit trägt die Farbe eine Aussage und keine Rangfolge. */
  .pig-miel { --fill: var(--miel-200); }
  .pig-barro { --fill: var(--barro-200); }
  .pig-pistacho { --fill: var(--pistacho-200); }
  .pig-lavanda { --fill: var(--lavanda-200); }

  .vin-nucleo { --ring-w: 0px; }

  /* Offen: begleitet zeitweise. Gleiche Größe, gleiche Form — nur eine
     gestrichelte Kontur um eine helle Mitte. Der Unterschied ist
     Anwesenheit, nicht Rang. */
  .vin-vuelo {
    --ring-w: 0px;
    --fill: var(--papel);
  }

  .celda-libre {
    --ring-w: 0px;
    --fill: none;
  }

  /* ---------- Valores ---------- */

  .nosotros-valores {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 5rem);
  }

  .valores-card {

---
import type { Dict, Lang } from '../i18n';
import { casas, casaUI, fill, type CasaArt, type CasaGlyph } from '../data/casas';

interface Props {
  t: Dict;
  /** Optional. Site.astro reicht (noch) nur `t` durch, daher Fallback über den Pfad. */
  lang?: Lang;
}

const { t, lang: langProp } = Astro.props;
const lang: Lang = langProp ?? (Astro.url.pathname.startsWith('/en') ? 'en' : 'es');
const ui = casaUI[lang];

const statusChip: Record<string, string> = {
  listo: '',
  enObra: 'chip--barro',
  planeado: 'chip--lavanda',
};


    <g fill="#a4444a" opacity="0.85" filter="url(#wc-rough)">
      <path d="M56 150 L 68 154 L 56 158 Z" /><path d="M224 134 L 236 138 L 224 142 Z" />
    </g>
    <path d="M296 178 C 294 166, 294 158, 296 148" stroke="#5b6c42" stroke-width="3" stroke-linecap="round"
      fill="none" filter="url(#ink)" />
    <ellipse cx="296" cy="144" rx="7" ry="13" fill="url(#pg-lavanda)" filter="url(#wc-rough)" />`,
};

/** Facts-Kacheln je Haus zusammenbauen (Werte sprachneutral, Labels aus casaUI). */
function factsOf(f: { beds: number; guests: number; area: number; bedrooms: number; bathrooms: number }) {
  return [
    { glyph: 'bed' as CasaGlyph, value: String(f.beds), key: ui.beds },
    { glyph: 'guests' as CasaGlyph, value: String(f.guests), key: ui.guests },
    { glyph: 'area' as CasaGlyph, value: `${f.area} ${ui.areaUnit}`, key: ui.area },
    {
      glyph: 'bedroom' as CasaGlyph,
      value: String(f.bedrooms),
      key: f.bedrooms === 1 ? ui.bedroom : ui.bedrooms,
    },
    {
      glyph: 'bath' as CasaGlyph,
      value: String(f.bathrooms),
      key: f.bathrooms === 1 ? ui.bathroom : ui.bathrooms,
    },
  ];
}

<script>
  const backdrop = document.querySelector<HTMLElement>('[data-casa-backdrop]');
  const modalEls = Array.from(document.querySelectorAll<HTMLElement>('[data-casa-modal]'));
  const modals = new Map<string, HTMLElement>();
  const resetters = new Map<HTMLElement, () => void>();
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const el of modalEls) {
    const id = el.dataset.casaModal;
    if (id) modals.set(id, el);
  }

  let current: HTMLElement | null = null;
  let lastTrigger: HTMLElement | null = null;

  function focusables(root: HTMLElement): HTMLElement[] {
    return Array.from(
      root.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    ).filter((el) => !el.hidden && el.offsetParent !== null);
  }

  function openCasa(id: string, trigger: HTMLElement) {
    const modal = modals.get(id);
    if (!modal || current) return;
    current = modal;
    lastTrigger = trigger;
    if (backdrop) backdrop.hidden = false;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    resetters.get(modal)?.();
    modal.querySelector<HTMLElement>('[data-casa-close]')?.focus({ preventScroll: true });
  }

  function closeCasa() {
    if (!current) return;
    current.hidden = true;
    current = null;
    if (backdrop) backdrop.hidden = true;
    document.body.style.overflow = '';
    lastTrigger?.focus({ preventScroll: true });
    lastTrigger = null;
  }

  document.querySelectorAll<HTMLElement>('[data-casa-open]').forEach((btn) => {
    btn.addEventListener('click', () => openCasa(btn.dataset.casaOpen ?? '', btn));
  });

  for (const modal of modalEls) {
    modal.querySelectorAll('[data-casa-close]').forEach((b) =>
      b.addEventListener('click', closeCasa)
    );
    // Link ins Kontaktformular: erst schließen, dann springt der Anker
    modal.querySelectorAll('[data-casa-contact]').forEach((a) =>
      a.addEventListener('click', closeCasa)
    );
  }

  backdrop?.addEventListener('click', closeCasa);

  document.addEventListener('keydown', (e) => {
    if (!current) return;
    if (e.key === 'Escape') {
      e.preventDefault();
      closeCasa();
      return;
    }
    if (e.key !== 'Tab') return;
    const items = focusables(current);
    if (items.length === 0) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement as HTMLElement | null;
    if (e.shiftKey && (active === first || !current.contains(active))) {
      last.focus();
      e.preventDefault();
    } else if (!e.shiftKey && active === last) {
      first.focus();
      e.preventDefault();
    }
  });

  /* ---------- Galerie: Scroll-Snap + Punkte + Pfeile ---------- */
  for (const modal of modalEls) {
    const track = modal.querySelector<HTMLElement>('[data-gal-track]');
    if (!track) continue;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-gal-slide]'));
    const dots = Array.from(modal.querySelectorAll<HTMLButtonElement>('[data-gal-dot]'));
    const prev = modal.querySelector<HTMLButtonElement>('[data-gal-prev]');
    const next = modal.querySelector<HTMLButtonElement>('[data-gal-next]');
    const count = slides.length;
    let index = 0;
    let frame = 0;

    function paint() {
      dots.forEach((dot, k) => {
        const on = k === index;
        dot.classList.toggle('is-on', on);
        dot.setAttribute('aria-current', on ? 'true' : 'false');
      });
    }

    function sync() {
      if (!track) return;
      const width = track.clientWidth || 1;
      const guess = Math.round(track.scrollLeft / width);
      index = Math.min(count - 1, Math.max(0, guess));
      paint();
    }

    function goTo(target: number) {
      if (!track || count === 0) return;
      const wrapped = ((target % count) + count) % count;
      const isJump = Math.abs(wrapped - index) > 1;
      index = wrapped;
      paint();
      track.scrollTo({
        left: wrapped * track.clientWidth,
        behavior: reduced.matches || isJump ? 'auto' : 'smooth',
      });
    }

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, k) => dot.addEventListener('click', () => goTo(k)));

    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true }
    );

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(index - 1);
      }
    });

    resetters.set(modal, () => {
      track.scrollLeft = 0;
      index = 0;
      paint();
    });

    paint();
  }
</script>

<style>

---
/**
 * Der Leseabschnitt: der Abstieg in den Stock.
 *
 * Ein Kapitel besteht aus zwei Takten, die auf demselben durchgehenden
 * Papier liegen — es gibt keine Kästen mehr:
 *
 *   Takt A  .acto--lamina   Die Buchseite. Groß und allein. Ein
 *                           Wissenslicht im Bild, darunter der Seitentext
 *                           als lesbarer Buchsatz und das Vorlesen.
 *
 *   .vuelo                  Die gepunktete Tusche-Fluglinie. Meli fliegt
 *                           beim Scrollen an ihr entlang aus dem Bild
 *                           hinunter. Das ist die Naht zwischen den Takten.
 *
 *   Takt B  .acto--taller   Melis Szene. Kein Buchbild, sondern eine
 *                           gemalte Bühne: Sprechblase, Spiel, und die
 *                           zweite Wissenskarte als ihr Zettel.
 *
 * Die Tiefe `--hondura` (0…1) steuert Vignette, Pollendichte, Papierton
 * und Schattenwurf. Zwischen Seite 1 und Seite 9 ist der Unterschied
 * deshalb auch auf einem stillen Screenshot sofort sichtbar.
 */
import { Image } from 'astro:assets';
import { pages, libroUI, zones, totalCards, totalJuegos } from '../../data/libro';
import type { Lang } from '../../i18n';
import BeeMeli from '../BeeMeli.astro';
import Juego from './Juego.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = libroUI[lang];

/* Pollenstaub: feste Werte, damit Server und Browser dasselbe rendern. */
const motas = Array.from({ length: 26 }, (_, i) => ({
  x: `${(i * 97) % 100}%`,
  s: `${3 + ((i * 5) % 7)}px`,
  d: `${11 + ((i * 3) % 13)}s`,
  delay: `${-((i * 7) % 17)}s`,
  drift: `${((i % 5) - 2) * 22}px`,
}));

const zonasJSON = Object.fromEntries(
  Object.entries(zones).map(([k, z]) => [
    k,
    { bg: z.bg, papel: z.papel, depth: z.depth, nombre: z.nombre[lang] },
  ])
);

/* „Los ojos de Meli" ist kein Spiel unter dem Bild, sondern ein
   Ansichtsmodus DES Bildes — der Knopf gehört deshalb zur Buchseite. */
const enLamina = new Set(['ojos']);

/* ---------------------------------------------------------------
   Die Fluglinie — EINE Quelle für Zeichnung UND Bewegung.
   ---------------------------------------------------------------
   Aus diesen Kontrollpunkten entsteht sowohl das `d` des SVG-Pfades
   als auch (über data-vuelo-curva) die Bézier-Auswertung im Skript
   weiter unten. Wer hier etwas ändert, ändert beides zugleich — Meli
   kann gar nicht mehr neben ihrer eigenen Linie herfliegen.

   Die Box ist schmal und hoch (84 x 260). Der Weg nach unten misst
   240 Einheiten, der seitliche Ausschlag nur 48 — Verhältnis 5:1.
   Der Flug führt also erkennbar von der Buchseite HINUNTER in Melis
   Szene, statt hin und her zu pendeln.

   Zwei spiegelbildliche Bögen, wie die Punktlinie auf der Startseite
   (.entrada-baja). Am Übergang (42|130) sind die Griffe gleich lang
   und gleich gerichtet — (30|46) hinein, (32|46) hinaus —, die Naht
   ist also glatt und Meli macht dort keinen Knick.

   `vueloCaja` muss zu `--vuelo-alto` / `aspect-ratio` in libro.css
   passen (84/260), sonst wird das SVG ungleichmäßig gestreckt und
   die Strichstärke verzerrt sich wieder. */
const vueloCaja: [number, number] = [84, 260];
const vueloSegs: number[][][] = [
  /* erster Bogen: sanft nach links */
  [[42, 10], [10, 56], [10, 84], [42, 130]],
  /* zweiter Bogen: spiegelbildlich nach rechts */
  [[42, 130], [74, 176], [74, 204], [42, 250]],
];
const vueloD = vueloSegs
  .map((s, i) => {
    const inicio = i === 0 ? `M${s[0][0]} ${s[0][1]} ` : '';
    return `${inicio}C ${s[1][0]} ${s[1][1]}, ${s[2][0]} ${s[2][1]}, ${s[3][0]} ${s[3][1]}`;
  })
  .join(' ');
---

<div
  class="libro reader"
  data-reader
  data-zonas={JSON.stringify(zonasJSON)}
  data-vuelo-curva={JSON.stringify({ caja: vueloCaja, segs: vueloSegs })}
  data-ui={JSON.stringify({
    read: ui.read,
    readStop: ui.readStop,
    found: ui.found,
    close: ui.cardClose,
    zoom: ui.zoomLabel,
    zoomHint: ui.zoomHint,
    carnetCount: ui.carnetCount,
    totalCards,
    totalJuegos,
  })}
  data-cartas={JSON.stringify(
    pages.map((p) => ({
      n: p.n,
      voz: p.voz,
      cards: p.cards.map((c) => ({
        title: c.title[lang],
        text: c.text[lang],
        chacra: c.chacra?.[lang] ?? null,
      })),
    }))
  )}
>
  <!-- Der Abstieg: Licht und Staub über allem -->
  <div class="abismo" aria-hidden="true"></div>
  <div class="polvo" aria-hidden="true">
    {motas.map((m) => (
      <i style={`--x:${m.x}; --s:${m.s}; --d:${m.d}; --delay:${m.delay}; --drift:${m.drift}`}></i>
    ))}
  </div>

  <!-- Wabenfortschritt -->
  <nav class="panal" aria-label={ui.pageOf}>
    {pages.map((p) => (
      <button
        class="panal-celda"
        data-panal={p.n}
        aria-label={`${ui.pageOf} ${p.n}: ${p.capitulo[lang]}`}
      >
        <svg viewBox="0 0 24 28" aria-hidden="true">
          <path class="celda-miel" d="M12 1 L22 7 L22 21 L12 27 L2 21 L2 7 Z" />
          <path class="celda-linea" d="M12 1 L22 7 L22 21 L12 27 L2 21 L2 7 Z" />
        </svg>
        <span class="panal-n">{p.n}</span>
      </button>
    ))}
    <span class="panal-sigue" title={ui.moreInBook} aria-label={ui.moreInBook}>···</span>
  </nav>

  <div class="columna">
    {pages.map((p, i) => {
      const enLaLamina = p.juego && enLamina.has(p.juego);
      const tieneTaller = Boolean(p.juego) || p.cards.length > 1;
      const luz = p.cards[0];
      const apunte = p.cards[1];
      return (
        <article class="capitulo">
          <!-- Takt A: die Buchseite -->
          <section
            class:list={['acto', 'acto--lamina', p.n === 1 && 'acto--portada']}
            data-acto
            data-pagina={p.n}
            data-zona={p.zone}
            aria-label={p.capitulo[lang]}
          >
            <figure class="lamina" data-lamina>
              <span class="lamina-marco">
                <Image
                  src={p.img}
                  alt={p.texto}
                  widths={[640, 1024, 1536]}
                  sizes="(min-width: 46rem) 62rem, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  class="lamina-img"
                  data-lamina-img
                />

                {luz && (
                  <button
                    class="luz"
                    style={`left:${luz.x}%; top:${luz.y}%;`}
                    data-carta={`${p.n}-0`}
                    aria-label={luz.title[lang]}
                  >
                    <svg viewBox="0 0 40 40" aria-hidden="true">
                      <circle class="luz-anillo" cx="20" cy="20" r="12" fill="none"
                        stroke="#fff6d8" stroke-width="2" />
                      <circle cx="20" cy="20" r="11.5" fill="#33291f" opacity="0.45" />
                      <circle class="luz-halo" cx="20" cy="20" r="9" fill="url(#pg-sol)" />
                      <circle cx="20" cy="20" r="11.5" fill="none" stroke="#fffdf8"
                        stroke-width="2.2" filter="url(#ink)" />
                      <path d="M20 13.5 L21.6 18 L26 19.6 L21.6 21.2 L20 25.6 L18.4 21.2 L14 19.6 L18.4 18 Z"
                        fill="#fffdf8" />
                      <path class="luz-tilde" d="M15 20.5 L18.5 24 L25.5 16.5" fill="none"
                        stroke="#fffdf8" stroke-width="3" stroke-linecap="round"
                        stroke-linejoin="round" />
                    </svg>
                  </button>
                )}

                {enLaLamina && <Juego juego={p.juego} lang={lang} parte="lamina" />}

                <button class="lupa" data-lupa={p.n}>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.6" fill="none" stroke="currentColor"
                      stroke-width="2.2" filter="url(#ink)" />
                    <path d="M15.4 15.4 L20.5 20.5" stroke="currentColor" stroke-width="2.4"
                      stroke-linecap="round" />
                    <path d="M8 10.5 L13 10.5 M10.5 8 L10.5 13" stroke="currentColor"
                      stroke-width="1.8" stroke-linecap="round" />
                  </svg>
                  <span>{ui.zoomLabel}</span>
                </button>
              </span>
            </figure>

            <div class="relato">
              <span class="relato-capitulo">{ui.pageOf} {p.n} · {p.capitulo[lang]}</span>
              <p class="relato-texto" data-relato={p.n}>{p.voz}</p>

              <div class="relato-mandos">
                <button class="boton leer" data-leer={p.n} hidden>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 9.5 L8 9.5 L13 5 L13 19 L8 14.5 L4 14.5 Z" fill="currentColor" />
                    <path class="onda" d="M16.5 8.5 C 19 11, 19 13, 16.5 15.5" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <path class="onda onda-2" d="M19.5 6 C 23 10, 23 14, 19.5 18" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  </svg>
                  <span data-leer-label>{ui.read}</span>
                </button>

                <span class="voz-menu">
                  <button class="boton voz-mas" data-voz-abre aria-expanded="false"
                    aria-label={ui.voiceLabel} hidden>
                    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                      <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                      <path d="M12 12 L12 17 M8 20 L16 20" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </button>
                  <div class="voz-lista" data-voz-lista hidden>
                    <p>{ui.voiceHint}</p>
                  </div>
                </span>

                {enLaLamina && <Juego juego={p.juego} lang={lang} parte="mando" />}
              </div>
            </div>
          </section>

          {tieneTaller && (
            <>
              <!-- Die Naht: Meli fliegt hinunter -->
              <div class="vuelo" data-vuelo aria-hidden="true">
                {/* Kein preserveAspectRatio="none" mehr: die viewBox hat exakt
                    dasselbe Seitenverhältnis wie die Box in libro.css, das SVG
                    wird also gleichmäßig skaliert und der Strich bleibt fein. */}
                <svg class="vuelo-senda" viewBox={`0 0 ${vueloCaja[0]} ${vueloCaja[1]}`}>
                  <path class="vuelo-linea" d={vueloD} vector-effect="non-scaling-stroke" />
                </svg>
                <span class="vuelo-meli" data-vuelo-meli>
                  <BeeMeli width="100%" />
                </span>
              </div>

              <!-- Takt B: Melis Szene -->
              <section
                class="acto acto--taller"
                data-acto
                data-pagina={p.n}
                data-zona={p.zone}
                aria-label={p.capitulo[lang]}
              >
                <div class="taller">
                  {p.juego && <Juego juego={p.juego} lang={lang} parte="escena" />}

                  {apunte && (
                    <aside class="apunte">
                      <span class="apunte-kicker">{ui.cardKicker}</span>
                      <h4>{apunte.title[lang]}</h4>
                      <p>{apunte.text[lang]}</p>
                      {apunte.chacra && (
                        <p class="apunte-chacra">
                          <span class="apunte-sello" aria-hidden="true">
                            <svg viewBox="0 0 40 40">
                              <circle cx="20" cy="20" r="17" fill="#aebd8a" filter="url(#wc-rough)" />
                              <path d="M20 30 C 20 22, 19 17, 20 10 M 20 20 C 14 17, 11 13, 10 8 M 20 24 C 26 21, 29 17, 30 12"
                                stroke="#3f4f30" stroke-width="2.2" stroke-linecap="round"
                                fill="none" filter="url(#ink)" />
                            </svg>
                          </span>
                          <span><strong>{ui.chacraLabel}:</strong> {apunte.chacra[lang]}</span>
                        </p>
                      )}
                    </aside>
                  )}
                </div>
              </section>
            </>
          )}
        </article>
      );
    })}
  </div>

  <!-- Abschluss -->
  <section class="acto acto--fin" data-acto data-pagina="fin" data-zona="corazon"
    aria-label={ui.endTitle}>
    <div class="fin-inner">
      <div class="fin-meli bee-float" aria-hidden="true">
        <BeeMeli width="clamp(84px, 16vw, 124px)" />
      </div>
      <h2>{ui.endTitle}</h2>
      <p class="fin-lead">{ui.endText}</p>

      <div class="fin-carnet" data-fin-carnet></div>

      <div class="fin-caminos">
        <article class="fin-camino">
          <h3>{ui.endBookTitle}</h3>
          <p>{ui.endBookText}</p>
          {/* Sobald der Verkaufsweg feststeht, hier die echte Kauf-URL eintragen. */}
          <a class="btn btn--sm" href="#contacto-libro">{ui.endBookCta}</a>
        </article>
        <article class="fin-camino">
          <h3>{ui.endSchoolTitle}</h3>
          <p>{ui.endSchoolText}</p>
          <a class="btn btn--sm btn--secondary" href="#contacto-libro">{ui.endSchoolCta}</a>
        </article>
        <article class="fin-camino">
          <h3>{ui.endWorkshopTitle}</h3>
          <p>{ui.endWorkshopText}</p>
          <a class="btn btn--sm btn--ghost" href={`/${lang}/#talleres`}>{ui.endWorkshopCta}</a>
        </article>
      </div>

      <p class="fin-derechos" id="contacto-libro">{ui.rights}</p>
      <a class="fin-casa" href={`/${lang}/`}>{ui.backHome}</a>
    </div>
  </section>

  <!-- Sammelheft -->
  <button class="carnet-abre" data-carnet-abre>
    <span class="carnet-gota" aria-hidden="true">
      <svg viewBox="0 0 32 32">
        <path d="M16 2 L28 9 L28 23 L16 30 L4 23 L4 9 Z" fill="#fdf6e6" stroke="#b3761c"
          stroke-width="2" filter="url(#ink)" />
        <path class="carnet-relleno" d="M16 2 L28 9 L28 23 L16 30 L4 23 L4 9 Z" fill="#e8a13d" />
      </svg>
    </span>
    <span data-carnet-n>0</span>
  </button>

  <!-- Wissenskarte -->
  <div class="telon" data-telon hidden></div>
  <aside class="nota" data-nota role="dialog" aria-modal="true" aria-labelledby="nota-t" hidden>
    <div class="nota-hoja">
      <span class="nota-meli" aria-hidden="true"><BeeMeli width="100%" /></span>
      <span class="nota-kicker">{ui.cardKicker}</span>
      <h3 id="nota-t" data-nota-titulo></h3>
      <p class="nota-texto" data-nota-texto></p>
      <p class="nota-chacra" data-nota-chacra hidden>
        <span class="nota-sello" aria-hidden="true">
          <svg viewBox="0 0 40 40">
            <circle cx="20" cy="20" r="17" fill="#aebd8a" filter="url(#wc-rough)" />
            <path d="M20 30 C 20 22, 19 17, 20 10 M 20 20 C 14 17, 11 13, 10 8 M 20 24 C 26 21, 29 17, 30 12"
              stroke="#3f4f30" stroke-width="2.2" stroke-linecap="round" fill="none" filter="url(#ink)" />
          </svg>
        </span>
        <span><strong>{ui.chacraLabel}:</strong> <span data-nota-chacra-texto></span></span>
      </p>
      <div class="nota-pie">
        <button class="boton" data-nota-cerrar>{ui.cardClose}</button>
      </div>
    </div>
  </aside>

  <!-- Nahseh-Modus -->
  <div class="visor" data-visor hidden>
    <div class="visor-barra">
      <span>{ui.zoomHint}</span>
      <button class="boton" data-visor-cerrar>{ui.cardClose}</button>
    </div>
    <div class="visor-lienzo" data-visor-lienzo></div>
  </div>

  <!-- Das Heft selbst -->
  <div class="telon" data-telon-carnet hidden></div>
  <aside class="carnet" data-carnet role="dialog" aria-modal="true" aria-labelledby="carnet-t" hidden>
    <div class="nota-hoja">
      <span class="nota-meli" aria-hidden="true"><BeeMeli width="100%" /></span>
      <span class="nota-kicker">{ui.carnetLead}</span>
      <h3 id="carnet-t">{ui.carnetTitle}</h3>

      <p class="carnet-vacio" data-carnet-vacio>{ui.carnetEmpty}</p>

      <div class="carnet-grupo" data-grupo-cartas hidden>
        <h4>{ui.carnetSaberes} <span data-cuenta-cartas></span></h4>
        <ul class="carnet-lista" data-lista-cartas></ul>
      </div>

      <div class="carnet-grupo" data-grupo-juegos hidden>
        <h4>{ui.carnetPruebas} <span data-cuenta-juegos></span></h4>
        <ul class="carnet-lista" data-lista-juegos></ul>
      </div>

      <div class="nota-pie">
        <button class="boton" data-carnet-cerrar>{ui.carnetClose}</button>
      </div>
    </div>
  </aside>
</div>

<script>
  import { crearLector } from '../../scripts/voz';
  import type { LogroDetalle } from '../../scripts/juego';

  const reader = document.querySelector<HTMLElement>('[data-reader]');
  if (reader) {
    const suave = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    interface ZonaDato {
      bg: string;
      papel: string;
      depth: number;
      nombre: string;
    }
    const zonas: Record<string, ZonaDato> = JSON.parse(reader.dataset.zonas ?? '{}');
    const ui = JSON.parse(reader.dataset.ui ?? '{}');
    const paginas: {
      n: number;
      voz: string;
      cards: { title: string; text: string; chacra: string | null }[];
    }[] = JSON.parse(reader.dataset.cartas ?? '[]');

    /* ---------- Abstieg: Zone, Tiefe, Wabe ---------- */

    const celdas = [...reader.querySelectorAll<HTMLElement>('[data-panal]')];
    const leidas = new Set<number>();
    const plenas = new Set<number>();
    let zonaActual = '';
    let paginaActual = 0;

    const pintarPanal = () => {
      celdas.forEach((c) => {
        const n = Number(c.dataset.panal);
        c.classList.toggle('is-leida', leidas.has(n));
        c.classList.toggle('is-plena', plenas.has(n));
        c.classList.toggle('is-actual', n === paginaActual);
      });
    };

    const aplicarZona = (z: string | undefined) => {
      if (!z || !zonas[z] || z === zonaActual) return;
      zonaActual = z;
      const d = zonas[z];
      reader.style.setProperty('--zona-fondo', d.bg);
      reader.style.setProperty('--zona-papel', d.papel);
      reader.style.setProperty('--hondura', String(d.depth));
      document.body.style.background = d.bg;
    };

    /* Der mittlere Streifen des Fensters entscheidet, wo man gerade ist.
       Robuster als eine Sichtbarkeitsschwelle: ein Takt, der höher als das
       Fenster ist, erreicht 50 % Sichtbarkeit womöglich nie. */
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          const sec = e.target as HTMLElement;
          sec.classList.toggle('is-aqui', e.isIntersecting);
          if (!e.isIntersecting) continue;

          aplicarZona(sec.dataset.zona);

          const n = Number(sec.dataset.pagina);
          if (n) {
            leidas.add(n);
            paginaActual = n;
            pintarPanal();
          }
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    reader.querySelectorAll('[data-acto]').forEach((s) => io.observe(s));
    aplicarZona(reader.querySelector<HTMLElement>('[data-acto]')?.dataset.zona);

    celdas.forEach((c) => {
      c.addEventListener('click', () => {
        reader
          .querySelector(`[data-pagina="${c.dataset.panal}"]`)
          ?.scrollIntoView({ behavior: suave ? 'auto' : 'smooth' });
      });
    });

    /* ---------- Meli fliegt an der Tuschelinie hinunter ---------- */

    /* Die Kurve kommt aus DEMSELBEN Datensatz, aus dem oben im Markup das
       `d` des Pfades gebaut wurde (siehe `vueloSegs` im Frontmatter). Damit
       können Linie und Biene nicht mehr auseinanderlaufen — vorher standen
       die Kontrollpunkte doppelt im Code und mussten von Hand synchron
       gehalten werden. */
    const curva: { caja: [number, number]; segs: number[][][] } | null = JSON.parse(
      reader.dataset.vueloCurva ?? 'null'
    );
    const vuelos = [...reader.querySelectorAll<HTMLElement>('[data-vuelo]')];

    if (curva && vuelos.length && !suave) {
      const [cajaW, cajaH] = curva.caja;
      const segs = curva.segs;

      /* Ein Punkt auf der zusammengesetzten Kurve. t (0…1) läuft über alle
         Segmente; jedes Segment bekommt denselben Anteil. Weil beide Bögen
         gleich viel Höhe überbrücken (je 120 Einheiten), bleibt das Tempo
         gleichmäßig. */
      const punto = (t: number): [number, number] => {
        const n = segs.length;
        const bruto = Math.max(0, Math.min(0.999999, t)) * n;
        const i = Math.min(n - 1, Math.floor(bruto));
        const u = bruto - i;
        const p = segs[i];
        const v = 1 - u;
        const a = v * v * v;
        const b = 3 * v * v * u;
        const c = 3 * v * u * u;
        const d = u * u * u;
        return [
          a * p[0][0] + b * p[1][0] + c * p[2][0] + d * p[3][0],
          a * p[0][1] + b * p[1][1] + c * p[2][1] + d * p[3][1],
        ];
      };

      let pendiente = false;
      const mover = () => {
        pendiente = false;
        const vh = window.innerHeight;
        for (const v of vuelos) {
          const r = v.getBoundingClientRect();
          if (r.bottom < -vh || r.top > vh * 2) continue;
          const meli = v.querySelector<HTMLElement>('[data-vuelo-meli]');
          const senda = v.querySelector<SVGSVGElement>('.vuelo-senda');
          if (!meli || !senda) continue;

          /* Gerechnet wird im Rechteck DES SVG, nicht im Rechteck der ganzen
             .vuelo-Bahn. Die Bahn ist so breit wie das Blatt (bis 74rem), das
             SVG nur rund 90 px — vorher schwang Meli deshalb um ein Vielfaches
             weiter aus als ihre gezeichnete Linie. */
          const s = senda.getBoundingClientRect();
          const escX = s.width / cajaW;
          const escY = s.height / cajaH;

          const t = Math.max(0, Math.min(1, (vh - r.top) / (vh + r.height)));
          const [x, y] = punto(t);

          /* Melis Mitte auf den Kurvenpunkt legen (translate: -50% -50%
             in libro.css nimmt ihre halbe Größe schon heraus). */
          meli.style.setProperty('--vx', `${s.left - r.left + x * escX - r.width / 2}px`);
          meli.style.setProperty('--vy', `${s.top - r.top + y * escY}px`);

          /* Neigung aus einem zentralen Differenzenquotienten — eine reine
             Vorwärtsdifferenz wäre am Ende der Kurve entartet und Meli
             würde dort ruckartig geradestehen.
             0° = senkrecht hinunter, positiv = Drift nach rechts. Der
             gedämpfte Faktor lässt sie nur leicht in Flugrichtung kippen
             (höchstens rund 14°), statt hektisch zu rotieren. */
          const [xa, ya] = punto(Math.max(0, t - 0.015));
          const [xb, yb] = punto(Math.min(1, t + 0.015));
          const grados = (Math.atan2((xb - xa) * escX, (yb - ya) * escY) * 180) / Math.PI;
          meli.style.setProperty('--vr', `${Math.max(-15, Math.min(15, grados * 0.4))}deg`);
        }
      };

      const pedir = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(mover);
      };
      window.addEventListener('scroll', pedir, { passive: true });
      window.addEventListener('resize', pedir);
      /* Nach dem Nachladen der Illustrationen sitzt alles woanders. */
      window.addEventListener('load', pedir);
      mover();
    }

    /* ---------- Sammelheft ---------- */

    const carnet = reader.querySelector<HTMLElement>('[data-carnet]')!;
    const carnetTelon = reader.querySelector<HTMLElement>('[data-telon-carnet]')!;
    const carnetAbre = reader.querySelector<HTMLElement>('[data-carnet-abre]')!;
    const carnetN = reader.querySelector<HTMLElement>('[data-carnet-n]')!;
    const carnetRelleno = reader.querySelector<SVGPathElement>('.carnet-relleno')!;
    const vacio = reader.querySelector<HTMLElement>('[data-carnet-vacio]')!;
    const grupoCartas = reader.querySelector<HTMLElement>('[data-grupo-cartas]')!;
    const grupoJuegos = reader.querySelector<HTMLElement>('[data-grupo-juegos]')!;
    const listaCartas = reader.querySelector<HTMLElement>('[data-lista-cartas]')!;
    const listaJuegos = reader.querySelector<HTMLElement>('[data-lista-juegos]')!;
    const cuentaCartas = reader.querySelector<HTMLElement>('[data-cuenta-cartas]')!;
    const cuentaJuegos = reader.querySelector<HTMLElement>('[data-cuenta-juegos]')!;
    const finCarnet = reader.querySelector<HTMLElement>('[data-fin-carnet]')!;

    const hallazgos = new Map<string, { texto: string; tipo: string }>();

    const cuenta = (a: number, b: number) =>
      String(ui.carnetCount ?? '{a}/{b}').replace('{a}', String(a)).replace('{b}', String(b));

    const escapar = (s: string) =>
      s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c] ?? c);

    const pintarCarnet = () => {
      const cartas = [...hallazgos.values()].filter((h) => h.tipo === 'carta');
      const juegos = [...hallazgos.values()].filter((h) => h.tipo === 'juego');
      const total = hallazgos.size;
      const maximo = (ui.totalCards ?? 0) + (ui.totalJuegos ?? 0);

      carnetN.textContent = String(total);
      carnetRelleno.style.clipPath = `inset(${Math.max(
        0,
        100 - (total / Math.max(1, maximo)) * 100
      )}% 0 0 0)`;
      carnetAbre.classList.remove('is-nuevo');
      void carnetAbre.offsetWidth;
      if (total) carnetAbre.classList.add('is-nuevo');

      vacio.hidden = total > 0;
      grupoCartas.hidden = cartas.length === 0;
      grupoJuegos.hidden = juegos.length === 0;
      cuentaCartas.textContent = cuenta(cartas.length, ui.totalCards ?? 0);
      cuentaJuegos.textContent = cuenta(juegos.length, ui.totalJuegos ?? 0);

      const fila = (t: string) =>
        `<li><span aria-hidden="true">✦</span><span><b>${escapar(t)}</b></span></li>`;
      listaCartas.innerHTML = cartas.map((c) => fila(c.texto)).join('');
      listaJuegos.innerHTML = juegos.map((c) => fila(c.texto)).join('');

      finCarnet.innerHTML = total ? `<p class="fin-marca">${cuenta(total, maximo)}</p>` : '';
    };

    document.addEventListener('libro:logro', (e) => {
      const d = (e as CustomEvent<LogroDetalle>).detail;
      if (!d?.id || hallazgos.has(d.id)) return;
      hallazgos.set(d.id, { texto: d.texto, tipo: d.tipo });
      if (paginaActual) plenas.add(paginaActual);
      pintarPanal();
      pintarCarnet();
    });

    const abrirCarnet = (v: boolean) => {
      carnet.hidden = !v;
      carnetTelon.hidden = !v;
      if (v) carnet.querySelector<HTMLElement>('[data-carnet-cerrar]')?.focus();
      else carnetAbre.focus();
    };
    carnetAbre.addEventListener('click', () => abrirCarnet(true));
    carnetTelon.addEventListener('click', () => abrirCarnet(false));
    reader
      .querySelector('[data-carnet-cerrar]')
      ?.addEventListener('click', () => abrirCarnet(false));
    pintarCarnet();

    /* ---------- Wissenslicht → Melis Karte ---------- */

    const nota = reader.querySelector<HTMLElement>('[data-nota]')!;
    const telon = reader.querySelector<HTMLElement>('[data-telon]')!;
    let ultima: HTMLElement | null = null;

    const cerrarNota = () => {
      nota.hidden = true;
      telon.hidden = true;
      ultima?.focus({ preventScroll: true });
      ultima = null;
    };

    reader.querySelectorAll<HTMLElement>('[data-carta]').forEach((luz) => {
      luz.addEventListener('click', () => {
        const [pn, ci] = (luz.dataset.carta ?? '').split('-').map(Number);
        const carta = paginas.find((p) => p.n === pn)?.cards[ci];
        if (!carta) return;

        nota.querySelector<HTMLElement>('[data-nota-titulo]')!.textContent = carta.title;
        nota.querySelector<HTMLElement>('[data-nota-texto]')!.textContent = carta.text;
        const ch = nota.querySelector<HTMLElement>('[data-nota-chacra]')!;
        if (carta.chacra) {
          nota.querySelector<HTMLElement>('[data-nota-chacra-texto]')!.textContent = carta.chacra;
          ch.hidden = false;
        } else {
          ch.hidden = true;
        }

        luz.classList.add('is-visto');
        luz.setAttribute('aria-label', `${carta.title} · ${ui.found ?? ''}`);
        ultima = luz;
        nota.hidden = false;
        telon.hidden = false;
        nota.querySelector<HTMLElement>('[data-nota-cerrar]')?.focus();

        document.dispatchEvent(
          new CustomEvent('libro:logro', {
            detail: { id: `carta-${pn}-${ci}`, texto: carta.title, tipo: 'carta' },
          })
        );
      });
    });

    reader.querySelector('[data-nota-cerrar]')?.addEventListener('click', cerrarNota);
    telon.addEventListener('click', cerrarNota);

    /* ---------- Nahseh-Modus ---------- */

    const visor = reader.querySelector<HTMLElement>('[data-visor]')!;
    const lienzo = reader.querySelector<HTMLElement>('[data-visor-lienzo]')!;
    let volverA: HTMLElement | null = null;

    const cerrarVisor = () => {
      visor.hidden = true;
      lienzo.innerHTML = '';
      document.body.style.overflow = '';
      volverA?.focus({ preventScroll: true });
      volverA = null;
    };

    reader.querySelectorAll<HTMLElement>('[data-lupa]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.closest('.lamina-marco')?.querySelector('img');
        if (!img) return;
        const copia = img.cloneNode(true) as HTMLImageElement;
        copia.removeAttribute('class');
        copia.removeAttribute('sizes');
        copia.removeAttribute('loading');
        copia.style.filter = 'none';
        lienzo.innerHTML = '';
        lienzo.appendChild(copia);
        visor.hidden = false;
        document.body.style.overflow = 'hidden';
        volverA = btn;
        // In die Mitte des vergrößerten Blattes springen.
        requestAnimationFrame(() => {
          lienzo.scrollLeft = (lienzo.scrollWidth - lienzo.clientWidth) / 2;
        });
        reader.querySelector<HTMLElement>('[data-visor-cerrar]')?.focus();
      });
    });

    reader.querySelector('[data-visor-cerrar]')?.addEventListener('click', cerrarVisor);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!visor.hidden) cerrarVisor();
      else if (!nota.hidden) cerrarNota();
      else if (!carnet.hidden) abrirCarnet(false);
    });

    /* ---------- Vorlesen ---------- */

    const lector = crearLector();
    if (lector) {
      const botones = [...reader.querySelectorAll<HTMLButtonElement>('[data-leer]')];
      let activo: HTMLButtonElement | null = null;

      const parar = () => {
        lector.parar();
        if (activo) {
          activo.classList.remove('is-on');
          activo.querySelector<HTMLElement>('[data-leer-label]')!.textContent = ui.read;
          const relato = activo.closest('.acto')?.querySelector<HTMLElement>('[data-relato]');
          const pagina = paginas.find((p) => p.n === Number(activo!.dataset.leer));
          if (relato && pagina) relato.textContent = pagina.voz;
          activo = null;
        }
      };

      botones.forEach((btn) => {
        btn.hidden = false;
        const relato = btn.closest('.acto')?.querySelector<HTMLElement>('[data-relato]');

        btn.addEventListener('click', () => {
          const eraYo = activo === btn;
          parar();
          if (eraYo) return;

          const pagina = paginas.find((p) => p.n === Number(btn.dataset.leer));
          if (!pagina) return;

          activo = btn;
          btn.classList.add('is-on');
          btn.querySelector<HTMLElement>('[data-leer-label]')!.textContent = ui.readStop;

          // Mitlesen im Buchtext selbst: der laufende Satz bleibt stehen,
          // das gesprochene Wort wird hervorgehoben.
          let frase = '';
          let antes = '';
          let despues = '';
          lector.hablar(pagina.n, pagina.voz, {
            onSentence: (_i, texto) => {
              frase = texto;
              const k = pagina.voz.indexOf(texto);
              antes = k >= 0 ? pagina.voz.slice(0, k) : '';
              despues = k >= 0 ? pagina.voz.slice(k + texto.length) : '';
              if (relato) relato.textContent = pagina.voz;
            },
            onWord: (charIndex, length) => {
              if (!relato || !frase) return;
              const fin = length ? charIndex + length : frase.indexOf(' ', charIndex);
              const corte = fin > charIndex ? fin : frase.length;
              relato.innerHTML =
                escapar(antes) +
                escapar(frase.slice(0, charIndex)) +
                '<mark>' +
                escapar(frase.slice(charIndex, corte)) +
                '</mark>' +
                escapar(frase.slice(corte)) +
                escapar(despues);
            },
            onEnd: parar,
          });
        });
      });

      window.addEventListener('beforeunload', () => lector.parar());
      window.addEventListener('pagehide', () => lector.parar());

      /* Stimmenauswahl — nur nötig, solange keine echten Aufnahmen da sind. */
      lector.listo(() => {
        const voces = lector.voces();
        if (voces.length < 2 || lector.grabado()) return;

        reader.querySelectorAll<HTMLElement>('[data-voz-abre]').forEach((abre) => {
          abre.hidden = false;
          const lista = abre.parentElement!.querySelector<HTMLElement>('[data-voz-lista]')!;

          voces.slice(0, 8).forEach((v) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.textContent = `${v.name.replace(/^Microsoft\s+/, '')} · ${v.lang}`;
            b.setAttribute('aria-pressed', String(v.voiceURI === lector.vozActual()?.voiceURI));
            b.addEventListener('click', () => {
              lector.elegirVoz(v.voiceURI);
              const elegido = b.textContent;
              reader
                .querySelectorAll<HTMLElement>('[data-voz-lista] button')
                .forEach((o) => o.setAttribute('aria-pressed', String(o.textContent === elegido)));
              lista.hidden = true;
              abre.setAttribute('aria-expanded', 'false');
              parar();
            });
            lista.appendChild(b);
          });

          abre.addEventListener('click', () => {
            const abierto = abre.getAttribute('aria-expanded') === 'true';
            reader.querySelectorAll<HTMLElement>('[data-voz-lista]').forEach((l) => (l.hidden = true));
            reader
              .querySelectorAll<HTMLElement>('[data-voz-abre]')
              .forEach((a) => a.setAttribute('aria-expanded', 'false'));
            if (!abierto) {
              lista.hidden = false;
              abre.setAttribute('aria-expanded', 'true');
            }
          });
        });

        document.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.voz-menu')) return;
          reader.querySelectorAll<HTMLElement>('[data-voz-lista]').forEach((l) => (l.hidden = true));
          reader
            .querySelectorAll<HTMLElement>('[data-voz-abre]')
            .forEach((a) => a.setAttribute('aria-expanded', 'false'));
        });
      });
    }
  }
</script>

<style>
  .reader {
    position: relative;
    background: var(--zona-fondo);
    transition: background 1400ms var(--ease-out);
  }

  /* ---------- Abschluss ---------- */

  .acto--fin {
    position: relative;
    z-index: 92;
    background: linear-gradient(180deg, rgba(78, 42, 5, 0.92), var(--papel) 58%);
  }

  .fin-inner {
    width: min(100%, 64rem);
    display: grid;
    gap: var(--sp-4);
    justify-items: center;
    text-align: center;
    padding-block: var(--sp-7);
  }

  .fin-inner h2 {
    color: var(--miel-100);
  }

  .fin-lead {
    color: var(--miel-200);
    max-width: 34rem;
  }

  .fin-carnet :global(.fin-marca) {
    display: inline-block;
    font-weight: 700;
    font-size: var(--fs-300);
    color: var(--miel-800);
    background: var(--miel-100);
    border-radius: 999px;
    padding: 0.3em 1.1em;
  }

  .fin-caminos {
    display: grid;
    gap: var(--sp-4);
    width: 100%;
    margin-top: var(--sp-5);
  }

  @media (min-width: 800px) {
    .fin-caminos {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .fin-camino {
    background: #fffdf8;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lift);
    padding: var(--sp-5);
    display: grid;
    gap: var(--sp-2);
    justify-items: center;
    align-content: start;
  }

  .fin-camino p {
    font-size: var(--fs-300);
    color: var(--c-text-soft);
  }

  .fin-derechos {
    margin-top: var(--sp-5);
    font-size: var(--fs-200);
    color: var(--tinta-tenue);
    max-width: 34rem;
  }

  .fin-casa {
    font-weight: 600;
    font-size: var(--fs-300);
  }
</style>

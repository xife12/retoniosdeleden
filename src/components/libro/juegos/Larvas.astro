---
/**
 * Seite 7 — „La comida decide quién sos"
 *
 * Vier Larven liegen in der Wabe, eine davon in einer Königinnenzelle. Das
 * Kind wählt ein Futter und verteilt es. Gelée royale macht Königinnen —
 * auch in einer ganz normalen Zelle. Genau diese „Fehlbedienung" ist
 * erlaubt, sie ist komisch, und sie ist das, was hängen bleibt.
 *
 * Gegenüber der ersten Fassung: die Wabe steht jetzt groß auf eigener Bühne
 * statt klein im Buchbild, und über allem steht die Reihenfolge — vorher war
 * nicht zu erkennen, ob man zuerst das Futter oder zuerst eine Zelle
 * antippen muss.
 */
import BeeMeli from '../../BeeMeli.astro';
import { libroUI } from '../../../data/libro';
import type { Lang } from '../../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const j = libroUI[lang].juegos.larvas;

/* Vier Zellen auf der Wabe (Raster 300 x 210). */
const celdas = [
  { x: 74, y: 78, real: false },
  { x: 150, y: 78, real: false },
  { x: 226, y: 78, real: false },
  { x: 150, y: 158, real: true },
];

function hex(cx: number, cy: number, r: number) {
  return Array.from({ length: 6 }, (_, i) => {
    const a = ((60 * i - 90) * Math.PI) / 180;
    return `${(cx + Math.cos(a) * r).toFixed(1)} ${(cy + Math.sin(a) * r).toFixed(1)}`;
  }).join(' L ');
}
---

<div
  class="escena"
  data-lar-escena
  data-textos={JSON.stringify({
    reina: j.reina,
    obrera: j.obrera,
    msgReina: j.msgReina,
    msgObrera: j.msgObrera,
    msgCeldaPan: j.msgCeldaPan,
    dosReinas: j.dosReinas,
    done: j.done,
    fact: j.fact,
    logro: j.logro,
  })}
>
  <h3 class="escena-titulo">{j.title}</h3>
  <p class="escena-pista">{j.hint}</p>

  <!-- Die Reihenfolge steht sichtbar da, statt geraten zu werden -->
  <ol class="pasos" data-lar-pasos>
    <li class="is-ahora" data-paso="1"><b>1</b>{j.step1}</li>
    <li data-paso="2"><b>2</b>{j.step2}</li>
  </ol>

  <div class="lar-comidas" role="group" aria-label={j.step1}>
    <button class="lar-comida" data-lar-comida="jalea" aria-pressed="false">
      <span class="lar-cuchara" aria-hidden="true">
        <svg viewBox="0 0 60 40">
          <path d="M40 22 C 52 20, 58 24, 58 26" stroke="#a06a2c" stroke-width="3.4"
            stroke-linecap="round" fill="none" filter="url(#ink)" />
          <ellipse cx="26" cy="22" rx="17" ry="11" fill="#fffdf8" stroke="#c9a86a"
            stroke-width="1.6" filter="url(#wc-rough)" />
          <ellipse cx="24" cy="20" rx="12" ry="7" fill="#f7f3e6" filter="url(#wc-soft)" />
          <g fill="#fff" opacity="0.9">
            <circle cx="19" cy="18" r="2" /><circle cx="28" cy="16" r="1.4" />
          </g>
        </svg>
      </span>
      <b>{j.jalea}</b>
    </button>

    <button class="lar-comida" data-lar-comida="pan" aria-pressed="false">
      <span class="lar-cuchara" aria-hidden="true">
        <svg viewBox="0 0 60 40">
          <path d="M40 22 C 52 20, 58 24, 58 26" stroke="#a06a2c" stroke-width="3.4"
            stroke-linecap="round" fill="none" filter="url(#ink)" />
          <ellipse cx="26" cy="22" rx="17" ry="11" fill="#e0c9a4" stroke="#a06a2c"
            stroke-width="1.6" filter="url(#wc-rough)" />
          <ellipse cx="24" cy="20" rx="12" ry="7" fill="#c9922f" filter="url(#wc-soft)" />
          <g fill="#8a5a22" opacity="0.7">
            <circle cx="20" cy="19" r="1.6" /><circle cx="27" cy="21" r="1.3" />
            <circle cx="24" cy="16" r="1.1" />
          </g>
        </svg>
      </span>
      <b>{j.pan}</b>
    </button>
  </div>

  <div class="mesa lar-mesa" data-lar-mesa>
    <svg viewBox="0 0 300 210">
      <!-- Wabenfeld -->
      <path d="M14 18 C 90 8, 210 8, 288 18 C 296 76, 294 140, 286 198 C 200 208, 96 208, 16 198 C 8 140, 6 76, 14 18 Z"
        fill="#f0cf8a" filter="url(#wc-soft)" />
      <g fill="none" stroke="#c9922f" stroke-width="1.6" opacity="0.5">
        {Array.from({ length: 18 }, (_, i) => {
          const col = i % 6;
          const fila = Math.floor(i / 6);
          const cx = 40 + col * 44 + (fila % 2 ? 22 : 0);
          const cy = 34 + fila * 62;
          return <path d={`M${hex(cx, cy, 24)} Z`} />;
        })}
      </g>

      {celdas.map((c, i) => (
        <g class="lar-celda" data-lar-celda={i} data-real={String(c.real)}>
          {c.real ? (
            <path
              d={`M${c.x - 22} ${c.y - 34} C ${c.x - 25} ${c.y + 4}, ${c.x - 15} ${c.y + 28}, ${c.x} ${c.y + 42} C ${c.x + 15} ${c.y + 28}, ${c.x + 25} ${c.y + 4}, ${c.x + 22} ${c.y - 34} Z`}
              fill="#f6dfa8"
              stroke="#8a5a22"
              stroke-width="2.4"
            />
          ) : (
            <path d={`M${hex(c.x, c.y, 26)} Z`} fill="#f9ecc8" stroke="#8a5a22" stroke-width="2.4" />
          )}

          <!-- Larve -->
          <g class="lar-cria">
            <path
              d={`M${c.x - 11} ${c.y + 6} C ${c.x - 13} ${c.y - 7}, ${c.x - 2} ${c.y - 13}, ${c.x + 5} ${c.y - 7} C ${c.x + 12} ${c.y - 1}, ${c.x + 9} ${c.y + 9}, ${c.x - 2} ${c.y + 9} Z`}
              fill="#fdf6e6"
              stroke="#c9a86a"
              stroke-width="1.6"
            />
            <circle cx={c.x + 6} cy={c.y - 6} r="1.6" fill="#8a7b68" />
          </g>

          <!-- Ergebnis -->
          <g class="lar-adulta">
            <ellipse cx={c.x} cy={c.y + 2} rx="17" ry="12" fill="#e8b23d" />
            <path
              d={`M${c.x - 8} ${c.y - 8} L ${c.x - 6} ${c.y + 12} M ${c.x + 2} ${c.y - 9} L ${c.x + 4} ${c.y + 12}`}
              stroke="#4a3308"
              stroke-width="4"
            />
            <ellipse cx={c.x - 2} cy={c.y - 11} rx="14" ry="5" fill="#eef5f8" opacity="0.85" />
            <circle cx={c.x + 16} cy={c.y - 2} r="6.6" fill="#8a5a22" />
            <circle cx={c.x + 18} cy={c.y - 4} r="1.8" fill="#2a1704" />
            <g class="lar-corona">
              <path
                d={`M${c.x + 6} ${c.y - 14} L ${c.x + 8} ${c.y - 22} L ${c.x + 12} ${c.y - 17} L ${c.x + 16} ${c.y - 24} L ${c.x + 20} ${c.y - 17} L ${c.x + 24} ${c.y - 22} L ${c.x + 26} ${c.y - 14} Z`}
                fill="#f7d84e"
                stroke="#b3761c"
                stroke-width="1.4"
              />
            </g>
          </g>

          <text class="lar-nombre" x={c.x} y={c.y + (c.real ? 56 : 44)} text-anchor="middle"
            font-size="13" font-weight="700" fill="#fff6d8"></text>

          <path
            class="lar-toca"
            data-toca
            role="button"
            tabindex="0"
            aria-label={c.real ? j.larvaReal : `${j.larva} ${i + 1}`}
            d={`M${hex(c.x, c.y, 30)} Z`}
            fill="transparent"
          />
        </g>
      ))}
    </svg>
  </div>

  <div class="escena-mandos">
    <button class="boton boton--fantasma" data-lar-reset hidden>{j.again}</button>
  </div>

  <div class="dice">
    <span class="dice-meli" aria-hidden="true"><BeeMeli width="100%" /></span>
    <p class="dice-texto" data-lar-dice aria-live="polite"></p>
  </div>
</div>

<script>
  import { datos, decir, logro, tin } from '../../../scripts/juego';

  const escena = document.querySelector<HTMLElement>('[data-lar-escena]');

  if (escena) {
    const t = datos(escena, 'textos', {
      reina: '',
      obrera: '',
      msgReina: '',
      msgObrera: '',
      msgCeldaPan: '',
      dosReinas: '',
      done: '',
      fact: '',
      logro: '',
    });
    const mesa = escena.querySelector<HTMLElement>('[data-lar-mesa]')!;
    const comidas = [...escena.querySelectorAll<HTMLButtonElement>('[data-lar-comida]')];
    const pasos = [...escena.querySelectorAll<HTMLElement>('[data-paso]')];
    const reset = escena.querySelector<HTMLButtonElement>('[data-lar-reset]')!;
    const dice = escena.querySelector<HTMLElement>('[data-lar-dice]');
    const celdas = [...escena.querySelectorAll<SVGGElement>('[data-lar-celda]')];

    let elegida: 'jalea' | 'pan' | null = null;
    let servidas = 0;
    let reinas = 0;

    const marcar = () => {
      comidas.forEach((c) =>
        c.setAttribute('aria-pressed', String(c.dataset.larComida === elegida))
      );
      mesa.classList.toggle('is-cargado', Boolean(elegida));
      // Schritt 1 gilt als erledigt, sobald ein Futter gewählt ist.
      pasos[0]?.classList.toggle('is-hecho', Boolean(elegida));
      pasos[0]?.classList.toggle('is-ahora', !elegida);
      pasos[1]?.classList.toggle('is-ahora', Boolean(elegida));
    };

    comidas.forEach((c) => {
      c.addEventListener('click', () => {
        const v = c.dataset.larComida as 'jalea' | 'pan';
        elegida = elegida === v ? null : v;
        marcar();
      });
    });

    celdas.forEach((celda) => {
      const zona = celda.querySelector<SVGPathElement>('.lar-toca')!;
      zona.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          zona.dispatchEvent(new MouseEvent('click', { bubbles: true }));
        }
      });
      zona.addEventListener('click', () => {
        if (!elegida || celda.classList.contains('is-servida')) return;

        const real = celda.dataset.real === 'true';
        const esReina = elegida === 'jalea';
        celda.classList.add('is-servida', esReina ? 'is-reina' : 'is-obrera');
        celda.querySelector('.lar-nombre')!.textContent = esReina ? t.reina : t.obrera;
        servidas += 1;
        if (esReina) reinas += 1;
        tin(esReina ? 1.5 : 0.9);

        let frase = esReina ? t.msgReina : t.msgObrera;
        if (esReina && !real && reinas > 1) frase = t.dosReinas;
        if (!esReina && real) frase = t.msgCeldaPan;
        decir(dice, frase);

        reset.hidden = false;

        if (servidas === celdas.length) {
          window.setTimeout(() => decir(dice, `${t.done} ${t.fact}`), 1700);
          logro('larvas', t.logro);
        }
      });
    });

    reset.addEventListener('click', () => {
      servidas = 0;
      reinas = 0;
      elegida = null;
      marcar();
      reset.hidden = true;
      celdas.forEach((c) => {
        c.classList.remove('is-servida', 'is-reina', 'is-obrera');
        c.querySelector('.lar-nombre')!.textContent = '';
      });
      decir(dice, '');
    });

    marcar();
  }
</script>

<style>
  .lar-mesa {
    max-width: 30rem;
  }

  .lar-celda .lar-toca {
    cursor: default;
  }

  .lar-mesa.is-cargado .lar-celda:not(.is-servida) .lar-toca {
    cursor: pointer;
  }

  /* Erst wenn ein Futter gewählt ist, laden die Zellen zum Antippen ein. */
  .lar-mesa.is-cargado .lar-celda:not(.is-servida) {
    animation: lar-espera 1.7s ease-in-out infinite;
  }

  @keyframes lar-espera {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.68;
    }
  }

  .lar-adulta,
  .lar-corona {
    opacity: 0;
  }

  .lar-celda.is-servida .lar-cria {
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .lar-celda.is-servida .lar-adulta {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: lar-crece 640ms var(--ease-bounce) 220ms both;
  }

  .lar-celda.is-reina .lar-corona {
    opacity: 1;
    animation: lar-corona 700ms var(--ease-bounce) 640ms both;
  }

  @keyframes lar-crece {
    from {
      opacity: 0;
      scale: 0.35;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  @keyframes lar-corona {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .lar-nombre {
    paint-order: stroke;
    stroke: #4a3308;
    stroke-width: 3.4;
    stroke-linejoin: round;
  }

  /* Futterwahl */
  .lar-comidas {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  .lar-comida {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.4em 1em 0.4em 0.5em;
    border: 2px solid rgba(179, 118, 28, 0.3);
    border-radius: 999px 16px 999px 16px;
    background: rgba(255, 253, 248, 0.85);
    cursor: pointer;
    font-size: var(--fs-300);
    min-height: 48px;
    transition:
      border-color var(--dur-1) ease,
      background var(--dur-2) ease,
      transform var(--dur-1) var(--ease-out);
  }

  .lar-comida:active {
    transform: scale(0.97);
  }

  .lar-comida[aria-pressed='true'] {
    border-color: var(--miel-500);
    background: var(--miel-100);
    box-shadow: 0 0 0 3px rgba(232, 161, 61, 0.25);
  }

  .lar-cuchara {
    width: 48px;
    display: block;
  }

  .lar-cuchara svg {
    width: 100%;
    overflow: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .lar-mesa.is-cargado .lar-celda:not(.is-servida),
    .lar-celda.is-servida .lar-adulta,
    .lar-celda.is-reina .lar-corona {
      animation: none !important;
      opacity: 1;
    }
  }
</style>

---
import type { Dict } from '../i18n';
import BeeMeli from './BeeMeli.astro';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<section id="contacto" class="contact" data-chapter>
  <div class="wrap contact-grid">
    <div class="contact-info">
      <header data-reveal>
        <h2><span class="swash">{t.contact.title}</span></h2>
        <p class="lead">{t.contact.intro}</p>
      </header>

      <div class="info-block" data-reveal>
        <h4>{t.contact.whereTitle}</h4>
        <p>{t.contact.where}</p>
      </div>

      <div class="info-block" data-reveal>
        <h4>{t.contact.foundersTitle}</h4>
        <p>{t.contact.founders}</p>
      </div>

      <div class="contact-bee" data-reveal aria-hidden="true">
        <BeeMeli width="120px" class="bee-float" />
      </div>
    </div>

    <form class="card contact-form" data-contact-form data-reveal novalidate>
      <div class="field">
        <label for="ct-name">{t.contact.name}</label>
        <input id="ct-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="ct-email">{t.contact.email}</label>
        <input id="ct-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="ct-msg">{t.contact.message}</label>
        <textarea id="ct-msg" name="message" rows="5" required></textarea>
      </div>
      <button class="btn" type="submit">{t.contact.send}</button>

      <div class="form-success" data-contact-success hidden>
        <svg viewBox="0 0 60 60" width="54" aria-hidden="true">
          <circle cx="30" cy="30" r="26" fill="url(#pg-pistacho)" filter="url(#wc-rough)" />
          <path d="M18 30 L 27 39 L 43 22" stroke="#fffdf8" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" fill="none" filter="url(#ink)" />
        </svg>
        <h4>{t.contact.successTitle}</h4>
        <p>{t.contact.successText}</p>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]')!;
  const success = form.querySelector<HTMLElement>('[data-contact-success]')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    for (const el of form.querySelectorAll<HTMLElement>('.field, .btn')) {
      el.style.display = 'none';
    }
    success.hidden = false;
  });
</script>

<style>
  .contact {
    background: var(--lavanda-100);
  }

  .contact-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  .contact-info {
    display: grid;
    gap: var(--sp-5);
  }

  .info-block h4 {
    color: var(--lavanda-700);
    margin-bottom: var(--sp-1);
  }

  .contact-bee {
    justify-self: end;
  }

  .contact-form {
    display: grid;
    gap: var(--sp-4);
  }

  .contact-form .btn {
    justify-self: start;
  }

  .form-success {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--sp-2);
    padding: var(--sp-5);
  }

  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }
</style>

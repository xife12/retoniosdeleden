---
import type { Dict } from '../i18n';

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const l = t.lavanda;

// Aus der Lavendelernte entsteht beides — Seife UND Kerze —, aber es sind
// nicht zwei Wege: bis zur Destillation ist es einer. Der Brennkessel gibt
// dann zwei Dinge her, das ätherische Öl und das Hidrolat, und beide gehen
// in beide Äste. Deshalb steht hier ein Stamm (`tronco`) mit zwei Ästen
// (`ramas`) darunter und nicht zwei Reihen nebeneinander.
const tronco = l.process;
const ramas = l.processBranches;

// Eine einzige durchlaufende Nummer über alle Knoten hinweg hält Auswahl,
// `aria-controls` und Beschreibungszettel zusammen. Die ANGEZEIGTE Ziffer
// ist eine andere: beide Äste beginnen bei 4, weil sie nebeneinander laufen
// und nicht nacheinander.
const iRama = (r: number, j: number) =>
  tronco.length + ramas.slice(0, r).reduce((n, x) => n + x.steps.length, 0) + j;
const todos = [...tronco, ...ramas.flatMap((rama) => rama.steps)];
---

<section id="lavanda" class="lavanda" data-chapter data-meli-zone>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <h2><span class="swash">{l.title}</span></h2>
      <p class="lead">{l.intro}</p>
    </header>

    <div class="lav-stage">
      <!-- Duft-Interaktion -->
      <figure class="lav-rub" data-reveal>
        <div class="lav-plant" data-lav-rub>
          <span class="meli-perch lav-perch" data-meli-perch aria-hidden="true"></span>
          <svg viewBox="0 0 240 300" aria-hidden="true">
            <ellipse cx="120" cy="282" rx="80" ry="12" fill="#675a96" opacity="0.15" filter="url(#wc-wash)" />
            <g class="lav-sway">
              <g stroke="#5b6c42" stroke-width="4" stroke-linecap="round" filter="url(#ink)" fill="none">
                <path d="M120 278 C 122 220, 118 170, 120 118" />
                <path d="M84 278 C 82 232, 88 196, 92 150" />
                <path d="M158 278 C 162 234, 156 198, 152 154" />
                <path d="M56 278 C 52 244, 58 218, 62 186" />
                <path d="M186 278 C 192 248, 186 222, 182 192" />
              </g>
              <g filter="url(#wc-rough)">
                <ellipse cx="120" cy="98" rx="14" ry="34" fill="url(#pg-lavanda)" />
                <ellipse cx="93" cy="132" rx="11" ry="27" fill="url(#pg-lavanda)" opacity="0.9" />
                <ellipse cx="151" cy="136" rx="11" ry="27" fill="url(#pg-lavanda)" opacity="0.9" />
                <ellipse cx="63" cy="170" rx="9" ry="22" fill="url(#pg-lavanda)" opacity="0.8" />
                <ellipse cx="181" cy="176" rx="9" ry="22" fill="url(#pg-lavanda)" opacity="0.8" />
              </g>
              <g stroke="#5b6c42" stroke-width="2.6" stroke-linecap="round" filter="url(#ink)" opacity="0.8">
                <path d="M104 220 C 96 214, 90 208, 88 200 M 136 216 C 144 210, 150 204, 152 196" fill="none" />
              </g>
            </g>
          </svg>
        </div>
        <figcaption>{l.rubHint}</figcaption>
      </figure>

      <!-- Warum zwischen den Pistazien -->
      <div class="lav-why" data-reveal>
        <h3>{l.whyTitle}</h3>
        <ul>
          {l.why.map((w) => (
            <li>
              <strong>{w.t}</strong>
              <p>{w.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Prozess: von der Blüte zur Seife und zur Kerze -->
    <div class="lav-process" data-reveal>
      <h3>{l.processTitle}</h3>
      <p class="process-hint">{l.processHint}</p>

      {/* Der gemeinsame Stamm: Ernte, Destillation, und was der Kessel hergibt. */}
      <ol class="process-path" role="list" data-tronco={tronco.length}>
        {tronco.map((step, i) => (
          <li>
            <button
              class="process-node"
              data-process={i}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`process-desc-${i}`}
            >
              <span class="node-art" aria-hidden="true">
                <span class="node-num">{i + 1}</span>
                {i === 0 && (
                  <svg viewBox="0 0 60 60">
                    <ellipse cx="24" cy="20" rx="7" ry="14" fill="url(#pg-lavanda)" filter="url(#wc-rough)" />
                    <path d="M24 34 L 24 50" stroke="#5b6c42" stroke-width="3" stroke-linecap="round" filter="url(#ink)" />
                    <path d="M34 40 L 48 26 M 34 26 L 48 40" stroke="#8a7b68" stroke-width="3" stroke-linecap="round" filter="url(#ink)" />
                  </svg>
                )}
                {i === 1 && (
                  <svg viewBox="0 0 60 60">
                    <path d="M18 46 C 12 38, 12 26, 22 20 L 38 20 C 48 26, 48 38, 42 46 Z" fill="#c9b48c" filter="url(#wc-soft)" />
                    <path d="M26 16 C 26 10, 34 10, 34 16" stroke="#8a7b68" stroke-width="3" fill="none" filter="url(#ink)" />
                    <path d="M24 8 C 25 5, 27 4, 28 2 M 33 8 C 34 5, 36 4, 37 2" stroke="#a5c9dd" stroke-width="2.4" stroke-linecap="round" fill="none" filter="url(#ink)" />
                  </svg>
                )}
                {/* Zwei Tropfen, nicht einer: oben das Öl, daneben das Hidrolat.
                    Die Gabelung beginnt schon in diesem Bild. */}
                {i === 2 && (
                  <svg viewBox="0 0 60 60">
                    <path d="M22 8 C 29 19, 34 26, 34 33 C 34 40, 29 45, 22 45 C 15 45, 10 40, 10 33 C 10 26, 15 19, 22 8 Z"
                      fill="url(#pg-miel)" filter="url(#wc-soft)" opacity="0.9" />
                    <ellipse cx="19" cy="33" rx="3" ry="4.5" fill="#fdf3e0" opacity="0.7" />
                    <path d="M44 24 C 49 32, 52 37, 52 42 C 52 47, 48 51, 44 51 C 40 51, 36 47, 36 42 C 36 37, 39 32, 44 24 Z"
                      fill="url(#pg-lavanda)" filter="url(#wc-soft)" opacity="0.85" />
                  </svg>
                )}
              </span>
              <span class="node-title">{step.t}</span>
            </button>
          </li>
        ))}
      </ol>

      {/* Die Gabelung selbst: ein gestrichelter Faden, der herunterkommt und
          sich zu beiden Ästen teilt. Rein zeichnerisch, deshalb aria-hidden. */}
      <div class="process-fork" aria-hidden="true" data-fork data-activo="">
        <span class="fork-arm fork-arm-a"></span>
        <span class="fork-arm fork-arm-b"></span>
      </div>

      <div class="process-ramas">
        {ramas.map((rama, r) => (
          <div class="rama" data-rama-caja={r} data-activo="">
            <h4 class="rama-label">{rama.label}</h4>
            <ol class="rama-path" role="list">
              {rama.steps.map((step, j) => (
                <li>
                  <button
                    class="process-node"
                    data-process={iRama(r, j)}
                    data-rama={r}
                    data-paso={j}
                    aria-expanded="false"
                    aria-controls={`process-desc-${iRama(r, j)}`}
                  >
                    <span class="node-art" aria-hidden="true">
                      <span class="node-num">{tronco.length + 1 + j}</span>
                      {r === 0 && j === 0 && (
                        <svg viewBox="0 0 60 60">
                          <path d="M14 26 L 46 26 L 42 48 C 42 50, 40 52, 38 52 L 22 52 C 20 52, 18 50, 18 48 Z" fill="#c9b48c" filter="url(#wc-soft)" />
                          <path d="M10 31 C 5 31, 5 24, 12 25 M 50 31 C 55 31, 55 24, 48 25" stroke="#8a7b68" stroke-width="2.6" fill="none" stroke-linecap="round" filter="url(#ink)" />
                          <ellipse cx="30" cy="27" rx="14" ry="4.5" fill="url(#pg-lavanda)" opacity="0.6" filter="url(#wc-rough)" />
                          <path d="M22 18 C 23 14, 26 13, 27 10 M 34 18 C 35 14, 38 13, 39 10" stroke="#a5c9dd" stroke-width="2.2" stroke-linecap="round" fill="none" filter="url(#ink)" />
                        </svg>
                      )}
                      {r === 0 && j === 1 && (
                        <svg viewBox="0 0 60 60">
                          <rect x="10" y="20" width="40" height="26" rx="8" fill="#f1eef8" filter="url(#wc-soft)" />
                          <rect x="10" y="20" width="40" height="26" rx="8" fill="none" stroke="#33291f" stroke-width="2" opacity="0.5" filter="url(#ink)" />
                          <ellipse cx="30" cy="33" rx="10" ry="5" fill="url(#pg-lavanda)" opacity="0.5" filter="url(#wc-rough)" />
                          <circle cx="46" cy="16" r="2.4" fill="#c3b9e0" />
                          <circle cx="52" cy="22" r="1.8" fill="#c3b9e0" />
                        </svg>
                      )}
                      {/* Wabe statt Wachsblock: das Wachs kommt aus den eigenen
                          Bienenstöcken, und das soll man dem Bild ansehen. */}
                      {r === 1 && j === 0 && (
                        <svg viewBox="0 0 60 60">
                          <g filter="url(#wc-rough)">
                            <path d="M30 10 L 41 16 L 41 28 L 30 34 L 19 28 L 19 16 Z" fill="url(#pg-miel)" opacity="0.95" />
                            <path d="M18 31 L 27 36 L 27 47 L 18 52 L 9 47 L 9 36 Z" fill="url(#pg-miel)" opacity="0.8" />
                            <path d="M42 31 L 51 36 L 51 47 L 42 52 L 33 47 L 33 36 Z" fill="url(#pg-miel)" opacity="0.8" />
                          </g>
                          <path d="M30 10 L 41 16 L 41 28 L 30 34 L 19 28 L 19 16 Z" fill="none" stroke="#b3761c" stroke-width="2" opacity="0.55" filter="url(#ink)" />
                        </svg>
                      )}
                      {r === 1 && j === 1 && (
                        <svg viewBox="0 0 60 60">
                          <rect x="21" y="24" width="18" height="28" rx="4" fill="#f1eef8" filter="url(#wc-soft)" />
                          <rect x="21" y="24" width="18" height="28" rx="4" fill="none" stroke="#33291f" stroke-width="2" opacity="0.45" filter="url(#ink)" />
                          <ellipse cx="27" cy="38" rx="4" ry="6" fill="url(#pg-lavanda)" opacity="0.55" filter="url(#wc-rough)" />
                          <path d="M30 24 L 30 18" stroke="#5c4f40" stroke-width="2.4" stroke-linecap="round" filter="url(#ink)" />
                          <path d="M30 6 C 35 12, 36 16, 30 18 C 24 16, 25 12, 30 6 Z" fill="url(#pg-sol)" filter="url(#wc-soft)" />
                        </svg>
                      )}
                    </span>
                    <span class="node-title">{step.t}</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      {/* Ein einziger Zettel für den ganzen Baum. Unter einer Gabelung wäre
          eine Notiz pro Spalte am Handy keine 130 px breit; hier steht sie
          immer an derselben Stelle und über die volle Breite. Damit klar
          bleibt, wozu sie gehört, nennt sie den Namen der Station. */}
      <div class="process-note">
        {todos.map((step, k) => (
          <p class="node-desc" id={`process-desc-${k}`} hidden={k !== 0}>
            <strong class="node-desc-t">{step.t}</strong>
            <span>{step.d}</span>
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.getElementById('lavanda')!;

  // Duft-Partikel beim Streichen über die Lavendel
  const rub = section.querySelector<HTMLElement>('[data-lav-rub]');
  if (rub) {
    let last = 0;
    const scent = (x: number, y: number) => {
      const now = performance.now();
      if (now - last < 90) return;
      last = now;
      rub.classList.add('is-swaying');
      clearTimeout((rub as any)._swayT);
      (rub as any)._swayT = setTimeout(() => rub.classList.remove('is-swaying'), 600);

      const dot = document.createElement('i');
      const size = 5 + Math.random() * 7;
      const drift = (Math.random() - 0.5) * 60;
      dot.className = 'scent';
      dot.style.cssText = `left:${x}px; top:${y}px; width:${size}px; height:${size}px; --drift:${drift}px;`;
      rub.appendChild(dot);
      setTimeout(() => dot.remove(), 1300);
    };
    rub.addEventListener('pointermove', (e) => {
      const r = rub.getBoundingClientRect();
      scent(e.clientX - r.left, e.clientY - r.top);
    });
  }

  // Prozess-Schritte
  const tronco = section.querySelector<HTMLElement>('[data-tronco]');
  const fork = section.querySelector<HTMLElement>('[data-fork]');
  const cajas = Array.from(section.querySelectorAll<HTMLElement>('[data-rama-caja]'));
  const nodes = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-process]'));
  const descs = Array.from(section.querySelectorAll<HTMLElement>('.node-desc'));
  const largoTronco = Number(tronco?.dataset.tronco ?? nodes.length);

  // Wie weit auf dem Weg man ist: färbt den gestrichelten Faden bis zur
  // gewählten Station ein. Erst dadurch liest sich die Reihe als Ablauf
  // und nicht als Knöpfe nebeneinander. Steht man schon in einem Ast, ist
  // der Stamm ganz zurückgelegt — und die Gabelung zeigt, in welchen Ast.
  const avanzar = (i: number) => {
    const node = nodes[i];
    const rama = node?.dataset.rama;
    const paso = Number(node?.dataset.paso ?? i);
    const enTronco = rama === undefined;

    tronco?.style.setProperty(
      '--avance',
      enTronco ? String(largoTronco > 1 ? paso / (largoTronco - 1) : 1) : '1',
    );
    if (fork) fork.dataset.activo = rama ?? '';
    cajas.forEach((caja, r) => {
      caja.dataset.activo = !enTronco && rama === String(r) ? String(paso) : '';
    });
  };

  nodes.forEach((node, i) => {
    node.addEventListener('click', () => {
      nodes.forEach((n, k) => n.setAttribute('aria-expanded', String(k === i)));
      descs.forEach((d, k) => (d.hidden = k !== i));
      avanzar(i);
    });
  });
  avanzar(0);
</script>

<style>
  .lavanda {
    background: var(--lavanda-100);
  }

  .lav-stage {
    display: grid;
    gap: var(--sp-6);
    align-items: center;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 780px) {
    .lav-stage {
      grid-template-columns: minmax(240px, 340px) 1fr;
      gap: var(--sp-8);
    }
  }

  .lav-rub {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--sp-2);
  }

  .lav-plant {
    position: relative;
    width: min(64vw, 280px);
    touch-action: pan-y;
    cursor: crosshair;
    overflow: visible;
  }

  .lav-perch {
    position: absolute;
    top: -6%;
    right: 6%;
    width: 40px;
    height: 30px;
  }

  .lav-sway {
    transform-origin: 50% 95%;
    transition: transform 500ms var(--ease-in-out);
  }

  .is-swaying .lav-sway {
    animation: lav-sway 700ms var(--ease-in-out);
  }

  @keyframes lav-sway {
    0%, 100% { transform: rotate(0deg); }
    30% { transform: rotate(2.4deg); }
    65% { transform: rotate(-1.8deg); }
  }

  .lav-plant :global(.scent) {
    position: absolute;
    border-radius: 45% 55% 50% 50% / 55% 45% 55% 45%;
    background: var(--lavanda-500);
    opacity: 0.75;
    pointer-events: none;
    animation: scent-rise 1.25s ease-out forwards;
  }

  @keyframes scent-rise {
    to {
      transform: translate(var(--drift), -90px) scale(0.5);
      opacity: 0;
    }
  }

  .lav-rub figcaption {
    font-style: italic;
    color: var(--lavanda-700);
    font-size: var(--fs-300);
    text-align: center;
  }

  .lav-why h3 {
    margin-bottom: var(--sp-4);
  }

  .lav-why ul {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .lav-why li {
    padding-block: var(--sp-4);
    border-top: 1.5px dashed var(--lavanda-300);
  }

  .lav-why li:first-child {
    border-top: none;
    padding-top: 0;
  }

  .lav-why p {
    color: var(--c-text-soft);
    font-size: var(--fs-300);
    margin-top: 2px;
  }

  /* ---------- Prozess ---------- */

  .lav-process {
    /* Eine Größe für alle Stationen — Stamm wie Äste teilen sie sich. */
    --node-icon: clamp(46px, 13.5vw, 64px);
    /* Der Abstand der beiden Äste steht hier, weil die Gabelung ihn zum
       Rechnen braucht: ihre Arme sollen auf den Astmitten stehen, und die
       hängen von dieser Lücke ab. */
    --rama-gap: var(--sp-3);
    background: #fffdf8;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-soft);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .process-hint {
    color: var(--tinta-tenue);
    font-size: var(--fs-300);
    font-style: italic;
    margin-top: var(--sp-1);
  }
  /* ---------- Der Weg: ein Stamm, zwei Äste ----------
     Bis zur Destillation ist es EIN Weg — drei Stationen quer nebeneinander
     auf einem gestrichelten Faden, der sich bis zur gewählten Station
     einfärbt. Erst danach teilt sich der Faden: links die Seife, rechts die
     Kerze.

     Die beiden Äste stehen auf JEDER Breite nebeneinander und laufen in
     sich nach unten. Untereinander gestapelt läsen sie sich als
     Fortsetzung des Wegs — und genau das sind sie nicht. Nebeneinander
     bleibt sichtbar, dass aus derselben Ernte zwei Dinge gleichzeitig
     entstehen. */
  .process-path {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: var(--sp-2);
    position: relative;
  }

  /* Der gestrichelte Faden auf Höhe der Icon-Mitte, von der ersten bis zur
     letzten Station — deshalb genau ein Sechstel Rand auf jeder Seite. */
  .process-path::before,
  .process-path::after {
    content: '';
    position: absolute;
    top: calc(var(--sp-2) + var(--node-icon) / 2 - 1.25px);
    left: 16.67%;
    right: 16.67%;
    border-top: 2.5px dashed var(--lavanda-300);
    z-index: 0;
  }

  /* … und darüber der bereits zurückgelegte Teil, durchgezogen. */
  .process-path::after {
    right: auto;
    width: calc(var(--avance, 0) * 66.66%);
    border-top-style: solid;
    border-top-color: var(--lavanda-500);
    transition: width var(--dur-3) var(--ease-out);
  }

  .process-node {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--sp-1);
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--sp-2) 0;
    text-align: center;
  }

  .node-art {
    position: relative;
    flex-shrink: 0;
    width: var(--node-icon);
    height: var(--node-icon);
    border-radius: var(--r-blob);
    background: var(--lavanda-100);
    display: grid;
    place-items: center;
    padding: 8px;
    transition: transform var(--dur-2) var(--ease-bounce), background var(--dur-1) ease, box-shadow var(--dur-2) ease;
  }

  /* Schrittnummer: zeigt Reihenfolge und Richtung, unabhängig vom
     Breakpoint. In beiden Ästen steht dieselbe 4 und dieselbe 5 — sie
     laufen nebeneinander, nicht nacheinander. */
  .node-num {
    position: absolute;
    top: -6px;
    left: -6px;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--lavanda-700);
    color: #fffdf8;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 0 0 2px #fffdf8;
    z-index: 2;
  }

  .process-path li:nth-child(odd) .node-num,
  .rama-path li:nth-child(odd) .node-num { transform: rotate(-8deg); }
  .process-path li:nth-child(even) .node-num,
  .rama-path li:nth-child(even) .node-num { transform: rotate(6deg); }

  .process-node[aria-expanded='true'] .node-art {
    background: #fff;
    box-shadow: 0 0 0 3px var(--lavanda-500), var(--shadow-soft);
    transform: scale(1.08) rotate(-3deg);
  }

  .process-node:active .node-art {
    transform: scale(0.95);
  }

  .node-title {
    font-weight: 700;
    font-size: var(--fs-300);
    line-height: 1.2;
    text-wrap: balance;
    hyphens: auto;
  }

  /* Auf sehr schmalen Geräten stehen drei bzw. zwei Namen nebeneinander;
     „Saponificación" ist ein Wort und kann kaum umbrechen. Eine Stufe
     kleiner, damit die Stationen nicht aneinanderstoßen. */
  @media (max-width: 26rem) {
    .node-title {
      font-size: var(--fs-200);
    }
  }

  .process-node[aria-expanded='true'] .node-title {
    color: var(--lavanda-700);
  }

  /* ---------- Die Gabelung ----------
     Gezeichnet aus denselben gestrichelten Linien wie der Faden oben: ein
     Strich herunter, ein Querbalken, zwei Arme in die Äste. Sobald man in
     einem Ast steht, ist der Weg dorthin zurückgelegt und wird
     durchgezogen — genau wie beim Stamm. */
  .process-fork {
    position: relative;
    height: 40px;
    margin-top: var(--sp-2);
  }

  .process-fork::before,
  .process-fork::after {
    content: '';
    position: absolute;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .process-fork::before {
    left: 50%;
    top: 0;
    height: 18px;
    border-left: 2.5px dashed var(--lavanda-300);
  }

  /* Querbalken und Arme enden auf den Mitten der beiden Äste. Bei zwei
     gleichen Spalten liegt die erste Mitte ein Viertel der Breite ohne
     Lücke vom Rand entfernt — nicht bei glatten 25 %, sonst zeigt der Arm
     am Schreibtisch um die halbe Lücke daneben. */
  .process-fork::after {
    top: 18px;
    left: calc((100% - var(--rama-gap)) / 4);
    right: calc((100% - var(--rama-gap)) / 4);
    border-top: 2.5px dashed var(--lavanda-300);
  }

  .fork-arm {
    position: absolute;
    top: 18px;
    bottom: 0;
    border-left: 2.5px dashed var(--lavanda-300);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .fork-arm-a { left: calc((100% - var(--rama-gap)) / 4); }
  .fork-arm-b { left: calc(100% - (100% - var(--rama-gap)) / 4); }

  .process-fork:not([data-activo=''])::before,
  .process-fork:not([data-activo=''])::after {
    border-style: solid;
    border-color: var(--lavanda-500);
  }

  .process-fork[data-activo='0'] .fork-arm-a,

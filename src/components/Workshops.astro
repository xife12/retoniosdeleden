---
import type { Dict, Lang } from '../i18n';
import {
  workshopDetailUI,
  formatDate,
  formatPrice,
  currencyPrefix,
  type ThemeAccent,
} from '../data/workshops';
import { workshopThemes } from '../data/workshop-themes';
import { fetchWorkshops } from '../lib/fetch-workshops';

interface Props {
  t: Dict;
  lang: Lang;
}

const { t, lang } = Astro.props;
const b = t.workshops.booking;
const ui = workshopDetailUI[lang];

/**
 * Inhalte kommen zur Bauzeit aus Supabase (View `workshops_public`).
 * Illustrationen und Akzentfarben bleiben im Code (workshop-themes.ts) --
 * im Backend wählt die Nutzerin nur den Themen-Schlüssel.
 */
const workshops = await fetchWorkshops();

const chipClass: Record<ThemeAccent, string> = {
  miel: 'chip--miel',
  lavanda: 'chip--lavanda',
  pistacho: '',
  barro: 'chip--barro',
  cielo: 'chip--cielo',
};

/** Termine als JSON für den Buchungsdialog (Karte und Detailansicht teilen sich das Format). */
const datesAttr = (dates: string[]) =>
  JSON.stringify(dates.map((d) => ({ iso: d, label: formatDate(d, lang) })));
---

<section id="talleres" class="workshops" data-chapter data-meli-zone>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{t.workshops.kicker}</p>
      <h2>
        <span class="swash">{t.workshops.title}</span>
        <span class="meli-perch" data-meli-perch aria-hidden="true"></span>
      </h2>
      <p class="lead">{t.workshops.intro}</p>
    </header>

    <div class="ws-grid">
      {workshops.map((w) => {
        const wt = w.text[lang];
        return (
          <article class={`card ws-card ws-card--${w.accent}`} data-reveal>
            <h3 class="ws-head">
              <button type="button" class="ws-head-btn" data-ws-detail={w.id} aria-haspopup="dialog">
                <span class="ws-icon" aria-hidden="true">
                  <svg viewBox="0 0 90 90" set:html={workshopThemes[w.themeId].cardIcon} />
                </span>

                <span class="ws-head-text">
                  <span class="ws-name">{wt.title}</span>
                  <span class="ws-more">
                    {ui.more}
                    <svg class="ws-arrow" viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M2 6 H 10 M 6.4 2.6 L 10 6 L 6.4 9.4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#ink)" />
                    </svg>
                  </span>
                </span>
              </button>
            </h3>

            <div class="ws-body">
              <span class={`chip ${chipClass[w.accent]}`}>{wt.audience}</span>
              <p>{wt.desc}</p>

              <dl class="ws-meta">
                <div>
                  <dt>{t.workshops.duration}</dt>
                  <dd>{w.hours} {t.workshops.hours}</dd>
                </div>
                <div>
                  <dt>{t.workshops.group}</dt>
                  <dd>{w.maxPeople} {t.workshops.people}</dd>
                </div>
                <div>
                  <dt>{formatPrice(w.price, w.currency)}</dt>
                  <dd>{t.workshops.perPerson}</dd>
                </div>
              </dl>

              <p class="ws-dates">
                <strong>{t.workshops.nextDates}:</strong>{' '}
                {w.dates.map((d) => formatDate(d, lang)).join(', ')}
              </p>

              <button
                class="btn book-btn"
                data-ws-id={w.id}
                data-ws-title={wt.title}
                data-ws-price={w.price}
                data-ws-cur={currencyPrefix[w.currency]}
                data-ws-max={w.maxPeople}
                data-ws-dates={datesAttr(w.dates)}
              >
                {t.workshops.book}
              </button>
            </div>
          </article>
        );
      })}
    </div>

    <p class="demo-note" data-reveal>{t.workshops.demoNote}</p>
  </div>

  <!-- Detail-Dialog: alle Panels serverseitig gerendert, JS blendet nur um -->
  <div class="modal-backdrop" data-detail-backdrop hidden></div>
  <div
    class="modal modal--detail"
    data-detail-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby={`wd-title-${workshops[0].id}`}
    hidden
  >
    <button class="modal-close" data-detail-close aria-label={ui.close}>×</button>

    {workshops.map((w) => {
      const wt = w.text[lang];
      return (
        <article class={`wd wd--${w.accent}`} data-detail-panel={w.id} hidden>
          <div class="wd-hero" aria-hidden="true">
            <svg viewBox="0 0 320 150" set:html={workshopThemes[w.themeId].hero} />
          </div>

          <header class="wd-head">
            <span class={`chip ${chipClass[w.accent]}`}>{wt.audience}</span>
            <h3 id={`wd-title-${w.id}`}>{wt.title}</h3>
            <p class="wd-lead">{wt.longDesc}</p>
          </header>

          <h4 class="visually-hidden">{ui.atAGlance}</h4>
          <dl class="wd-glance">
            <div>
              <dt>{t.workshops.duration}</dt>
              <dd>{w.hours} {t.workshops.hours}</dd>
            </div>
            <div>
              <dt>{t.workshops.group}</dt>
              <dd>{w.maxPeople} {t.workshops.people}</dd>
            </div>
            <div>
              <dt>{formatPrice(w.price, w.currency)}</dt>
              <dd>{t.workshops.perPerson}</dd>
            </div>
          </dl>

          {w.show.programme && (
            <section class="wd-block">
              <h4>{ui.programme}</h4>
              <ol class="wd-steps">
                {wt.programme.map((s, i) => (
                  <li>
                    <span class="wd-step-n" aria-hidden="true">{i + 1}</span>
                    <div class="wd-step-body">
                      <strong>{s.title}</strong>
                      <p>{s.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {(w.show.included || w.show.bring) && (
            <div class="wd-cols">
              {w.show.included && (
                <section class="wd-block">
                  <h4>{ui.included}</h4>
                  <ul class="wd-list wd-list--yes">
                    {wt.included.map((x) => <li>{x}</li>)}
                  </ul>
                </section>
              )}
              {w.show.bring && (
                <section class="wd-block">
                  <h4>{ui.bring}</h4>
                  <ul class="wd-list wd-list--bring">
                    {wt.bring.map((x) => <li>{x}</li>)}
                  </ul>
                </section>
              )}
            </div>
          )}

          {(w.show.forWhom || w.show.languages || w.show.meetingPoint) && (
            <div class="wd-block">
              <dl class="wd-facts">
                {w.show.forWhom && (
                  <div>
                    <dt>{ui.forWhom}</dt>
                    <dd>{wt.forWhom}</dd>
                  </div>
                )}
                {w.show.languages && (
                  <div>
                    <dt>{ui.languages}</dt>
                    <dd>{wt.languages}</dd>
                  </div>
                )}
                {w.show.meetingPoint && (
                  <div>
                    <dt>{ui.meetingPoint}</dt>
                    <dd>{wt.meetingPoint}</dd>
                  </div>
                )}
              </dl>
            </div>
          )}

          <section class="wd-block">
            <h4>{t.workshops.nextDates}</h4>
            <ul class="wd-dates">
              {w.dates.map((d) => (
                <li class={`chip ${chipClass[w.accent]}`}>{formatDate(d, lang)}</li>
              ))}
            </ul>
          </section>

          <div class="wd-cta">
            <p class="wd-price">
              {formatPrice(w.price, w.currency)}
              <span>{t.workshops.perPerson}</span>
            </p>
            <button
              type="button"
              class="btn wd-book"
              data-detail-book
              data-ws-id={w.id}
              data-ws-title={wt.title}
              data-ws-price={w.price}
              data-ws-cur={currencyPrefix[w.currency]}
              data-ws-max={w.maxPeople}
              data-ws-dates={datesAttr(w.dates)}
            >
              {t.workshops.book}
            </button>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Buchungs-Dialog (Demo) -->
  <div class="modal-backdrop" data-booking-backdrop hidden></div>
  <div
    class="modal"
    data-booking-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="booking-title"
    hidden
  >
    <button class="modal-close" data-booking-close aria-label={b.close}>×</button>

    <h3 id="booking-title">
      {b.title}: <span data-bk-title></span>
    </h3>

    <ol class="steps" aria-hidden="true">
      {b.steps.map((s, i) => (
        <li class="step" data-step-dot={i + 1}>{s}</li>
      ))}
    </ol>

    <!-- Schritt 1: Fecha & Personen -->
    <form class="bk-panel" data-bk-step="1">
      <div class="field">
        <label for="bk-date">{b.date}</label>
        <select id="bk-date" required></select>
      </div>
      <div class="field">
        <label for="bk-people">{b.people}</label>
        <input id="bk-people" type="number" min="1" value="2" required inputmode="numeric" />
      </div>
      <div class="bk-actions">
        <button type="submit" class="btn">{b.next}</button>
      </div>
    </form>

    <!-- Schritt 2: Daten -->
    <form class="bk-panel" data-bk-step="2" hidden>
      <div class="field">
        <label for="bk-name">{b.name}</label>
        <input id="bk-name" type="text" required autocomplete="name" />
        <p class="err" data-err-name hidden>{b.errRequired}</p>
      </div>
      <div class="field">
        <label for="bk-email">{b.email}</label>
        <input id="bk-email" type="email" required autocomplete="email" />
        <p class="err" data-err-email hidden>{b.errEmail}</p>
      </div>
      <div class="bk-actions">
        <button type="button" class="btn btn--ghost" data-bk-back>{b.back}</button>
        <button type="submit" class="btn">{b.next}</button>
      </div>
    </form>

    <!-- Schritt 3: Zusammenfassung -->
    <div class="bk-panel" data-bk-step="3" hidden>
      <h4>{b.summary}</h4>
      <dl class="bk-summary">
        <div><dt>{b.date}</dt><dd data-sum-date></dd></div>
        <div><dt>{b.people}</dt><dd data-sum-people></dd></div>
        <div><dt>{b.name}</dt><dd data-sum-name></dd></div>
        <div><dt>{b.email}</dt><dd data-sum-email></dd></div>
        <div class="bk-total"><dt>{b.total}</dt><dd data-sum-total></dd></div>
      </dl>
      <div class="bk-actions">
        <button type="button" class="btn btn--ghost" data-bk-back>{b.back}</button>
        <button type="button" class="btn btn--secondary" data-bk-confirm>{b.confirm}</button>
      </div>
    </div>

    <!-- Erfolg -->
    <div class="bk-panel bk-success" data-bk-step="4" hidden>
      <div class="bk-party" aria-hidden="true"></div>
      <svg class="bk-bee" viewBox="0 0 90 90" aria-hidden="true">
        <ellipse cx="42" cy="52" rx="24" ry="17" fill="url(#pg-miel)" filter="url(#wc-rough)" />
        <path d="M32 36 L 34 68 M 46 34 L 48 70" stroke="#6b4a1f" stroke-width="6" filter="url(#wc-rough)" />
        <ellipse cx="36" cy="28" rx="17" ry="8" transform="rotate(-26 36 28)" fill="#d9eaf2" opacity="0.85" />
        <circle cx="66" cy="44" r="11" fill="#a06a2c" filter="url(#wc-rough)" />
        <circle cx="69" cy="42" r="2" fill="#33291f" />
        <path d="M64 50 C 67 53, 71 53, 74 50" stroke="#33291f" stroke-width="1.6" stroke-linecap="round" fill="none" />
      </svg>
      <h4>{b.successTitle}</h4>
      <p>{b.successText}</p>
      <button type="button" class="btn" data-booking-close>{b.close}</button>
    </div>
  </div>
</section>

<script>
  /* ---------------- gemeinsame Helfer ---------------- */

  const FOCUSABLE = 'button, input, select, textarea, [href], [tabindex]:not([tabindex="-1"])';

  function trapFocus(modal: HTMLElement) {
    modal.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(modal.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => !el.hasAttribute('hidden') && el.offsetParent !== null
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        last.focus();
        e.preventDefault();
      } else if (!e.shiftKey && document.activeElement === last) {
        first.focus();
        e.preventDefault();
      }
    });
  }

  /* ---------------- Detailansicht ---------------- */

  const detail = document.querySelector<HTMLElement>('[data-detail-modal]')!;
  const detailBackdrop = document.querySelector<HTMLElement>('[data-detail-backdrop]')!;
  const detailCloseBtn = detail.querySelector<HTMLElement>('[data-detail-close]')!;

  /** Karte, von der aus die Detailansicht geöffnet wurde. */
  let detailOrigin: HTMLElement | null = null;

  function openDetail(trigger: HTMLElement) {
    const id = trigger.dataset.wsDetail ?? '';
    detail.querySelectorAll<HTMLElement>('[data-detail-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.detailPanel !== id;
    });
    detail.setAttribute('aria-labelledby', `wd-title-${id}`);

    detailOrigin = trigger;
    detail.hidden = false;
    detailBackdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    detail.scrollTop = 0;
    detailCloseBtn.focus();
  }

  function closeDetail(restoreFocus = true) {
    detail.hidden = true;
    detailBackdrop.hidden = true;
    document.body.style.overflow = '';
    if (restoreFocus) {
      detailOrigin?.focus({ preventScroll: true });
      detailOrigin = null;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-ws-detail]').forEach((trigger) => {
    trigger.addEventListener('click', () => openDetail(trigger));
  });

  detailCloseBtn.addEventListener('click', () => closeDetail());
  detailBackdrop.addEventListener('click', () => closeDetail());
  trapFocus(detail);

  /* ---------------- Buchungsdialog ---------------- */

  const modal = document.querySelector<HTMLElement>('[data-booking-modal]')!;
  const backdrop = document.querySelector<HTMLElement>('[data-booking-backdrop]')!;
  const titleEl = modal.querySelector<HTMLElement>('[data-bk-title]')!;
  const dateSel = modal.querySelector<HTMLSelectElement>('#bk-date')!;
  const peopleInp = modal.querySelector<HTMLInputElement>('#bk-people')!;
  const nameInp = modal.querySelector<HTMLInputElement>('#bk-name')!;
  const emailInp = modal.querySelector<HTMLInputElement>('#bk-email')!;

  let price = 0;
  /** Währungszeichen des gerade gebuchten Workshops, kommt aus data-ws-cur. */
  let currency = 'US$';
  /** Element, das nach dem Schließen der Buchung den Fokus zurückbekommt. */
  let bookingReturn: HTMLElement | null = null;

  function showStep(n: number) {
    modal.querySelectorAll<HTMLElement>('[data-bk-step]').forEach((p) => {
      p.hidden = p.dataset.bkStep !== String(n);
    });
    modal.querySelectorAll<HTMLElement>('[data-step-dot]').forEach((d) => {
      const k = Number(d.dataset.stepDot);
      d.classList.toggle('is-done', k < n);
      d.classList.toggle('is-current', k === n);
    });
  }

  /** src trägt die data-ws-*-Attribute, returnTo bekommt danach den Fokus. */
  function open(src: HTMLElement, returnTo: HTMLElement | null) {
    bookingReturn = returnTo;
    titleEl.textContent = src.dataset.wsTitle ?? '';
    price = Number(src.dataset.wsPrice ?? 0);
    currency = src.dataset.wsCur ?? 'US$';
    peopleInp.max = src.dataset.wsMax ?? '12';
    peopleInp.value = '2';
    nameInp.value = '';
    emailInp.value = '';
    modal.querySelector<HTMLElement>('[data-err-name]')!.hidden = true;
    modal.querySelector<HTMLElement>('[data-err-email]')!.hidden = true;

    const dates: { iso: string; label: string }[] = JSON.parse(src.dataset.wsDates ?? '[]');
    dateSel.innerHTML = '';
    for (const d of dates) {
      const opt = document.createElement('option');
      opt.value = d.iso;
      opt.textContent = d.label;
      dateSel.append(opt);
    }

    showStep(1);
    modal.hidden = false;
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    modal.scrollTop = 0;
    dateSel.focus();
  }

  function close() {
    modal.hidden = true;
    backdrop.hidden = true;
    document.body.style.overflow = '';
    modal.querySelector('.bk-party')!.innerHTML = '';
    bookingReturn?.focus({ preventScroll: true });
    bookingReturn = null;
  }

  document.querySelectorAll<HTMLElement>('.book-btn').forEach((btn) => {
    btn.addEventListener('click', () => open(btn, btn));
  });

  /* Übergabe: Detail schließen, Buchung mit demselben Workshop öffnen. */
  detail.querySelectorAll<HTMLElement>('[data-detail-book]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const origin = detailOrigin;
      closeDetail(false);
      detailOrigin = null;
      open(btn, origin);
    });
  });

  modal.querySelectorAll('[data-booking-close]').forEach((el) => el.addEventListener('click', close));
  backdrop.addEventListener('click', close);
  trapFocus(modal);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!modal.hidden) close();
    else if (!detail.hidden) closeDetail();
  });

  // Schritt 1 → 2
  modal.querySelector<HTMLFormElement>('[data-bk-step="1"]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    showStep(2);
    nameInp.focus();
  });

  // Schritt 2 → 3 (mit Validierung)
  modal.querySelector<HTMLFormElement>('[data-bk-step="2"]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const errName = modal.querySelector<HTMLElement>('[data-err-name]')!;
    const errEmail = modal.querySelector<HTMLElement>('[data-err-email]')!;
    const nameOk = nameInp.value.trim().length > 1;
    const emailOk = /.+@.+\..+/.test(emailInp.value);
    errName.hidden = nameOk;
    errEmail.hidden = emailOk;
    if (!nameOk || !emailOk) return;

    const people = Math.max(1, Number(peopleInp.value || 1));
    modal.querySelector('[data-sum-date]')!.textContent =
      dateSel.selectedOptions[0]?.textContent ?? '';
    modal.querySelector('[data-sum-people]')!.textContent = String(people);
    modal.querySelector('[data-sum-name]')!.textContent = nameInp.value.trim();
    modal.querySelector('[data-sum-email]')!.textContent = emailInp.value.trim();
    const total = price * people;
    modal.querySelector('[data-sum-total]')!.textContent =
      `${currency} ${Number.isInteger(total) ? total : total.toFixed(2)}`;
    showStep(3);
  });

  modal.querySelectorAll('[data-bk-back]').forEach((el) =>
    el.addEventListener('click', () => {
      const cur = modal.querySelector<HTMLElement>('[data-bk-step]:not([hidden])')!;
      showStep(Number(cur.dataset.bkStep) - 1);
    })
  );

  // Bestätigen → Pollen-Konfetti + Erfolg
  modal.querySelector('[data-bk-confirm]')!.addEventListener('click', () => {
    showStep(4);
    const party = modal.querySelector<HTMLElement>('.bk-party')!;
    const colors = ['#e8a13d', '#f3c87f', '#9b8ec4', '#7a8b5a', '#c1714f'];
    for (let i = 0; i < 36; i++) {
      const p = document.createElement('i');
      const size = 5 + Math.random() * 8;
      p.style.cssText = `
        left:${8 + Math.random() * 84}%;
        width:${size}px; height:${size}px;
        background:${colors[i % colors.length]};
        animation-delay:${Math.random() * 0.5}s;
        animation-duration:${1.4 + Math.random() * 1.4}s;
      `;
      party.append(p);
    }
  });
</script>

<style>
  .workshops {
    background: var(--miel-100);
  }

  /* Akzentfarben pro Workshop: Karte und Detailansicht teilen sich die Variablen */
  .ws-card,
  .wd {
    --ws-accent: var(--miel-500);
    --ws-accent-deep: var(--miel-700);
    --ws-accent-soft: var(--miel-100);
    --ws-accent-line: var(--miel-300);
  }

  .ws-card--lavanda,
  .wd--lavanda {
    --ws-accent: var(--lavanda-500);
    --ws-accent-deep: var(--lavanda-700);
    --ws-accent-soft: var(--lavanda-100);
    --ws-accent-line: var(--lavanda-300);
  }

  .ws-card--pistacho,
  .wd--pistacho {
    --ws-accent: var(--pistacho-500);
    --ws-accent-deep: var(--pistacho-700);
    --ws-accent-soft: var(--pistacho-100);
    --ws-accent-line: var(--pistacho-300);
  }

  .ws-card--barro,
  .wd--barro {
    --ws-accent: var(--barro-500);
    --ws-accent-deep: var(--barro-700);
    --ws-accent-soft: var(--barro-100);
    --ws-accent-line: var(--barro-300);
  }

  /* Akzent des Backend-Themas "cielo" (Aire libre / Outdoors). */
  .ws-card--cielo,
  .wd--cielo {
    --ws-accent: var(--cielo-500);
    --ws-accent-deep: var(--cielo-700);
    --ws-accent-soft: var(--cielo-100);
    --ws-accent-line: var(--cielo-300);
  }

  .ws-grid {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .ws-card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--sp-4);
    border-top: 6px solid var(--ws-accent-line);
  }

  /* leichte Handarbeit statt Rasterperfektion */
  .ws-card:nth-child(odd) { rotate: -0.4deg; }
  .ws-card:nth-child(even) { rotate: 0.35deg; }

  /* ---------- Kartenkopf als Trigger ---------- */

  .ws-head {
    margin: 0;
    font-size: inherit;
  }

  .ws-head-btn {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--sp-4);
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    text-align: start;
    cursor: pointer;
    color: inherit;
  }

  .ws-icon {
    width: 76px;
    height: 76px;
    border-radius: var(--r-blob);
    background: var(--papel-warm);
    display: grid;
    place-items: center;
    padding: 6px;
    transition: transform var(--dur-2) var(--ease-bounce);
  }

  .ws-icon svg { width: 100%; height: auto; }

  .ws-head-text {
    display: grid;
    gap: 0.25em;
    justify-items: start;
  }

  .ws-name {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    line-height: var(--lh-snug);
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--dur-2) var(--ease-out);
  }

  .ws-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;

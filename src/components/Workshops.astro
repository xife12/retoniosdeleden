            </button>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Buchungs-Dialog (Demo) -->
  <div class="modal-backdrop" data-booking-backdrop hidden></div>
  <div
    class="modal"
    data-booking-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby="booking-title"
    hidden
  >
    <button class="modal-close" data-booking-close aria-label={b.close}>×</button>

    <h3 id="booking-title">
      {b.title}: <span data-bk-title></span>
    </h3>

    <ol class="steps" aria-hidden="true">
      {b.steps.map((s, i) => (
        <li class="step" data-step-dot={i + 1}>{s}</li>
      ))}
    </ol>

    <!-- Schritt 1: Fecha & Personen -->
    <form class="bk-panel" data-bk-step="1">
      <div class="field">
        <label for="bk-date">{b.date}</label>
        <select id="bk-date" required></select>
      </div>
      <div class="field">
        <label for="bk-people">{b.people}</label>
        <input id="bk-people" type="number" min="1" value="2" required inputmode="numeric" />
      </div>
      <div class="bk-actions">
        <button type="submit" class="btn">{b.next}</button>
      </div>
    </form>

    <!-- Schritt 2: Daten -->
    <form class="bk-panel" data-bk-step="2" hidden>
      <div class="field">
        <label for="bk-name">{b.name}</label>
        <input id="bk-name" type="text" required autocomplete="name" />
        <p class="err" data-err-name hidden>{b.errRequired}</p>
      </div>
      <div class="field">
        <label for="bk-email">{b.email}</label>
        <input id="bk-email" type="email" required autocomplete="email" />
        <p class="err" data-err-email hidden>{b.errEmail}</p>
      </div>
      <div class="bk-actions">
        <button type="button" class="btn btn--ghost" data-bk-back>{b.back}</button>
        <button type="submit" class="btn">{b.next}</button>
      </div>
    </form>

    <!-- Schritt 3: Zusammenfassung -->
    <div class="bk-panel" data-bk-step="3" hidden>
      <h4>{b.summary}</h4>
      <dl class="bk-summary">
        <div><dt>{b.date}</dt><dd data-sum-date></dd></div>
        <div><dt>{b.people}</dt><dd data-sum-people></dd></div>
        <div><dt>{b.name}</dt><dd data-sum-name></dd></div>
        <div><dt>{b.email}</dt><dd data-sum-email></dd></div>
        <div class="bk-total"><dt>{b.total}</dt><dd data-sum-total></dd></div>
      </dl>
      <div class="bk-actions">
        <button type="button" class="btn btn--ghost" data-bk-back>{b.back}</button>
        <button type="button" class="btn btn--secondary" data-bk-confirm>{b.confirm}</button>
      </div>
    </div>

    <!-- Erfolg -->
    <div class="bk-panel bk-success" data-bk-step="4" hidden>
      <div class="bk-party" aria-hidden="true"></div>
      <svg class="bk-bee" viewBox="0 0 90 90" aria-hidden="true">
        <ellipse cx="42" cy="52" rx="24" ry="17" fill="url(#pg-miel)" filter="url(#wc-rough)" />
        <path d="M32 36 L 34 68 M 46 34 L 48 70" stroke="#6b4a1f" stroke-width="6" filter="url(#wc-rough)" />
        <ellipse cx="36" cy="28" rx="17" ry="8" transform="rotate(-26 36 28)" fill="#d9eaf2" opacity="0.85" />
        <circle cx="66" cy="44" r="11" fill="#a06a2c" filter="url(#wc-rough)" />
        <circle cx="69" cy="42" r="2" fill="#33291f" />
        <path d="M64 50 C 67 53, 71 53, 74 50" stroke="#33291f" stroke-width="1.6" stroke-linecap="round" fill="none" />
      </svg>
      <h4>{b.successTitle}</h4>
      <p>{b.successText}</p>
      <button type="button" class="btn" data-booking-close>{b.close}</button>
    </div>
  </div>
</section>

<script>
  /* ---------------- gemeinsame Helfer ---------------- */

  const FOCUSABLE = 'button, input, select, textarea, [href], [tabindex]:not([tabindex="-1"])';

  function trapFocus(modal: HTMLElement) {
    modal.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focusables = Array.from(modal.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => !el.hasAttribute('hidden') && el.offsetParent !== null
      );
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        last.focus();
        e.preventDefault();
      } else if (!e.shiftKey && document.activeElement === last) {
        first.focus();
        e.preventDefault();
      }
    });
  }

  /* ---------------- Detailansicht ---------------- */

  const detail = document.querySelector<HTMLElement>('[data-detail-modal]')!;
  const detailBackdrop = document.querySelector<HTMLElement>('[data-detail-backdrop]')!;
  const detailCloseBtn = detail.querySelector<HTMLElement>('[data-detail-close]')!;

  /** Karte, von der aus die Detailansicht geöffnet wurde. */
  let detailOrigin: HTMLElement | null = null;

  function openDetail(trigger: HTMLElement) {
    const id = trigger.dataset.wsDetail ?? '';
    detail.querySelectorAll<HTMLElement>('[data-detail-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.detailPanel !== id;
    });
    detail.setAttribute('aria-labelledby', `wd-title-${id}`);

    detailOrigin = trigger;
    detail.hidden = false;
    detailBackdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    detail.scrollTop = 0;
    detailCloseBtn.focus();
  }

  function closeDetail(restoreFocus = true) {
    detail.hidden = true;
    detailBackdrop.hidden = true;
    document.body.style.overflow = '';
    if (restoreFocus) {
      detailOrigin?.focus({ preventScroll: true });
      detailOrigin = null;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-ws-detail]').forEach((trigger) => {
    trigger.addEventListener('click', () => openDetail(trigger));
  });

  detailCloseBtn.addEventListener('click', () => closeDetail());
  detailBackdrop.addEventListener('click', () => closeDetail());
  trapFocus(detail);

  /* ---------------- Buchungsdialog ---------------- */

  const modal = document.querySelector<HTMLElement>('[data-booking-modal]')!;
  const backdrop = document.querySelector<HTMLElement>('[data-booking-backdrop]')!;
  const titleEl = modal.querySelector<HTMLElement>('[data-bk-title]')!;
  const dateSel = modal.querySelector<HTMLSelectElement>('#bk-date')!;
  const peopleInp = modal.querySelector<HTMLInputElement>('#bk-people')!;
  const nameInp = modal.querySelector<HTMLInputElement>('#bk-name')!;
  const emailInp = modal.querySelector<HTMLInputElement>('#bk-email')!;

  let price = 0;
  /** Element, das nach dem Schließen der Buchung den Fokus zurückbekommt. */
  let bookingReturn: HTMLElement | null = null;

  function showStep(n: number) {
    modal.querySelectorAll<HTMLElement>('[data-bk-step]').forEach((p) => {
      p.hidden = p.dataset.bkStep !== String(n);
    });
    modal.querySelectorAll<HTMLElement>('[data-step-dot]').forEach((d) => {
      const k = Number(d.dataset.stepDot);
      d.classList.toggle('is-done', k < n);
      d.classList.toggle('is-current', k === n);
    });
  }

  /** src trägt die data-ws-*-Attribute, returnTo bekommt danach den Fokus. */
  function open(src: HTMLElement, returnTo: HTMLElement | null) {
    bookingReturn = returnTo;
    titleEl.textContent = src.dataset.wsTitle ?? '';
    price = Number(src.dataset.wsPrice ?? 0);
    peopleInp.max = src.dataset.wsMax ?? '12';
    peopleInp.value = '2';
    nameInp.value = '';
    emailInp.value = '';
    modal.querySelector<HTMLElement>('[data-err-name]')!.hidden = true;
    modal.querySelector<HTMLElement>('[data-err-email]')!.hidden = true;

    const dates: { iso: string; label: string }[] = JSON.parse(src.dataset.wsDates ?? '[]');
    dateSel.innerHTML = '';
    for (const d of dates) {
      const opt = document.createElement('option');
      opt.value = d.iso;
      opt.textContent = d.label;
      dateSel.append(opt);
    }

    showStep(1);
    modal.hidden = false;
    backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    modal.scrollTop = 0;
    dateSel.focus();
  }

  function close() {
    modal.hidden = true;
    backdrop.hidden = true;
    document.body.style.overflow = '';
    modal.querySelector('.bk-party')!.innerHTML = '';
    bookingReturn?.focus({ preventScroll: true });
    bookingReturn = null;
  }

  document.querySelectorAll<HTMLElement>('.book-btn').forEach((btn) => {
    btn.addEventListener('click', () => open(btn, btn));
  });

  /* Übergabe: Detail schließen, Buchung mit demselben Workshop öffnen. */
  detail.querySelectorAll<HTMLElement>('[data-detail-book]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const origin = detailOrigin;
      closeDetail(false);
      detailOrigin = null;
      open(btn, origin);
    });
  });

  modal.querySelectorAll('[data-booking-close]').forEach((el) => el.addEventListener('click', close));
  backdrop.addEventListener('click', close);
  trapFocus(modal);

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!modal.hidden) close();
    else if (!detail.hidden) closeDetail();
  });

  // Schritt 1 → 2
  modal.querySelector<HTMLFormElement>('[data-bk-step="1"]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    showStep(2);
    nameInp.focus();
  });

  // Schritt 2 → 3 (mit Validierung)
  modal.querySelector<HTMLFormElement>('[data-bk-step="2"]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const errName = modal.querySelector<HTMLElement>('[data-err-name]')!;
    const errEmail = modal.querySelector<HTMLElement>('[data-err-email]')!;
    const nameOk = nameInp.value.trim().length > 1;
    const emailOk = /.+@.+\..+/.test(emailInp.value);
    errName.hidden = nameOk;
    errEmail.hidden = emailOk;
    if (!nameOk || !emailOk) return;

    const people = Math.max(1, Number(peopleInp.value || 1));
    modal.querySelector('[data-sum-date]')!.textContent =
      dateSel.selectedOptions[0]?.textContent ?? '';
    modal.querySelector('[data-sum-people]')!.textContent = String(people);
    modal.querySelector('[data-sum-name]')!.textContent = nameInp.value.trim();
    modal.querySelector('[data-sum-email]')!.textContent = emailInp.value.trim();
    modal.querySelector('[data-sum-total]')!.textContent = `US$ ${price * people}`;
    showStep(3);
  });

  modal.querySelectorAll('[data-bk-back]').forEach((el) =>
    el.addEventListener('click', () => {
      const cur = modal.querySelector<HTMLElement>('[data-bk-step]:not([hidden])')!;
      showStep(Number(cur.dataset.bkStep) - 1);
    })
  );

  // Bestätigen → Pollen-Konfetti + Erfolg
  modal.querySelector('[data-bk-confirm]')!.addEventListener('click', () => {
    showStep(4);
    const party = modal.querySelector<HTMLElement>('.bk-party')!;
    const colors = ['#e8a13d', '#f3c87f', '#9b8ec4', '#7a8b5a', '#c1714f'];
    for (let i = 0; i < 36; i++) {
      const p = document.createElement('i');
      const size = 5 + Math.random() * 8;
      p.style.cssText = `
        left:${8 + Math.random() * 84}%;
        width:${size}px; height:${size}px;
        background:${colors[i % colors.length]};
        animation-delay:${Math.random() * 0.5}s;
        animation-duration:${1.4 + Math.random() * 1.4}s;
      `;
      party.append(p);
    }
  });
</script>


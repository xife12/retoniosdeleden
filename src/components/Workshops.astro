            {w.id === 'barro' && (
              <svg viewBox="0 0 320 150">
                <rect width="320" height="150" fill="url(#pg-cielo)" opacity="0.38" />
                <circle cx="44" cy="32" r="20" fill="url(#pg-sol)" filter="url(#wc-wash)" />
                <g filter="url(#wc-wash)" opacity="0.45">

                  <ellipse cx="218" cy="120" rx="6" ry="14" fill="url(#pg-lavanda)" opacity="0.8" />
                  <ellipse cx="240" cy="110" rx="7" ry="17" fill="url(#pg-lavanda)" opacity="0.85" />
                  <ellipse cx="262" cy="122" rx="6" ry="13" fill="url(#pg-lavanda)" opacity="0.75" />

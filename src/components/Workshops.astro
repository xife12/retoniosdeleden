---
import type { Dict, Lang } from '../i18n';
import { workshops, workshopDetailUI, formatDate } from '../data/workshops';

interface Props {
  t: Dict;
  lang: Lang;
}

const { t, lang } = Astro.props;
const b = t.workshops.booking;
const ui = workshopDetailUI[lang];

const chipClass: Record<string, string> = {
  miel: 'chip--miel',
  lavanda: 'chip--lavanda',
  pistacho: '',
  barro: 'chip--barro',
};

/** Termine als JSON für den Buchungsdialog (Karte und Detailansicht teilen sich das Format). */
const datesAttr = (dates: string[]) =>
  JSON.stringify(dates.map((d) => ({ iso: d, label: formatDate(d, lang) })));
---

<section id="talleres" class="workshops" data-chapter data-meli-zone>
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="kicker">{t.workshops.kicker}</p>
      <h2>
        <span class="swash">{t.workshops.title}</span>
        <span class="meli-perch" data-meli-perch aria-hidden="true"></span>
      </h2>
      <p class="lead">{t.workshops.intro}</p>
    </header>

    <div class="ws-grid">
      {workshops.map((w) => {
        const wt = w.text[lang];
        return (
          <article class={`card ws-card ws-card--${w.accent}`} data-reveal>
            <h3 class="ws-head">
              <button type="button" class="ws-head-btn" data-ws-detail={w.id} aria-haspopup="dialog">
                <span class="ws-icon" aria-hidden="true">
                  {w.icon === 'bee' && (
                    <svg viewBox="0 0 90 90">
                      <ellipse cx="42" cy="52" rx="24" ry="17" fill="url(#pg-miel)" filter="url(#wc-rough)" />
                      <path d="M32 36 L 34 68 M 46 34 L 48 70" stroke="#6b4a1f" stroke-width="6" filter="url(#wc-rough)" />
                      <ellipse cx="36" cy="28" rx="17" ry="8" transform="rotate(-26 36 28)" fill="#d9eaf2" opacity="0.85" />
                      <circle cx="66" cy="44" r="11" fill="#a06a2c" filter="url(#wc-rough)" />
                      <circle cx="69" cy="42" r="2" fill="#33291f" />
                    </svg>
                  )}
                  {w.icon === 'lavender' && (
                    <svg viewBox="0 0 90 90">
                      <path d="M45 76 C 46 58, 44 44, 46 26" stroke="#5b6c42" stroke-width="3.4" stroke-linecap="round" filter="url(#ink)" fill="none" />
                      <ellipse cx="46" cy="24" rx="9" ry="17" fill="url(#pg-lavanda)" filter="url(#wc-rough)" />
                      <ellipse cx="34" cy="46" rx="6" ry="11" transform="rotate(-28 34 46)" fill="url(#pg-lavanda)" opacity="0.8" filter="url(#wc-rough)" />
                      <ellipse cx="58" cy="42" rx="6" ry="11" transform="rotate(24 58 42)" fill="url(#pg-lavanda)" opacity="0.8" filter="url(#wc-rough)" />
                    </svg>
                  )}
                  {w.icon === 'pistachio' && (
                    <svg viewBox="0 0 90 90">
                      <ellipse cx="45" cy="48" rx="24" ry="29" fill="#e8d5b8" filter="url(#wc-soft)" />
                      <path d="M45 19 C 31 25, 25 38, 26 52 C 27 65, 34 74, 45 77 Z" fill="#d9bd94" filter="url(#wc-rough)" />
                      <ellipse cx="50" cy="48" rx="11" ry="20" fill="url(#pg-pistacho)" filter="url(#wc-rough)" />
                    </svg>
                  )}
                  {w.icon === 'organic' && (
                    <svg viewBox="0 0 90 90">
                      <path d="M22 66 C 34 60, 56 60, 68 66 L 64 74 L 26 74 Z" fill="url(#pg-barro)" opacity="0.7" filter="url(#wc-rough)" />
                      <path d="M45 64 C 45 50, 44 42, 45 32" stroke="#5b6c42" stroke-width="3.4" stroke-linecap="round" filter="url(#ink)" fill="none" />
                      <ellipse cx="36" cy="32" rx="12" ry="7" transform="rotate(-32 36 32)" fill="url(#pg-pistacho)" filter="url(#wc-rough)" />
                      <ellipse cx="55" cy="26" rx="12" ry="7" transform="rotate(28 55 26)" fill="url(#pg-pistacho)" filter="url(#wc-rough)" />
                      <circle cx="45" cy="45" r="26" fill="none" stroke="#7a8b5a" stroke-width="2.4" stroke-dasharray="5 6" opacity="0.6" filter="url(#ink)" />
                    </svg>
                  )}
                  {w.icon === 'clay' && (
                    <svg viewBox="0 0 90 90">
                      <path d="M26 70 L 26 44 C 26 30, 64 30, 64 44 L 64 70 Z" fill="url(#pg-barro)" filter="url(#wc-soft)" />
                      <path d="M20 46 C 34 28, 56 28, 70 46" stroke="#5b6c42" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.85" filter="url(#wc-rough)" />
                      <rect x="40" y="54" width="12" height="16" rx="5" fill="#5c3a26" opacity="0.8" filter="url(#wc-rough)" />
                      <path d="M66 64 L 78 52 M 74 48 L 82 56" stroke="#8a7b68" stroke-width="3" stroke-linecap="round" filter="url(#ink)" />
                    </svg>
                  )}
                </span>

                <span class="ws-head-text">
                  <span class="ws-name">{wt.title}</span>
                  <span class="ws-more">
                    {ui.more}
                    <svg class="ws-arrow" viewBox="0 0 12 12" aria-hidden="true">
                      <path d="M2 6 H 10 M 6.4 2.6 L 10 6 L 6.4 9.4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" filter="url(#ink)" />
                    </svg>
                  </span>
                </span>
              </button>
            </h3>

            <div class="ws-body">
              <span class={`chip ${chipClass[w.accent]}`}>{wt.audience}</span>
              <p>{wt.desc}</p>

              <dl class="ws-meta">
                <div>
                  <dt>{t.workshops.duration}</dt>
                  <dd>{w.hours} {t.workshops.hours}</dd>
                </div>
                <div>
                  <dt>{t.workshops.group}</dt>
                  <dd>{w.maxPeople} {t.workshops.people}</dd>
                </div>
                <div>
                  <dt>US$ {w.priceUSD}</dt>
                  <dd>{t.workshops.perPerson}</dd>
                </div>
              </dl>

              <p class="ws-dates">
                <strong>{t.workshops.nextDates}:</strong>{' '}
                {w.dates.map((d) => formatDate(d, lang)).join(', ')}
              </p>

              <button
                class="btn book-btn"
                data-ws-id={w.id}
                data-ws-title={wt.title}
                data-ws-price={w.priceUSD}
                data-ws-max={w.maxPeople}
                data-ws-dates={datesAttr(w.dates)}
              >
                {t.workshops.book}
              </button>
            </div>
          </article>
        );
      })}
    </div>

    <p class="demo-note" data-reveal>{t.workshops.demoNote}</p>
  </div>

  <!-- Detail-Dialog: alle Panels serverseitig gerendert, JS blendet nur um -->
  <div class="modal-backdrop" data-detail-backdrop hidden></div>
  <div
    class="modal modal--detail"
    data-detail-modal
    role="dialog"
    aria-modal="true"
    aria-labelledby={`wd-title-${workshops[0].id}`}
    hidden
  >
    <button class="modal-close" data-detail-close aria-label={ui.close}>×</button>

    {workshops.map((w) => {
      const wt = w.text[lang];
      return (

                <g transform="translate(256,102)" filter="url(#wc-rough)">
                  <path d="M0 0 L 26 0 L 22 28 L 4 28 Z" fill="#7fb0c9" opacity="0.85" />
                  <path d="M2 0 C 6 -11, 20 -11, 24 0" stroke="#5c4f40" stroke-width="2.6" fill="none" />
                </g>

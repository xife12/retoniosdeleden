---
/**
 * Ineinanderlaufende Farbwaschung zwischen zwei Sektionen.
 * `color` = Hintergrundfarbe der FOLGENDEN Sektion.
 */
interface Props {
  color: string;
  flip?: boolean;
}

const { color, flip = false } = Astro.props;
---

<div class={`divider ${flip ? 'divider--flip' : ''}`} aria-hidden="true">
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none">
    <path
      d="M0 64 C 140 30, 300 78, 480 58 C 680 36, 820 80, 1020 60 C 1200 42, 1330 58, 1440 38 L 1440 92 L 0 92 Z"
      fill={color}
      filter="url(#wc-wash)"
    />
  </svg>
</div>

<style>
  .divider {
    line-height: 0;
    margin-bottom: -1px;
    position: relative;
    z-index: 1;
  }

  .divider svg {
    width: 100%;
    height: clamp(38px, 7vw, 90px);
  }

  .divider--flip svg {
    transform: scaleX(-1);
  }
</style>

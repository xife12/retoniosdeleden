---
/**
 * Datenschutzerklärung — die gemeinsame Seite hinter /es/privacidad und
 * /en/privacy.
 *
 * Aufbau wie NosotrosPage.astro: eine eigenständige Unterseite mit eigener,
 * schlanker Kopfleiste statt Nav.astro (Nav.astro ist auf die Ankerliste der
 * Startseite zugeschnitten, die es hier nicht gibt) und der normalen
 * Fußzeile darunter. Die beiden Dateien in src/pages sind deshalb je vier
 * Zeilen lang und übergeben nur die Sprache.
 *
 * Der Text selbst steht in src/data/privacidad.ts — samt der Begründung,
 * welche Artikel der Ley 18.331 er abdecken muss. Hier steht nur, wie er
 * aussieht.
 *
 * Bewusst ohne Aquarell-Zierrat und ohne Reveal-Animationen: das ist die
 * eine Seite, auf die jemand kommt, weil er etwas WISSEN will. Sie darf
 * langweilig sein. Zusammengehalten wird sie mit der übrigen Seite über
 * Papierton, Schrift und Kopfleiste, nicht über Bilder.
 */
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import Logo from './Logo.astro';
import { getDict, type Lang } from '../i18n';
import {
  contactoDatos,
  privacidad,
  privacidadFecha,
  privacidadRuta,
} from '../data/privacidad';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const c = privacidad[lang];

/**
 * Ein Absatz ist entweder Fließtext, eine Webadresse oder enthält die
 * Auskunftsadresse. Alle drei Fälle sollen anklickbar sein, ohne dass im
 * Datenmodul HTML steht — Markup in Textdaten rächt sich, sobald jemand
 * einen Text übersetzt und dabei ein Tag zerreißt.
 *
 * Deshalb hier die einzige Sonderbehandlung, die es braucht: an der
 * Mailadresse wird der Absatz geteilt, eine Adresse allein wird zum Link.
 */
function partes(parrafo: string): Array<{ tipo: 'texto' | 'mail'; valor: string }> {
  return parrafo
    .split(contactoDatos)
    .flatMap((trozo, i) =>
      i === 0
        ? [{ tipo: 'texto' as const, valor: trozo }]
        : [
            { tipo: 'mail' as const, valor: contactoDatos },
            { tipo: 'texto' as const, valor: trozo },
          ],
    )
    .filter((p) => p.valor !== '');
}

const esUrl = (s: string) => s.startsWith('https://') || s.startsWith('http://');

const fechaLegible = new Intl.DateTimeFormat(lang === 'es' ? 'es-UY' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(`${privacidadFecha}T12:00:00Z`));
---

<Base lang={lang} title={`${c.titulo} · Retoños del Edén`} description={c.descripcion}>
  <a class="skip-link" href="#priv">{t.nav.skip}</a>

  <header class="priv-nav">
    <a class="priv-marca" href={`/${lang}/`} data-astro-prefetch>
      <svg class="priv-volver" viewBox="0 0 20 20" width="13" height="13" aria-hidden="true">
        <path
          d="M12.5 3.5 L 6 10 L 12.5 16.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          filter="url(#ink)"
        />
      </svg>
      <span class="priv-marca-logo"><Logo width="34px" decorative /></span>
      <span>Retoños del Edén</span>
    </a>

    <p class="priv-nav-titulo">{c.titulo}</p>

    <div class="lang-switch" role="group" aria-label="Idioma / Language">
      <a href={privacidadRuta.es} aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
      <span aria-hidden="true">·</span>
      <a href={privacidadRuta.en} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
    </div>
  </header>

  <main id="priv" class="priv">
    <div class="priv-caja">
      <h1>{c.titulo}</h1>
      <p class="priv-intro">{c.intro}</p>
      <p class="priv-fecha">
        {c.fechaLabel}: <time datetime={privacidadFecha}>{fechaLegible}</time>
      </p>

      {
        c.secciones.map((s) => (
          <section class="priv-sec">
            <h2>{s.titulo}</h2>
            {s.parrafos.map((p) =>
              esUrl(p) ? (
                <p>
                  <a href={p} rel="noopener noreferrer" target="_blank">
                    {p}
                  </a>
                </p>
              ) : (
                <p>
                  {partes(p).map((trozo) =>
                    trozo.tipo === 'mail' ? (
                      <a href={`mailto:${trozo.valor}`}>{trozo.valor}</a>
                    ) : (
                      <Fragment>{trozo.valor}</Fragment>
                    ),
                  )}
                </p>
              ),
            )}
            {s.lista && (
              <ul>
                {s.lista.map((li) => (
                  <li>{li}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }

      <p class="priv-pie">
        <a href={`/${lang}/`}>{c.volver}</a>
      </p>
    </div>
  </main>

  <Footer t={t} lang={lang} />
</Base>

<style>
  /* ---------- Sprungmarke ----------
     Wie auf der Buch- und der Panal-Seite: hier steht keine Nav.astro, die
     sie sonst stylt. */
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 300;
    background: var(--miel-500);
    color: var(--tinta);
    font-weight: 600;
    text-decoration: none;
    padding: 0.6em 1.2em;
    border-radius: var(--r-full);
  }

  .skip-link:focus-visible {
    top: 0.75rem;
  }

  /* ---------- Kopfleiste ----------
     1:1 aus NosotrosPage.astro übernommen, damit der Wechsel von der
     Startseite hierher keinen Sprung macht. */
  .priv-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--sp-4);
    padding: 0.65rem clamp(1rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--papel) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgba(51, 41, 31, 0.07);
  }

  @media (max-width: 859px) {
    .priv-nav {
      grid-auto-rows: minmax(44px, auto);
    }
  }

  .priv-marca {
    grid-column: 1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--tinta);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 80, 'WONK' 1;
    font-weight: 620;
    font-size: 1.05rem;
    white-space: nowrap;
  }

  .priv-marca-logo {
    display: block;
    flex: none;
  }

  .priv-volver {
    flex: none;
    color: var(--tinta-tenue);
    transition:
      translate var(--dur-2) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .priv-marca:hover .priv-volver,
  .priv-marca:focus-visible .priv-volver {
    translate: -3px 0;
    color: var(--tinta-suave);
  }

  .priv-nav-titulo {
    grid-column: 2;
    display: none;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 90, 'WONK' 1;
    font-style: italic;
    font-size: var(--fs-300);
    color: var(--tinta-suave);
    text-align: center;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 860px) {
    .priv-nav {
      grid-template-columns: 1fr auto 1fr;
    }

    .priv-nav-titulo {
      display: block;
    }
  }

  /* ---------- Sprachumschalter ----------
     Ebenfalls aus NosotrosPage.astro. Der ::before-Kasten vergrößert die
     Tastfläche auf 44 px, ohne das kleine Schriftbild zu verändern. */
  .lang-switch {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-300);
    font-weight: 700;
    color: var(--tinta-suave);
  }

  .lang-switch a {
    position: relative;
    text-decoration: none;
    color: var(--tinta-suave);
    padding: 0.25em 0.5em;
    border-radius: var(--r-full);
    transition:
      background var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  .lang-switch a::before {
    content: '';
    position: absolute;
    inset: -11px -4px;
  }

  .lang-switch a[aria-current='page'] {
    background: var(--miel-500);
    color: var(--tinta);
  }

  .lang-switch a:not([aria-current]):hover {
    color: var(--tinta);
    background: var(--miel-100);
  }

  /* ---------- Inhalt ----------
     Eine einzige Spalte, ~62 Zeichen breit. Eine Rechtsseite wird gelesen,
     nicht überflogen -- alles, was hier nach Layout aussieht, stört. */
  .priv {
    padding-block: clamp(5.5rem, 12vw, 8rem) clamp(3rem, 8vw, 5rem);
    background: var(--papel-warm);
  }

  .priv-caja {
    width: min(62ch, calc(100% - 2 * clamp(1rem, 5vw, 2.5rem)));
    margin-inline: auto;
  }

  .priv h1 {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
    font-size: var(--fs-800);
    line-height: 1.1;
    color: var(--tinta);
    margin-bottom: var(--sp-3);
  }

  .priv-intro {
    font-size: var(--fs-500);
    color: var(--tinta-suave);
    line-height: 1.6;
  }

  .priv-fecha {
    margin-top: var(--sp-3);
    font-size: var(--fs-300);
    color: var(--tinta-tenue);
  }

  .priv-sec {
    margin-top: var(--sp-6);
  }

  .priv-sec h2 {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 80, 'WONK' 1;
    font-size: var(--fs-600);
    color: var(--tinta);
    margin-bottom: var(--sp-2);
  }

  .priv-sec p,
  .priv-sec li {
    color: var(--tinta-suave);
    line-height: 1.7;
  }

  .priv-sec p + p {
    margin-top: var(--sp-2);
  }

  .priv-sec ul {
    margin-top: var(--sp-2);
    padding-left: 1.15em;
    list-style: disc;
    display: grid;
    gap: 0.35rem;
  }

  /* Lange Adressen dürfen umbrechen, sonst schiebt die URCDP-Zeile auf dem
     Telefon die ganze Seite seitwärts. */
  .priv-sec a {
    color: var(--tinta);
    text-decoration-color: var(--miel-500);
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .priv-pie {
    margin-top: var(--sp-7);
    padding-top: var(--sp-4);
    border-top: 1px solid color-mix(in srgb, var(--tinta) 12%, transparent);
    font-size: var(--fs-300);
  }
</style>

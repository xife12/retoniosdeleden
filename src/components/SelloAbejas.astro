---
/**
 * Signet der Marke "Las abejas educan".
 *
 * Sechs Entwürfe zur Auswahl, umschaltbar über `variante`. Die Wahl ist
 * später ein Wort — deshalb liegen alle sechs hier nebeneinander statt in
 * sechs Dateien.
 *
 * Gemeinsames Vokabular, damit die Marke als Teil von Retoños del Edén
 * lesbar bleibt und nicht als Fremdkörper (vgl. Logo.astro):
 *   - Bernstein (--miel-700/-800) und Tusche (--tinta) als einzige Farben,
 *   - die gepunktete Flugbahn (stroke-dasharray 1.6 5) der Startseite,
 *   - Fraunces für die Wortmarke,
 *   - Filter `ink` für die zittrige Tuschelinie.
 *
 * Die Bienen sind im PROFIL gezeichnet, wie Meli — eine frontal gesehene
 * Biene wäre eine zweite, fremde Biene im selben Haus.
 *
 * Wichtig: Favicons und andere Stellen ohne Seiten-CSS erben keine
 * Variablen. Diese Komponente lebt immer im Seitenkontext, deshalb sind
 * hier CSS-Variablen in Ordnung.
 */

export type SelloVariante = 'arbol' | 'panal' | 'vuelo' | 'modulos' | 'lacre' | 'rama' | 'letra';

interface Props {
  variante?: SelloVariante;
  /** Kantenlänge des Signets. */
  size?: string;
  /** Wortmarke mitzeichnen. Aus, wenn daneben schon die Überschrift steht. */
  conTexto?: boolean;
  /** Rein dekorativ (die Überschrift daneben trägt schon den Namen). */
  decorative?: boolean;
  class?: string;
}

const {
  variante = 'arbol',
  size = '96px',
  conTexto = false,
  decorative = false,
  class: klass,
} = Astro.props;

const rotulo = 'Las abejas educan';
---

<svg
  class:list={['sello', `sello--${variante}`, klass]}
  viewBox={conTexto ? '0 0 120 148' : '0 0 120 120'}
  style={`width:${size}`}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : rotulo}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  {/* ---------------------------------------------------------------
      0 · ÁRBOL — die gewählte Fassung.
      Aus zwei der ersten Entwürfe zusammengesetzt: das offene Sechseck
      aus "Vuelo" — die Kontur reißt an einer Ecke auf und läuft als
      gepunktete Flugbahn hinaus — und der Baum mit der Biene aus "Rama".

      Der Ring ist bewusst kein Kreis: ein Kreis ist ein Emblem wie jedes
      andere, ein Sechseck ist eine Wabenzelle. Und weil sie offen ist,
      ist sie keine Umzäunung: was hier drin wächst, geht wieder hinaus.

      In der Mitte der Bienenbaum — Stamm, Krone und darin eine kleine
      Wabe. Das ist der Kern der Marke in einem Bild: Bienen unterrichten
      nicht im Klassenzimmer, sondern in dem, was wächst.
      --------------------------------------------------------------- */}
  {variante === 'arbol' && (
    <g>
      {/* Offenes Sechseck. Die Lücke sitzt oben links, dort setzt die
          Flugbahn an. Gelöst über die Strichelung des einen Pfades statt
          über zwei getrennte Pfade — so bleibt die Ecke sauber. */}
      <path
        d="M60 12 L95 32 L95 72 L60 92 L25 72 L25 32 Z"
        fill="none"
        stroke="var(--miel-800)"
        stroke-width="3.4"
        stroke-linejoin="round"
        stroke-linecap="round"
        stroke-dasharray="150 44"
        stroke-dashoffset="-16"
        filter="url(#ink)"
      />

      {/* Die Flugbahn tritt durch die Lücke ein, im selben Strichrhythmus
          wie die Fluglinien der Startseite. */}
      <path
        d="M18 26 C 30 14, 44 12, 54 20"
        fill="none"
        stroke="var(--miel-700)"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-dasharray="1.6 5"
      />

      {/* Boden, auf dem der Baum steht — ein Strich, mehr braucht es nicht */}
      <path
        d="M40 82 q20 5 40 0"
        fill="none"
        stroke="var(--pistacho-700)"
        stroke-width="2"
        stroke-linecap="round"
        opacity="0.75"
        filter="url(#ink)"
      />

      {/* Stamm */}
      <path
        d="M60 82 C 59 72, 61 66, 60 58"
        fill="none"
        stroke="#6b4a2f"
        stroke-width="5"
        stroke-linecap="round"
        filter="url(#ink)"
      />
      <path
        d="M60 68 C 55 64, 52 61, 49 58 M60 64 C 65 61, 68 59, 71 56"
        fill="none"
        stroke="#6b4a2f"
        stroke-width="2.6"
        stroke-linecap="round"
        filter="url(#ink)"
      />

      {/* Krone als Aquarellwaschung, nicht als Kontur — sie soll weich
          neben der harten Sechseckkante stehen. */}
      <g filter="url(#wc-soft)">
        <ellipse cx="60" cy="47" rx="23" ry="17" fill="url(#pg-pistacho-light)" />
        <ellipse cx="50" cy="52" rx="13" ry="10" fill="url(#pg-pistacho)" opacity="0.75" />
        <ellipse cx="71" cy="51" rx="12" ry="9" fill="url(#pg-pistacho)" opacity="0.7" />
      </g>

      {/* Die Wabe im Baum: hier wohnt das Volk. Ohne sie wäre es ein
          Baum mit einer Biene daneben, mit ihr ist es ein Bienenbaum. */}
      <path
        d="M60 40 L69 45.2 L69 55.8 L60 61 L51 55.8 L51 45.2 Z"
        fill="var(--miel-200)"
        stroke="var(--miel-800)"
        stroke-width="2"
        stroke-linejoin="round"
      />
      <path
        d="M55.5 47.8 h9 M55 51.4 h10 M55.5 55 h9"
        stroke="var(--miel-700)"
        stroke-width="1.2"
        stroke-linecap="round"
        opacity="0.8"
      />

      {/* Meli im Anflug, im Profil wie überall auf der Seite */}
      <g transform="translate(80 30) rotate(16)">
        <ellipse cx="0" cy="0" rx="5.4" ry="8" fill="var(--tinta)" />
        <path d="M-4.4 -3 h8.8 M-5 0.6 h10 M-4.2 4.2 h8.4"
          stroke="var(--miel-300)" stroke-width="1.5" stroke-linecap="round" />
        <path d="M-1 -8.2 q-1 -4.8 2.4 -7" stroke="var(--tinta)" stroke-width="1.4"
          fill="none" stroke-linecap="round" />
        <path d="M-5.4 -3.8 q-10.6 -7.2 -13 -0.6 q-1.8 5.8 11 4.2 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.2" stroke-linejoin="round" />
        <path d="M5.4 -3.8 q10.6 -7.2 13 -0.6 q1.8 5.8 -11 4.2 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.2" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {/* ---------------------------------------------------------------
      1 · PANAL — drei Zellen, eine bewohnt.
      Die Wabe selbst ist das Zeichen; die Biene sitzt in einer Zelle,
      die anderen zwei sind leer. Dieselbe Aussage wie auf "Nuestro
      Panal": ein Stock ist nie fertig.
      --------------------------------------------------------------- */}
  {variante === 'panal' && (
    <g>
      <g fill="none" stroke="var(--miel-800)" stroke-width="3" stroke-linejoin="round">
        <path d="M60 14 L92 32.5 L92 69.5 L60 88 L28 69.5 L28 32.5 Z" filter="url(#ink)" />
      </g>
      <g fill="var(--miel-200)" stroke="var(--miel-800)" stroke-width="1.6" stroke-linejoin="round">
        <path d="M60 26 L76 35 L76 53 L60 62 L44 53 L44 35 Z" />
      </g>
      <g fill="none" stroke="var(--miel-700)" stroke-width="1.4" stroke-linejoin="round" opacity="0.75">
        <path d="M44 53 L60 62 L60 80 L44 89 L28 80 L28 62 Z" transform="translate(0 -9)" />
        <path d="M76 53 L92 62 L92 80 L76 89 L60 80 L60 62 Z" transform="translate(0 -9)" />
      </g>
      {/* Biene im Profil, in der mittleren Zelle */}
      <g transform="translate(60 44)">
        <ellipse cx="0" cy="0" rx="5.5" ry="8.4" fill="var(--tinta)" />
        <path d="M-4.6 -3.2 h9.2 M-5.2 0.8 h10.4 M-4.4 4.6 h8.8"
          stroke="var(--miel-300)" stroke-width="1.5" stroke-linecap="round" />
        <path d="M-1 -8.6 q-1 -5 2.6 -7.4" stroke="var(--tinta)" stroke-width="1.4"
          fill="none" stroke-linecap="round" />
        <path d="M-5.6 -4 q-11 -7.5 -13.6 -0.6 q-1.8 6 11.4 4.4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.2" stroke-linejoin="round" />
        <path d="M5.6 -4 q11 -7.5 13.6 -0.6 q1.8 6 -11.4 4.4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.2" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {/* ---------------------------------------------------------------
      2 · VUELO — die Zelle wird zur Flugbahn.
      Die Wabenkontur öffnet sich an einer Ecke und läuft als gepunktete
      Linie hinaus, wie die Fluglinien auf der Startseite. Am Ende sitzt
      die Biene. "Was im Stock beginnt, geht hinaus."
      --------------------------------------------------------------- */}
  {variante === 'vuelo' && (
    <g>
      <path
        d="M60 16 L92 34.5 L92 71.5 L60 90 L28 71.5 L28 34.5 Z"
        fill="none"
        stroke="var(--miel-800)"
        stroke-width="3.2"
        stroke-linejoin="round"
        stroke-linecap="round"
        stroke-dasharray="128 46"
        stroke-dashoffset="-14"
        filter="url(#ink)"
      />
      <path
        d="M28 34.5 C 22 22, 34 12, 46 12 C 58 12, 62 18, 68 22"
        fill="none"
        stroke="var(--miel-700)"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-dasharray="1.6 5"
      />
      <g transform="translate(70 24) rotate(24)">
        <ellipse cx="0" cy="0" rx="5" ry="7.6" fill="var(--tinta)" />
        <path d="M-4 -2.8 h8 M-4.6 0.6 h9.2 M-3.8 4 h7.6"
          stroke="var(--miel-300)" stroke-width="1.4" stroke-linecap="round" />
        <path d="M-5 -3.6 q-10 -7 -12.4 -0.6 q-1.6 5.6 10.4 4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.1" stroke-linejoin="round" />
        <path d="M5 -3.6 q10 -7 12.4 -0.6 q1.6 5.6 -10.4 4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.1" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {/* ---------------------------------------------------------------
      3 · MÓDULOS — das Zeichen IST der Aufbau.
      Drei zusammenhängende Zellen (die drei Module in der Schule) und
      eine vierte, die etwas abseits liegt und voll ausgemalt ist (der
      Besuch auf der Chacra). Wer das Angebot kennt, liest es sofort.
      --------------------------------------------------------------- */}
  {variante === 'modulos' && (
    <g stroke-linejoin="round">
      <g fill="var(--miel-100)" stroke="var(--miel-800)" stroke-width="2.6" filter="url(#ink)">
        <path d="M34 20 L52 30.4 L52 51.2 L34 61.6 L16 51.2 L16 30.4 Z" />
        <path d="M34 61.6 L52 72 L52 92.8 L34 103.2 L16 92.8 L16 72 Z" />
        <path d="M52 40.8 L70 51.2 L70 72 L52 82.4 L34 72 L34 51.2 Z" />
      </g>
      <path
        d="M74 62 q10 -4 18 -2"
        fill="none"
        stroke="var(--miel-700)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="1.6 5"
      />
      <path
        d="M96 40 L112 49.2 L112 67.6 L96 76.8 L80 67.6 L80 49.2 Z"
        fill="var(--miel-500)"
        stroke="var(--miel-800)"
        stroke-width="2.6"
        filter="url(#ink)"
      />
      <g transform="translate(96 58) scale(0.86)">
        <ellipse cx="0" cy="0" rx="5" ry="7.6" fill="var(--tinta)" />
        <path d="M-4 -2.8 h8 M-4.6 0.6 h9.2 M-3.8 4 h7.6"
          stroke="var(--miel-200)" stroke-width="1.4" stroke-linecap="round" />
        <path d="M-5 -3.6 q-9.6 -7 -12 -0.6 q-1.6 5.6 10 4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.1" stroke-linejoin="round" />
        <path d="M5 -3.6 q9.6 -7 12 -0.6 q1.6 5.6 -10 4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.1" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {/* ---------------------------------------------------------------
      4 · LACRE — Wachssiegel.
      Kein gezeichnetes Sechseck, sondern ein Klecks Bienenwachs mit
      eingeprägter Wabe. Am ehesten "Siegel" im wörtlichen Sinn und das
      einzige der sechs, das auch als Aufkleber sofort funktioniert.
      --------------------------------------------------------------- */}
  {variante === 'lacre' && (
    <g>
      <path
        d="M60 8 C 78 8, 90 16, 98 28 C 108 42, 112 56, 104 74
           C 96 92, 80 104, 60 106 C 40 108, 24 98, 16 82
           C 8 66, 8 46, 20 30 C 30 16, 44 8, 60 8 Z"
        fill="var(--miel-500)"
        filter="url(#wc-rough)"
      />
      <path
        d="M60 12 C 76 12, 86 20, 94 30 C 103 43, 106 56, 99 72
           C 92 88, 78 99, 60 101 C 42 103, 28 94, 21 79
           C 14 64, 15 46, 25 32 C 34 19, 46 12, 60 12 Z"
        fill="none"
        stroke="var(--miel-800)"
        stroke-width="1.4"
        stroke-dasharray="1.6 5"
        opacity="0.8"
      />
      <path
        d="M60 30 L84 43.8 L84 71.4 L60 85.2 L36 71.4 L36 43.8 Z"
        fill="none"
        stroke="var(--tinta)"
        stroke-width="3"
        stroke-linejoin="round"
        opacity="0.86"
        filter="url(#ink)"
      />
      <g transform="translate(60 57)">
        <ellipse cx="0" cy="0" rx="6" ry="9" fill="var(--tinta)" opacity="0.9" />
        <path d="M-5 -3.4 h10 M-5.6 0.8 h11.2 M-4.6 5 h9.2"
          stroke="var(--miel-300)" stroke-width="1.6" stroke-linecap="round" />
        <path d="M-6 -4.2 q-11.6 -8 -14.4 -0.6 q-1.8 6.4 12 4.6 Z"
          fill="var(--miel-100)" stroke="var(--tinta)" stroke-width="1.2" stroke-linejoin="round" />
        <path d="M6 -4.2 q11.6 -8 14.4 -0.6 q1.8 6.4 -12 4.6 Z"
          fill="var(--miel-100)" stroke="var(--tinta)" stroke-width="1.2" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {/* ---------------------------------------------------------------
      5 · RAMA — die Biene auf dem Zweig.
      Das einzige ohne Sechseck: eine Biene sitzt auf einem
      Olivenzweig, wie er auch im Hauptlogo vorkommt. Am nächsten am
      Hauptlogo — gut, wenn die Marke als Untermarke lesbar sein soll
      statt als eigenes Zeichen.
      --------------------------------------------------------------- */}
  {variante === 'rama' && (
    <g>
      <circle cx="60" cy="60" r="50" fill="none" stroke="var(--miel-800)"
        stroke-width="2.6" filter="url(#ink)" />
      <circle cx="60" cy="60" r="43" fill="none" stroke="var(--miel-700)"
        stroke-width="1.2" stroke-dasharray="1.6 5" stroke-linecap="round" />
      <path
        d="M24 78 C 40 74, 56 74, 92 76"
        fill="none"
        stroke="var(--pistacho-700)"
        stroke-width="2.6"
        stroke-linecap="round"
        filter="url(#ink)"
      />
      <g fill="var(--pistacho-500)">
        <ellipse cx="36" cy="72" rx="7" ry="4" transform="rotate(-24 36 72)" />
        <ellipse cx="50" cy="69" rx="7.5" ry="4.2" transform="rotate(-16 50 69)" />
        <ellipse cx="76" cy="70" rx="7" ry="4" transform="rotate(14 76 70)" />
        <ellipse cx="88" cy="72" rx="6" ry="3.6" transform="rotate(20 88 72)" />
      </g>
      <g transform="translate(62 54)">
        <ellipse cx="0" cy="0" rx="7.4" ry="11" fill="var(--tinta)" />
        <path d="M-6.2 -4.4 h12.4 M-7 1 h14 M-5.8 6.2 h11.6"
          stroke="var(--miel-300)" stroke-width="2" stroke-linecap="round" />
        <path d="M-1.4 -11.4 q-1.2 -6 3.2 -8.8" stroke="var(--tinta)" stroke-width="1.6"
          fill="none" stroke-linecap="round" />
        <path d="M-7.4 -5.4 q-14 -9.6 -17.2 -0.8 q-2.2 7.6 14.4 5.6 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.4" stroke-linejoin="round" />
        <path d="M7.4 -5.4 q14 -9.6 17.2 -0.8 q2.2 7.6 -14.4 5.6 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1.4" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {/* ---------------------------------------------------------------
      6 · LETRA — Monogramm.
      Ein "a" aus der Hausschrift in der Wabe, dessen Punkt die Biene
      ist. Das kleinste und ruhigste der sechs; funktioniert bis auf
      Favicon-Größe herunter, verlangt aber, dass die Wortmarke
      danebensteht — allein sagt es nichts.
      --------------------------------------------------------------- */}
  {variante === 'letra' && (
    <g>
      <path
        d="M60 12 L94 31.5 L94 70.5 L60 90 L26 70.5 L26 31.5 Z"
        fill="var(--miel-200)"
        stroke="var(--miel-800)"
        stroke-width="3"
        stroke-linejoin="round"
        filter="url(#ink)"
      />
      <text
        x="60"
        y="70"
        text-anchor="middle"
        font-family="var(--font-display), Georgia, serif"
        font-size="46"
        font-weight="700"
        fill="var(--tinta)"
      >a</text>
      <g transform="translate(80 30) rotate(18)">
        <ellipse cx="0" cy="0" rx="4.4" ry="6.6" fill="var(--tinta)" />
        <path d="M-3.4 -2.4 h6.8 M-4 0.6 h8 M-3.2 3.6 h6.4"
          stroke="var(--miel-300)" stroke-width="1.3" stroke-linecap="round" />
        <path d="M-4.4 -3.2 q-9 -6.2 -11 -0.4 q-1.4 5 9 3.4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1" stroke-linejoin="round" />
        <path d="M4.4 -3.2 q9 -6.2 11 -0.4 q1.4 5 -9 3.4 Z"
          fill="var(--papel)" stroke="var(--tinta)" stroke-width="1" stroke-linejoin="round" />
      </g>
    </g>
  )}

  {conTexto && (
    <g>
      <text
        x="60"
        y="118"
        text-anchor="middle"
        font-family="var(--font-display), Georgia, serif"
        font-size="13"
        font-weight="600"
        letter-spacing="1.4"
        fill="var(--miel-800)"
      >LAS ABEJAS</text>
      <text
        x="60"
        y="134"
        text-anchor="middle"
        font-family="var(--font-display), Georgia, serif"
        font-size="13"
        font-weight="600"
        letter-spacing="1.4"
        fill="var(--miel-800)"
      >EDUCAN</text>
    </g>
  )}
</svg>

<style>
  .sello {
    display: block;
    height: auto;
    flex: none;
  }
</style>

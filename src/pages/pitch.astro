            <ellipse class="hoja-c" cx="560" cy="300" rx="140" ry="110" fill="url(#pg-pistacho-light)" opacity="0.75" />
            <ellipse class="hoja-c" cx="740" cy="290" rx="130" ry="105" fill="url(#pg-pistacho)" opacity="0.45" />
            <ellipse class="hoja-c" cx="650" cy="210" rx="110" ry="85" fill="url(#pg-pistacho-light)" opacity="0.7" />
            <ellipse class="hoja-c" cx="430" cy="400" rx="100" ry="85" fill="url(#pg-pistacho-light)" opacity="0.6" />
            <ellipse class="hoja-c" cx="860" cy="380" rx="95" ry="80" fill="url(#pg-pistacho-light)" opacity="0.6" />
            <ellipse class="hoja-c" cx="640" cy="560" rx="170" ry="90" fill="url(#pg-pistacho)" opacity="0.4" />
          </g>
          <g class="flores" filter="url(#wc-soft)">
            <ellipse class="flor" cx="520" cy="360" rx="22" ry="18" fill="url(#pg-miel)" />
            <ellipse class="flor" cx="760" cy="420" rx="20" ry="16" fill="url(#pg-miel)" />
            <ellipse class="flor" cx="650" cy="300" rx="18" ry="15" fill="url(#pg-miel)" />
            <ellipse class="flor" cx="590" cy="520" rx="20" ry="16" fill="url(#pg-miel)" />
            <ellipse class="flor" cx="820" cy="300" rx="16" ry="13" fill="url(#pg-miel)" />

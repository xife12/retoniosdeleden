          {Array.from({ length: 15 }, (_, i) => (
            <circle class={`punto-escuela${i >= 10 ? ' extra' : ''}`} cx={450 + i * 54} cy="770" r="16" fill="url(#pg-pistacho)" filter="url(#wc-soft)" style={`animation-delay:${(1 + i * 0.07).toFixed(2)}s`} />
          ))}

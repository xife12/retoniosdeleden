---
/**
 * Pitch-Präsentation für die CIE (Loom-Aufnahme, 3 Minuten).
 *
 * Versteckte Seite: nirgends verlinkt, noindex. Nur Desktop.
 * Die Bühne ist fest 1920 × 1080 und wird als Ganzes auf das Fenster
 * skaliert — so sieht die Aufnahme auf jedem Bildschirm gleich aus.
 *
 * Bedienung: Leertaste / Pfeil rechts / Bild ab / Klick = weiter,
 * Pfeil links / Bild auf = zurück, F = Vollbild, Pos1 = Anfang.
 * Schritt 0 ist leeres Papier; danach 8 Schritte (siehe PASOS unten).
 *
 * Ecke unten links (ca. 400 × 400) bleibt auf jeder Folie frei:
 * dort sitzt die Loom-Kamerabubble.
 */
import Base from '../layouts/Base.astro';
import Foto from '../components/pitch/FotoAcuarela.astro';
---

<Base lang="es" title="Retoños del Edén — Pitch CIE" description="Presentación" noindex>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <!-- Ausgefranster Aquarellrand für die Fotomasken -->
      <filter id="pitch-borde" x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.011 0.016" numOctaves="3" seed="9" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="70" />
      </filter>
    </defs>
  </svg>

  <main class="sala" id="sala">
    <div class="escenario" id="escenario" data-paso="0">
      <!-- Papierwaschungen im Hintergrund -->
      <svg class="fondo" viewBox="0 0 1920 1080" aria-hidden="true">
        <g filter="url(#wc-wash)" opacity="0.32">
          <ellipse cx="1780" cy="90" rx="380" ry="230" fill="url(#pg-miel)" opacity="0.35" />
          <ellipse cx="160" cy="120" rx="300" ry="190" fill="url(#pg-pistacho-light)" opacity="0.5" />
          <ellipse cx="1650" cy="1040" rx="520" ry="160" fill="url(#pg-pistacho-light)" opacity="0.6" />
        </g>
      </svg>

      <!-- ============ 1 + 2 · PROBLEMA ============ -->
      <section class="diapo" data-en="1,2">
        <h1 class="titulo t-pregunta">¿Qué se hace con una tierra que todos dan por muerta?</h1>

        <svg class="escena" viewBox="0 0 1920 1080" aria-hidden="true">
          <g class="suelo" filter="url(#ink)">
            <path class="trazo" d="M120 652 C260 640 380 662 520 650 S760 646 820 654" />
            <path class="chirca" d="M190 651 l-8 -30 M196 651 l3 -36 M203 651 l13 -27 M640 649 l-7 -24 M646 649 l4 -31 M652 649 l12 -22 M300 652 l-5 -18 M306 652 l7 -20" />
          </g>
          <path class="estaca" filter="url(#ink)" d="M434 446 L426 654" />
          <g class="pajaro-vuelo">
            <g class="pajaro" filter="url(#ink)">
              <path d="M-30 -2 q18 -16 44 -8 q10 3 17 -5 l5 7 q-7 5 -11 11 q-16 18 -46 9 z" />
              <path class="ala" d="M-12 -8 q8 -26 32 -30 q-6 18 -18 30 z" />
              <path class="patas" d="M-6 14 l-2 10 M4 14 l2 10" />
            </g>
          </g>
          <ellipse class="semilla" cx="446" cy="470" rx="5" ry="8" />
          <g class="brote">
            <path d="M452 652 q-3 -22 2 -38" />
            <ellipse cx="441" cy="616" rx="12" ry="6" transform="rotate(-30 441 616)" />
            <ellipse cx="465" cy="610" rx="13" ry="6" transform="rotate(25 465 610)" />
          </g>
        </svg>

        <Foto id="tierra" clase="f-tierra" src="/pitch/tierra.jpg" ancho={1000} alto={600} retraso={1.2} />

        <div class="dato">
          <p class="dato-num">1 <span>de cada</span> 3</p>
          <p class="dato-txt">estudiantes de 15 años en Uruguay no alcanza el nivel básico en ciencias ambientales</p>
          <p class="fuente">PISA 2025 · OCDE</p>
          <svg class="chicos" viewBox="0 0 520 220" aria-hidden="true">
            <g class="chico c1" transform="translate(90 200)"><circle cx="0" cy="-122" r="34" /><path d="M-50 0 Q-54 -78 0 -80 Q54 -78 50 0 Z" /></g>
            <g class="chico c2" transform="translate(260 200)"><circle cx="0" cy="-122" r="34" /><path d="M-50 0 Q-54 -78 0 -80 Q54 -78 50 0 Z" /></g>
            <g class="chico c3" transform="translate(430 200)"><circle cx="0" cy="-122" r="34" /><path d="M-50 0 Q-54 -78 0 -80 Q54 -78 50 0 Z" /></g>
          </svg>
        </div>
      </section>

      <!-- ============ 3 · SOLUCIÓN ============ -->
      <section class="diapo" data-en="3">
        <p class="antetitulo">Retoños del Edén</p>
        <h2 class="titulo">Una chacra que también es un aula</h2>

        <svg class="panal" viewBox="0 0 1920 1080" aria-hidden="true">
          <g class="flechas" filter="url(#ink)">
            <path class="trazo-anim" d="M610 560 Q560 600 545 640" />
            <path class="trazo-anim" d="M690 760 Q740 790 790 760" />
            <path class="trazo-anim" d="M830 640 Q815 600 765 560" />
          </g>
          <g class="celda celda-a">
            <polygon points="700,250 852,337 852,512 700,600 548,512 548,337" fill="url(#pg-miel)" filter="url(#wc-soft)" />
            <text x="700" y="400" class="celda-t grande">Las abejas</text>
            <text x="700" y="448" class="celda-t grande">educan</text>
            <text x="700" y="500" class="celda-sub">principal fuente de ingresos</text>

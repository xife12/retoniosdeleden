            <text x="520" y="770" class="celda-t">regenerativa</text>
          </g>
          <g class="celda celda-c">
            <polygon points="880,600 1001,670 1001,810 880,880 759,810 759,670" fill="url(#pg-barro)" filter="url(#wc-soft)" opacity="0.85" />
            <text x="880" y="735" class="celda-t">Experiencias</text>
            <text x="880" y="770" class="celda-t">en la chacra</text>
          </g>

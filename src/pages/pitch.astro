---
/**
 * Pitch-Präsentation für die CIE (Loom-Aufnahme, 3 Minuten).
 *
 * Versteckte Seite: nirgends verlinkt, noindex. Nur Desktop.
 * Die Bühne ist fest 1920 × 1080 und wird als Ganzes auf das Fenster
 * skaliert — so sieht die Aufnahme auf jedem Bildschirm gleich aus.
 *
 * Grundsatz (Vorgabe der Dozentin): so wenig Text wie möglich — wer liest,
 * hört nicht zu. Erlaubt sind eine kurze Überschrift, Zahlen mit Einheit
 * und auf der letzten Folie Name, Leitsatz und Webadresse. Nie ein Satz,
 * den Catalina im selben Moment spricht.
 *
 * Bedienung: Leertaste / Pfeil rechts / Bild ab / Klick = weiter,
 * Pfeil links / Bild auf = zurück, F = Vollbild, Pos1 = Anfang.
 * Schritt 0 ist leeres Papier; danach 8 Schritte.
 *
 * Ecke unten links (ca. 400 × 400) bleibt auf jeder Folie frei:
 * dort sitzt die Loom-Kamerabubble.
 */
import Base from '../layouts/Base.astro';
import Foto from '../components/pitch/FotoAcuarela.astro';

/** Sechseck mit Spitze oben, als points-Attribut */
function hexagono(cx: number, cy: number, r: number) {
  const w = r * 0.866;
  return [
    [cx, cy - r],
    [cx + w, cy - r / 2],
    [cx + w, cy + r / 2],
    [cx, cy + r],
    [cx - w, cy + r / 2],
    [cx - w, cy - r / 2],
  ]
    .map((p) => p.join(','))
    .join(' ');
}

const celdas = [
  { id: 'a', cx: 960, cy: 400, r: 200, src: '/pitch/aula.jpg', texto: 'Las abejas educan', tx: 1170, ty: 415, ancla: 'start', fuerte: true },
  { id: 'b', cx: 755, cy: 760, r: 180, src: '/pitch/plantacion.jpg', texto: 'Producción', tx: 555, ty: 775, ancla: 'end', fuerte: false },
  { id: 'c', cx: 1165, cy: 760, r: 180, src: '/pitch/casa-barro.jpg', texto: 'Experiencias', tx: 1365, ty: 775, ancla: 'start', fuerte: false },
];
---

<Base lang="es" title="Retoños del Edén — Pitch CIE" description="Presentación" noindex>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs>
      <!-- Ausgefranster Aquarellrand für die Fotomasken -->
      <filter id="pitch-borde" x="-15%" y="-15%" width="130%" height="130%">
        <feTurbulence type="fractalNoise" baseFrequency="0.011 0.016" numOctaves="3" seed="9" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="70" />
      </filter>
    </defs>
  </svg>

  <main class="sala" id="sala">

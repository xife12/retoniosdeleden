        <Foto id="cartel" src="/pitch/cartel.jpg" ancho={560} alto={400} retraso={1.6} clase="f-cartel" />
        <p class="web">retoniosdeleden.com</p>
      </section>

    </div>
  </main>
</Base>

<script>
  const PASOS = 8;
  const escenario = document.getElementById('escenario') as HTMLElement;
  const sala = document.getElementById('sala') as HTMLElement;
  const diapos = Array.from(document.querySelectorAll<HTMLElement>('.diapo'));
  const vuelo = document.getElementById('vuelo-abeja') as unknown as SVGAnimationElement | null;
  const contador = document.getElementById('contador') as HTMLElement;
  let paso = 0;

  // Bühne auf das Fenster einpassen
  function ajustar() {
    const s = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
    escenario.style.setProperty('--escala', String(s));
  }
  window.addEventListener('resize', ajustar);
  ajustar();

  function contar() {
    const fin = 3000;
    const t0 = performance.now();
    const dur = 1600;
    function cuadro(t: number) {
      const k = Math.min(1, (t - t0) / dur);
      const v = Math.round(fin * (1 - Math.pow(1 - k, 3)));
      contador.textContent = '+' + v.toLocaleString('es-UY');
      if (k < 1 && paso === 5) requestAnimationFrame(cuadro);
    }
    requestAnimationFrame(cuadro);
  }

  function ir(n: number) {
    paso = Math.max(0, Math.min(PASOS, n));
    escenario.dataset.paso = String(paso);
    for (const d of diapos) {
      const en = (d.dataset.en || '').split(',').map(Number);
      d.classList.toggle('activa', en.includes(paso));
    }
    if (paso === 3 && vuelo) vuelo.beginElement();
    if (paso === 5) contar();
  }

  function siguiente() { ir(paso + 1); }
  function anterior() { ir(paso - 1); }

  document.addEventListener('keydown', (e) => {
    if (['ArrowRight', ' ', 'PageDown', 'Enter'].includes(e.key)) { e.preventDefault(); siguiente(); }
    else if (['ArrowLeft', 'PageUp', 'Backspace'].includes(e.key)) { e.preventDefault(); anterior(); }
    else if (e.key === 'Home') ir(0);
    else if (e.key === 'f' || e.key === 'F') {
      if (document.fullscreenElement) document.exitFullscreen();
      else document.documentElement.requestFullscreen();
    }
  });
  sala.addEventListener('click', siguiente);

  // Mauszeiger ausblenden, wenn er ruht
  let reposo = 0;
  document.addEventListener('mousemove', () => {
    document.body.classList.remove('sin-cursor');
    clearTimeout(reposo);
    reposo = window.setTimeout(() => document.body.classList.add('sin-cursor'), 1500);
  });

  // Alle Fotos vorab dekodieren, damit während der Aufnahme nichts nachlädt
  const fuentes = Array.from(document.querySelectorAll('image')).map((i) => i.getAttribute('href') || '');
  Promise.all(fuentes.map((src) => { const im = new Image(); im.src = src; return im.decode().catch(() => {}); }))
    .then(() => escenario.classList.add('listo'));

  ir(0);
</script>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: var(--papel);
  }
  :global(body.sin-cursor),
  :global(body.sin-cursor *) {
    cursor: none !important;
  }

  .sala {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--papel);
  }

  .fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .escenario {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1920px;
    height: 1080px;
    transform: translate(-50%, -50%) scale(var(--escala, 1));
    transform-origin: center;
    color: var(--tinta);
    font-family: var(--font-body);
    overflow: hidden;
  }

  .lienzo {
    position: absolute;
    inset: 0;
    width: 1920px;
    height: 1080px;
    pointer-events: none;
  }

  /* ---------- Folien ---------- */
  .diapo {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.015);
    filter: blur(6px);
    transition:
      opacity 0.7s var(--ease-out),
      transform 0.9s var(--ease-out),
      filter 0.7s var(--ease-out),
      visibility 0s linear 0.7s;
  }
  .diapo.activa {
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
    transition:
      opacity 0.9s var(--ease-out) 0.15s,
      transform 1.2s var(--ease-out) 0.15s,
      filter 0.9s var(--ease-out) 0.15s,
      visibility 0s;
  }

  /* Gemeinsame Zeichen-Animation für Tuschelinien */
  .trazo,
  .trazo-anim {
    fill: none;
    stroke: var(--tinta-suave);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
  }
  .activa .trazo,
  .activa .trazo-anim {
    animation: dibujar 1.4s var(--ease-out) forwards;
  }
  @keyframes dibujar {
    to { stroke-dashoffset: 0; }
  }
  @keyframes aparecer { to { opacity: 1; } }
  @keyframes subir { to { opacity: 1; transform: none; } }
  @keyframes brotar { to { transform: scale(1); } }

  .icono {
    fill: none;
    stroke: var(--tinta-suave);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Überschriften ---------- */
  .titulo {
    position: absolute;
    left: 120px;
    top: 90px;
    max-width: 1100px;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 64px;
    line-height: var(--lh-tight);
    letter-spacing: -0.01em;
    color: var(--tinta);
    opacity: 0;
    transform: translateY(10px);
  }
  .activa .titulo { animation: subir 0.8s var(--ease-out) 0.2s forwards; }
  .subtitulo,
  .pie-grupo {
    position: absolute;
    max-width: none;
    margin: 0;
    font-size: 30px;
    color: var(--tinta-suave);
    opacity: 0;
  }
  .subtitulo { left: 122px; top: 176px; }
  .pie-grupo { left: 1100px; top: 870px; }
  .activa .subtitulo { animation: aparecer 0.8s 0.6s forwards; }
  .activa .pie-grupo { animation: aparecer 0.8s 1.6s forwards; }

  /* ---------- 1 · Problema ---------- */
  .chirca {
    fill: none;
    stroke: var(--tinta-tenue);
    stroke-width: 2.5;
    stroke-linecap: round;

          <path class="tronco" filter="url(#ink)" d="M640 902 C632 800 646 700 634 560 M636 720 C590 660 540 620 480 590 M638 650 C690 600 740 560 800 530 M636 600 C620 500 600 420 570 330 M640 560 C680 470 700 380 730 300" />
          <g class="copa" filter="url(#wc-wash)">
            <ellipse class="hoja-c" cx="640" cy="420" rx="230" ry="190" fill="url(#pg-pistacho-light)" opacity="0.7" />
            <ellipse class="hoja-c" cx="500" cy="500" rx="150" ry="120" fill="url(#pg-pistacho)" opacity="0.55" />

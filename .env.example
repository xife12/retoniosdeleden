# Supabase-Projekt-URL (Supabase-Dashboard -> Settings -> API -> Project URL)
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase anon/public Key (Settings -> API -> Project API keys -> anon public)
# Dieser Key ist bewusst oeffentlich -- der eigentliche Schutz laeuft ueber
# Row Level Security in supabase/schema.sql, nicht ueber die Geheimhaltung
# dieses Keys. Niemals den service_role-Key hier eintragen.
PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
